// room script file

function hGo_up_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(18, 404, 968); 
}

function hGo_down_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(20, 1085, 968); 
}

function hMarkers_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Маркеры и бумажные листы, раскиданные по полу в каком-то неистовстве.");
}

function hSimbols_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Все стены разрисованы символами... Еще вчера их не было. Кто и зачем это сделал?");
}

function room_FirstLoad()
{
  TypeText("...");
  TypeText("Так, спокойно.");
}

function oStrange_note_AnyClick(Object *theObject, CursorMode mode)
{
  TypeText("Среди разорванных в клочья бумажных ошметков, разбросанных по лестничной клетке, сохранился целый листок.");
  TypeText("На нем что-то написано, но некто отчаянно пытался заштриховать текст, так что не разобрать ни единого слова.");
  player.AddInventory(iNote);
  oStrange_note.Visible = false;
  TypeText("Теперь у вас есть 'Нечитаемая записка'");
}
