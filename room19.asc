// room script file
bool simbols = false;

function hGo_up_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(18, 340, 968); 
}

function hGo_down_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(20, 1036, 968); 
}

function hMarkers_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("По полу разбросаны маркеры и разорванные в клочья бумажки. Кажется, кто-то трудился здесь в настоящем исступлении.");
}

function hSimbols_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (simbols == false)
  {
    TypeText("Все стены разрисованы странными символами... Еще вчера их не было. Кто и зачем это сделал?");
    simbols = true;
  }
  else
  {
    TypeText("Если эти знаки и имеют какой-то смысл, то мне он непонятен. Это похоже на язык, но... совершенно мне незнакомый.");
  }
}


function oStrange_note_Interact(Object *theObject, CursorMode mode)
{
  TypeText("Среди бумажных ошметков каким-то чудом сохранился целый листок.");
  TypeText("На нем что-то написано, но некто отчаянно пытался заштриховать текст, так что не разобрать ни единого слова.");
  player.AddInventory(iNote);
  oStrange_note.Visible = false;
  TypeText("Получен предмет: «Нечитаемая записка»");
}
