// room script file
bool creapy_picture = false;
int wallpaper = 0;


function room_Load()
{
  if (wallpaper == 0)
  {
    SetBackgroundFrame(0);
  }
  else
  {
    SetBackgroundFrame(1);
  }

  oDoor_handle.Visible = (wallpaper >= 2);
}

function room_AfterFadeIn()
{
  if (player.PreviousRoom == 46 &&
      dDino.HasOptionBeenChosen(8) &&
      !dDino.HasOptionBeenChosen(4))
  {
    if (Game.DoOnceOnly("Dino_dialog_completed"))
    {
      
      ChangeMood(-1);
      TypeText("Может, в этом и был какой-то смысл, вот только разговоры с неодушевлёнными предметами вряд ли идут на пользу вашему психическому здоровью.");
    }
  }
}

function hExit_livingroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(24, 970, 1042); 
  aDoor_sound.Play();
}

function hCreapy_picture_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (creapy_picture == false)
  {
    TypeText("Здесь висела другая картина... Разве нет?");
    creapy_picture = true;
  }
  else
  {
    TypeText("Я точно помню, здесь было что-то другое. Откуда взялась эта жуткая мазня?");
  }
}

function hWindow_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Обычно из окна виден парк. Сейчас даже верхушек деревьев не разглядеть. Лишь темнота и мое отражение.");
}

function hGap_Interact(Hotspot *theHotspot, CursorMode mode)
{

    if (wallpaper == 0)
    {
      TypeText("Кажется, будто кто-то проковырял дырку в обоях.");
      TypeText("В разрыве просматриваются какие-то линии на стене, но понять сложно.");
    }
    else if (wallpaper == 1)
    {
      TypeText("Это... нарисованная мелом дверь.");
      TypeText("Мы никогда не меняли обои. Получается, она была здесь уже очень давно.");
      TypeText("Кто нарисовал это и, главное, зачем?");
      TypeText("Вы осторожно дотрагиваетесь: поверхность шершавая и холодная. На пальцах остается серая пыль. Чья-то старая шутка или детская шалость?");
    }
    else if (wallpaper == 2)
    {
      wallpaper = 3;

      if (player.HasInventory(iDino))
      {
          gDarkOverlay.Transparency = 100;
        gDarkOverlay.Visible = true;

        while (gDarkOverlay.Transparency > 0)
        {
          gDarkOverlay.Transparency -= 2;
          Wait(1);
        }

        SetNextScreenTransition(eTransitionInstant);
        player.ChangeRoom(46, 0, 0);
      }
      else
      {
        TypeText("Это какой-то бред, но ладно.");
        aDoor_sound.Play();
        player.ChangeRoom(30, 600, 894);
      }
    }
    else if (wallpaper == 3)
    {
      aDoor_sound.Play();
      player.ChangeRoom(30, 600, 894);
    }

}

function hShelfs_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(11, 0, 0); // Переносим игрока в комнату полок (11)
}

function hTable_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(10, 0, 0); 
}

function hBookshelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Еще днем я думал, что неплохо бы снова вернуться к чтению. Сейчас мне трудно представить, что я вообще смогу спокойно сесть с книгой.");
}

function hNotes_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Мамины заметки с напоминаниями. Они давно потеряли смысл.");
}



function hGap_UseInv(Hotspot *theHotspot, CursorMode mode)
{
    if (player.ActiveInventory == iKnife && wallpaper == 0)
    {
      FadeOut(4);
      AudioChannel *channel1 = aWallpaper.Play();

      while (channel1 != null && channel1.IsPlaying)
      {
        Wait(1);
      }

      SetBackgroundFrame(1);
      FadeIn(4);

      wallpaper = wallpaper + 1;
      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto;

      TypeText("Это. Еще. Что. За хрень.");
    }
    else if (wallpaper == 1 && player.ActiveInventory == iDoor_handle)
    {
      FadeOut(4);
      oDoor_handle.Visible = true;
      player.LoseInventory(iDoor_handle);

      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto;

      wallpaper = wallpaper + 1;
      Wait(40);
      FadeIn(4);
      
    }
    else
    {
      TypeText("Ума не приложу, что с этим делать.");
    }

}

function oLaptop_Interact(Object *theObject, CursorMode mode)
{
  player.ChangeRoom(9, 0, 0); 
}

function hDrawers_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Что-то изменилось. Я помню, что бумаги были разложены немного иначе. И ящик почему-то не открывается. Здесь кто-то был?"); 
}


