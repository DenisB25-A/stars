// room script file
bool creapy_picture = false;
bool wallpaper = false;

function room_Load()
{
  SetBackgroundFrame(0);
  
  if (wallpaper == true)
  {
    SetBackgroundFrame(1);
  }
}


function hExit_livingroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(24, 970, 1042); 
    aDoor_sound.Play();
  }
}

function hCreapy_picture_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
    if (creapy_picture == false)
    {
      TypeText("Здесь висела другая картина... Разве нет?");
      creapy_picture = true;
    }
    else
    {
      TypeText("Я точно помню, здесь было что-то другое. Откуда взялась эта жуткая мазня?");
    }
  }
}

function hWindow_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    TypeText("Обычно окно выходит на парк, но сейчас там не разглядеть ничего. Сплошная непроглядная тьма.");
  }
}

function hGap_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3])
  {
    if (wallpaper == false)
    {
      TypeText("Кажется, будто кто-то проковырял дырку в обоях.");
      TypeText("В разрыве просматриваются какие-то линии на стене, но понять сложно.");
    }
    else
    {
      TypeText("Это... это нарисованная мелом дверь.");
      TypeText("Мы никогда не меняли обои, получается, что она все это время была здесь. Уже очень давно.");
      TypeText("Кто и когда нарисовал это и, главное, зачем?");
      TypeText("Вы осторожно дотрагиваетесь: поверхность шершавая и холодная. Это всего лишь стена. Чья-то очень старая шутка, детская шалость. На ваших пальцах остается серая пыль.");
    }
     
  }
}

function hShelfs_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
  player.ChangeRoom(11, 0, 0); // Переносим игрока в комнату полок (11)
  }
}

function hTable_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
  player.ChangeRoom(10, 0, 0); 
  }
}

function hBookshelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Сейчас точно не время для чтения.");
}

function hNotes_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Ничего интересного.");
}



function hGap_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3])
  {
    if (player.ActiveInventory == iKnife)
      {
      // --- УСПЕШНОЕ ДЕЙСТВИЕ ---
    FadeOut(4); // Закрыл глаза (очень быстро)
    AudioChannel *channel1 = aWallpaper.Play();
    
    // Ждем, пока первый звук полностью проиграется
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); // Ставим игру на микро-паузу в 1 кадр, пока звук идет
    }
    SetBackgroundFrame(1);
    FadeIn(4);  // Открыл глаза
    wallpaper = true;
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; // возвращаем обычный курсор
    TypeText("Это. Что. Еще. За хрень.");
      }
    else if (wallpaper == true)
    {
      if (player.ActiveInventory == iDoor_handle)
      FadeOut(4);
      oDoor_handle.Visible = true;
      player.LoseInventory(iDoor_handle);
      Wait(40);
      FadeIn(4);
    }
  }
}
