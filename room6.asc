// room script file


function hBalcony_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(5, 406, 1010); 
  }
}

function start_smoking() {
  cEgo.LockView(4);
  aSmoke.Play();
  cEgo.Animate(cEgo.Loop, 5, eRepeat, eNoBlock);
}

function start_thinking()
{
  move_carret_back();
  
  show_accumulated_text_after("Вы подносите огонек к сигарете и вдыхаете дым, от которого тут же кружится голова", 0,  true);
  show_accumulated_text_after("Солнце бьет по глазам, и вы щуритесь, со двора доносится радостный детский смех", 150,  true);
  show_accumulated_text_after("Где-то жизнь идет своим чередом, у вас - будто остановилась", 150,  true);
  show_accumulated_text_after("День за днем в этой жалкой квартирке, в которую вы обещали себе больше не возвращаться", 150,  true);
  show_accumulated_text_after("Почему вы еще здесь? Почему вы вообще вернулись?", 150, false);
  show_accumulated_text_after("И есть ли смысл сожалеть?", 150, false);
  Wait(200);
  show_accumulated_text_after("Ваша мать была больна, и это нужно признать", 150, true);
  show_accumulated_text_after("Больна в известном вам смысле, больна задолго до того, как по ее телу побежали первые смертельные метастазы", 150, true);
  show_accumulated_text_after("Она разговаривала сама с собой, часами сидела в запертой комнате, делала другие странные вещи", 150, true);
  show_accumulated_text_after("Соседи говорят, что под конец она совсем перестала выходить из дома", 150, true);
  show_accumulated_text_after("'Сынок сумасшедшей' - прозвище, которое надолго врезалось в память", 150, true);
  show_accumulated_text_after("Но вы были ребенком. Могли ли вы что-либо сделать тогда? Могли ли что-то изменить позже?", 150, false);
  show_accumulated_text_after("Нет. Тогда зачем же вы здесь?", 150, false);
  
  move_carret_back(); 
  
  show_accumulated_text_after("Пепел падает, обжигая пальцы, но его тут же уносит ветер", 150, true);
  show_accumulated_text_after("Прошлое, как трясина, - настойчиво шепчет внутренний голос, - зайди по щиколотку и увязнешь по горло", 150, true);
  show_accumulated_text_after("Он прав", 150, false);


  Wait(300);
}

function stop_smoking()
{
  //cEgo.StopAnimating();
  cEgo.UnlockView();
}
 
function room_AfterFadeIn()
{
  aYard_noise.Play(eAudioPriorityNormal, eRepeat);
  if (!was_balcony_thoughts) {
  cEgo.WalkStraight(700, 1050);
  Wait(100);
  //cEgo.AddInventory(iCigarettes);
  if (cEgo.HasInventory(iCigarettes)) {
    //dBalcony.SetOptionState(1, eOptionOn);
    aYard_noise.Stop();
    start_smoking();
    start_diming();
    start_thinking();
    stop_smoking();
    start_lighter();
    was_balcony_thoughts = true;
    aYard_noise.Play(eAudioPriorityNormal, eRepeat);
    
  } else {
    dBalcony.SetOptionState(1, eOptionOff);
  dBalcony.Start();
  }
  }
}

function room_Unload()
{
  aYard_noise.Stop();
}

function hStreet_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Гомон голосов, шум машин, смех на детской площадке - жизнь идет своим чередом.");
}

function hChair_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (cEgo.HasInventory(iCup))
  {
    TypeText("Что может быть лучше, чем провести остаток дня, попивая кофе и смоля сигарету? Так я смогу хотя бы немного отдохнуть и подумать. Но все ли я сделал, что хотел?");
    dBalcony_cofee.Start();
  }
  else
  {
    TypeText("Милое местечко. Хорошо бы посидеть тут с чашечкой кофе.");
  }
}

