// room script file


function hBalcony_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound3.Play();
  player.ChangeRoom(5, 406, 1010); 
}

function start_smoking() {
  cEgo.LockView(4);
  aSmoke.Play();
  cEgo.Animate(cEgo.Loop, 20, eRepeat, eNoBlock);
}

function start_thinking()
{
  move_carret_back();
  
  show_accumulated_text_after("Вы подносите огонек к сигарете и вдыхаете дым, от которого тут же кружится голова", 220,  true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("Солнце бьет по глазам, и вы щуритесь. Со двора доносится радостный детский смех", 220,  true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("Где-то жизнь идет своим чередом. А ваша будто остановилась", 220,  true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("День за днем в этой жалкой квартирке, в которую вы обещали себе больше не возвращаться", 220,  true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("Почему вы еще здесь? Почему вы вообще вернулись?", 220, true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("И есть ли смысл сожалеть?", 220, true);
  Wait(220); // Даем игроку прочитать последнюю строку
  
  move_carret_back();
  
  show_accumulated_text_after("Ваша мать была больна, и это нужно признать", 220, true);
  show_accumulated_text_after("Больна в известном вам смысле, больна задолго до того, как в ее теле обнаружили метастазы", 220, true);
  show_accumulated_text_after("Она разговаривала сама с собой, часами сидела в запертой комнате, делала другие странные вещи", 220, true);
  show_accumulated_text_after("Соседи рассказывали, что под конец она совсем перестала выходить из дома", 220, true);
  show_accumulated_text_after("«Сынок сумасшедшей» - прозвище, которое надолго врезалось в память", 220, true);
  show_accumulated_text_after("Но вы были ребенком. Могли ли вы что-либо сделать тогда? Могли ли что-то изменить позже?", 220, true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("Нет. Тогда зачем же вы здесь?", 220, true);
  Wait(220); // Даем игроку прочитать последнюю строку
  
  move_carret_back(); 
  
  show_accumulated_text_after("Пепел падает, обжигая пальцы, но его тут же уносит ветер", 220, true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("Прошлое, как трясина, - настойчиво шепчет внутренний голос, - зайди по щиколотку и увязнешь по горло", 220, true);
  show_accumulated_text_after("", 10,  true);
  show_accumulated_text_after("Он прав", 220, true);


  Wait(300);
  
  move_carret_back(); 
}

function stop_smoking()
{
  //cEgo.StopAnimating();
  cEgo.UnlockView();
}
 
function room_AfterFadeIn()
{
  aYard_noise.Play(eAudioPriorityNormal, eRepeat);
  if (!was_balcony_thoughts) {
  cEgo.WalkStraight(700, 1050);
  Wait(100);
  //cEgo.AddInventory(iCigarettes);
  if (cEgo.HasInventory(iCigarettes)) {
    //dBalcony.SetOptionState(1, eOptionOn);
    aYard_noise.Stop();
    start_smoking();
    start_diming();
    start_thinking();
    stop_smoking();
    start_lighter();
    was_balcony_thoughts = true;
    TypeText("...");
    TypeText("Так я и сам скоро сойду с ума.");
    TypeText("Мне кажется... наверно мне просто нужно передохнуть. Немного прийти в себя.");
    TypeText("Почему бы не попытаться провести хоть один день нормально? Расслабиться, выпить кофе, просто посидеть и подумать. Уверен, банка дешевого растворимого кофе в этом доме точно найдется.");
    aYard_noise.Play(eAudioPriorityNormal, eRepeat);
    
  } 
  else 
  {
    TypeText("Что может быть лучше, чем покурить на балконе? Вот только у меня нет сигарет. Скорее всего, я потерял их где-то в квартире.");
    aDoor_sound3.Play();
    player.ChangeRoom(5, 406, 1010);
    player.FaceDirection(eDirectionRight, eBlock);
  }
  }
}

function room_Unload()
{
  aYard_noise.Stop();
}

function hStreet_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Гомон голосов, шум машин, смех на детской площадке - жизнь идет своим чередом.");
}

function hChair_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (cEgo.HasInventory(iCup))
  {
    TypeText("Что может быть лучше, чем провести остаток дня, попивая кофе и смоля сигарету? Так я смогу хотя бы немного прийти в себя и подумать. Но все ли я сделал, что хотел?");
    dBalcony_cofee.Start();
  }
  else
  {
    TypeText("Милое местечко. Хорошо бы посидеть тут с чашкой кофе.");
  }
}

