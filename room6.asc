// room script file


function hBalcony_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(5, 406, 1010); 
  }
}

function start_smoking() {
  cEgo.LockView(4);
  aSmoke.Play();
  cEgo.Animate(cEgo.Loop, 5, eRepeat, eNoBlock);
}

function start_thinking()
{
  move_carret_back();
  
  show_accumulated_text_after("Как же мне это нужно было", 0,  true);
  show_accumulated_text_after("Никогда не думал, что одна сигарета может доставить столько удовольствия", 150,  true);
  show_accumulated_text_after("Лёгкий ветер приятно уносит меня в воспоминания", 150,  true);
  show_accumulated_text_after("До того как всё стало так", 150, false);
  show_accumulated_text_after("До того как я стал им", 150, false);
  show_accumulated_text_after("Я любил маму", 150, true);
  show_accumulated_text_after("Она всегда сидела со мной на игровой площадке, пока другие родители просто смотрели в окно", 150, true);
  show_accumulated_text_after("У неё всегда было на меня время", 150, true);
  show_accumulated_text_after("А потом я стал подростком", 150, true);
  show_accumulated_text_after("Я говорил вещи, которые не думал на самом деле", 150, true);
  show_accumulated_text_after("Я стал им", 150, false);
  show_accumulated_text_after("Мы, говорят, становимся как наши родители", 150, false);
  show_accumulated_text_after("Я никогда не хотел стать им", 150, true);
  show_accumulated_text_after("Он никогда не понимал её доброту", 150, true);
  show_accumulated_text_after("Я не хочу быть здесь", 150, false);
  show_accumulated_text_after("Я не хочу помнить", 150, false);
  show_accumulated_text_after("А ещё эта квартира", 150, true);
  show_accumulated_text_after("Она сводит меня с ума", 150, true);

  aSmoke.Play();
  move_carret_back();

  show_accumulated_text_after("Но я помню как фантики оказывались под кроватью", 150, true);
  show_accumulated_text_after("Мама насыпала конфеты в вазу на кухне", 150, true);
  show_accumulated_text_after("Я незаметно заимствоал их оттуда", 150, true);
  show_accumulated_text_after("А она делала вид, что не замечала", 150, true);
  show_accumulated_text_after("Теперь её нет", 150, true);
  show_accumulated_text_after("Всё кажется таким далёким", 150, false);
  show_accumulated_text_after("Почти что недостяжимым", 150, false);
  show_accumulated_text_after("Зачем я это сказал ей тогда?", 150, true);
  show_accumulated_text_after("Я не хотел", 150, false);
  show_accumulated_text_after("Откуда во мне это", 150, false);
  show_accumulated_text_after("Я правда не хотел", 150, true);
  show_accumulated_text_after("Почему просто нельзя быть лучшей версией себя?", 150,  false);
  show_accumulated_text_after("Почему постоянно не получается быть нормальным?", 150, true);
  show_accumulated_text_after("Я был больше похож на него", 150, true);
  show_accumulated_text_after("Это было просто", 150, false);
  show_accumulated_text_after("Быть козлом просто", 150, false);
  show_accumulated_text_after("Он делал это намерено", 150, false);
  show_accumulated_text_after("И я стою здесь теперь", 150, true);
  show_accumulated_text_after("Совершенно один", 150, true);
  show_accumulated_text_after("Эта квартира своит меня с ума", 150, true);
  show_accumulated_text_after("Как же болит голова", 150, true);

  aSmoke.Play();
  move_carret_back();

  show_accumulated_text_after("Но я помню запах вафель.", 150, true);
  show_accumulated_text_after("Мама готовила их по утрам,", 150, false);
  show_accumulated_text_after("Я просыпался от такого приторно сладкого горячего запаха жаренных вафель.", 150, true);
  show_accumulated_text_after("Я шёл умываться.", 150, false);
  show_accumulated_text_after("Нельзя брать, пока не прошёл этот утренний ритуал с умыванием.", 150, true);
  show_accumulated_text_after("Но так сладко они пахли.", 150, false);
  show_accumulated_text_after("Если я замечал, что мама слишком занята новой порцией, я тихонько крал раскалённую вафлю и шёл с ней в ванную,", 300, false);
  show_accumulated_text_after("За чем меня застали пару раз.", 150, false);
  show_accumulated_text_after("Иногда они мне снятся во снах, или чем называется то, что я делаю лёжа на кровати с закрытыми глазами.", 300, false);
  show_accumulated_text_after("Порой мне кажется, что я притворяюсь, что знаю как спать.", 150, true);
  show_accumulated_text_after("Но те вафли... для ребёнка были недостаточно сладкими.", 150, true);
  show_accumulated_text_after("Часто я щедро намазывал на них варёнку - вкус эпохи", 150, true);
  show_accumulated_text_after("Теперь все дни просто смешались в одну длинную лужу слякоти", 150, true);
  show_accumulated_text_after("И дни потеряны в трясине, и никаких больше вафель.", 150, true);

  aSmoke.Play();
  move_carret_back();

  show_accumulated_text_after("Я так же помню и другое", 200, true);
  show_accumulated_text_after("Поворот ключа в замке - отец вернулся", 200, true);
  show_accumulated_text_after("Кажется, что температура в комнате падала каждый раз, когда он заходил", 200, true);
  show_accumulated_text_after("Вроде бы ничего не происходило... но кажется, что эта квартира резонировала с его тьмой", 200, true);
  show_accumulated_text_after("Звучит странно, но нигде больше он не казался таким зловещим", 200, true);
  show_accumulated_text_after("Нельзя было предугадать, в каком он настроении сеодня", 200, true);
  show_accumulated_text_after("И эти стены не давали сбежать", 200, true);
  show_accumulated_text_after("Я старался дышать реже", 200, true);
  show_accumulated_text_after("И курить, конечно, было строго запрещено", 200, true);
  show_accumulated_text_after("Никто не курил, кроме него", 200, true);
  show_accumulated_text_after("Не смотря на всё, я пыталя подражать", 200, true);


  Wait(300);
}

function stop_smoking()
{
  //cEgo.StopAnimating();
  cEgo.UnlockView();
}
 
function room_AfterFadeIn()
{
  aYard_noise.Play(eAudioPriorityNormal, eRepeat);
  if (!was_balcony_thoughts) {
  cEgo.WalkStraight(700, 1050);
  Wait(100);
  cEgo.AddInventory(iCigarettes);
  if (cEgo.HasInventory(iCigarettes)) {
    //dBalcony.SetOptionState(1, eOptionOn);
    aYard_noise.Stop();
    start_smoking();
    start_diming();
    start_thinking();
    stop_smoking();
    start_lighter();
    was_balcony_thoughts = true;
    aYard_noise.Play(eAudioPriorityNormal, eRepeat);
    
  } else {
    dBalcony.SetOptionState(1, eOptionOff);
  dBalcony.Start();
  }
  }
}

function room_Unload()
{
  aYard_noise.Stop();
}

function hStreet_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Гомон голосов, шум машин, смех на детской площадке - жизнь идет своим чередом.");
}

function hChair_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Милое местечко. Хорошо бы посидеть тут с чашечкой кофе.");
}

