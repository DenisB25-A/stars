// room script file


function hBalcony_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(5, 406, 1010); 
  }
}

function start_smoking() {
  gDarkOverlay.Visible = true;
  cEgo.LockView(4);
  aSmoke.Play();
  cEgo.Animate(cEgo.Loop, 5, eRepeat, eNoBlock);
  }
  

String last_text_state;
function show_accumulated_text_after(String text, int seconds, bool hold)
{
  Wait(150);
  
  
  if (hold == true) {
  lblThougts.Text = last_text_state.Append(text);
  last_text_state = lblThougts.Text;
  } else {
    lblThougts.Text = last_text_state.Append(text);
    }
}
function start_thinking()
{
  lblThougts.Visible = true;
 
last_text_state = "Как же мне это нужно было";
lblThougts.Text = last_text_state;

show_accumulated_text_after("\n\nНикогда не думал, что одна сигарета может доставить столько удовольствия", 150,  true);
show_accumulated_text_after("\n\nЛёгкий ветер приятно уносит меня в воспоминания", 150,  true);
show_accumulated_text_after("\n\nДо того как всё стало так", 150, false);
show_accumulated_text_after("\n\nДо того как я стал им", 150, false);
show_accumulated_text_after("\n\nЯ любил маму", 150, true);
show_accumulated_text_after("\n\nОна всегда сидела со мной на игровой площадке, пока другие родители просто смотрели в окно", 150, true);
show_accumulated_text_after("\n\nУ неё всегда было на меня время", 150, true);
show_accumulated_text_after("\n\nА потом я стал подростком", 150, true);
show_accumulated_text_after("\n\nЯ говорил вещи, которые не думал на самом деле", 150, true);
show_accumulated_text_after("\n\nЯ стал им", 150, false);
show_accumulated_text_after("\n\nМы, говорят, становимся как наши родители", 150, false);
show_accumulated_text_after("\n\nЯ никогда не хотел стать им", 150, true);
show_accumulated_text_after("\n\nОн никогда не понимал её доброту", 150, true);
show_accumulated_text_after("\n\nЯ не хочу быть здесь", 150, false);
show_accumulated_text_after("\n\nЯ не хочу помнить", 150, false);
show_accumulated_text_after("\n\nА ещё эта квартира", 150, true);
show_accumulated_text_after("\n\nОна сводит меня с ума", 150, true);
Wait(150);
lblThougts.Text = "";
last_text_state = "";
show_accumulated_text_after("\n\nНо я помню как фантики оказывались под кроватью", 150, true);
show_accumulated_text_after("\n\nМама насыпала конфеты в вазу на кухне", 150, true);
show_accumulated_text_after("\n\nЯ незаметно заимствоал их оттуда", 150, true);
show_accumulated_text_after("\n\nА она делала вид, что не замечала", 150, true);
show_accumulated_text_after("\n\nТеперь её нет", 150, true);
show_accumulated_text_after("\n\nВсё кажется таким далёким", 150, false);
show_accumulated_text_after("\n\nПочти что недостяжимым", 150, false);
show_accumulated_text_after("\n\nЗачем я это сказал ей тогда?", 150, true);
show_accumulated_text_after("\n\nЯ не хотел", 150, false);
show_accumulated_text_after("\n\nОткуда во мне это", 150, false);
show_accumulated_text_after("\n\nЯ правда не хотел", 150, true);
show_accumulated_text_after("\n\nПочему просто нельзя быть лучшей версией себя?", 150,  false);
show_accumulated_text_after("\n\nПочему постоянно не получается быть нормальным?", 150, true);
show_accumulated_text_after("\n\nЯ был больше похож на него", 150, true);
show_accumulated_text_after("\n\nЭто было просто", 150, false);
show_accumulated_text_after("\n\nБыть козлом просто", 150, false);
show_accumulated_text_after("\n\nОн делал это намерено", 150, false);
show_accumulated_text_after("\n\nИ я стою здесь теперь", 150, true);
show_accumulated_text_after("\n\nСовершенно один", 150, true);
show_accumulated_text_after("\n\nЭта квартира своит меня с ума", 150, true);
show_accumulated_text_after("\n\nКак же болит голова", 150, true);
Wait(300);
}

function stop_smoking()
{
  //cEgo.StopAnimating();
  cEgo.UnlockView();
}
 
function room_AfterFadeIn()
{
  if (!was_balcony_thoughts) {
  cEgo.WalkStraight(700, 1050);
  Wait(100);
  //cEgo.AddInventory(iCigarettes);
  if (cEgo.HasInventory(iCigarettes)) {
    //dBalcony.SetOptionState(1, eOptionOn);
    start_smoking();
    start_diming();
    start_thinking();
    stop_smoking();
    gDarkOverlay.Visible = false;
    was_balcony_thoughts = true;
  } else {
    dBalcony.SetOptionState(1, eOptionOff);
  dBalcony.Start();
  }
  }
}
