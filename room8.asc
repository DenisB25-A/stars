// room script file


function hOld_mails_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Cтарые письма и фотографии. Какие-то дальние родственники, половину которых я даже не знаю.");
}

function hDrawers_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
  player.ChangeRoom(3, 566, 850);
  aDrawer_close.Play();
  }
  else
  {
  player.ChangeRoom(25, 566, 850);
  aDrawer_close.Play();
  }
  
}

function oNote_Interact(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(2);
  oNote.Visible = false;
}

function oDino_Interact(Object *theObject, CursorMode mode)
{
  TypeText("Поверить не могу, а ты откуда здесь взялся?"); 
  TypeText("Моя любимая игрушка. Старый резиновый динозавр.");
  TypeText("Не знаю, зачем он мне, но выбросить - рука не поднимается.");
  // Теперь это сработает, потому что событие ПРИВЯЗАНО к объекту
  player.AddInventory(iDino); 
  
  // Используем theObject, чтобы точно скрыть тот предмет, на который нажали
  theObject.Visible = false;
  
}
