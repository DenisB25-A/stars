// room script file

function oDino_Interact(Object *theObject, CursorMode mode)
{
  // Теперь это сработает, потому что событие ПРИВЯЗАНО к объекту
  player.AddInventory(iDino); 
  
  // Используем theObject, чтобы точно скрыть тот предмет, на который нажали
  theObject.Visible = false;
  
  // Вместо Display можем использовать твой TypeText
  Display("Заебись, динозавр."); 
}

function hDrawers_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(3, 566, 850);
}

function oDino_AnyClick(Object *theObject, CursorMode mode)
{
  // Теперь это сработает, потому что событие ПРИВЯЗАНО к объекту
  player.AddInventory(iDino); 
  
  // Используем theObject, чтобы точно скрыть тот предмет, на который нажали
  theObject.Visible = false;
  
  // Вместо Display можем использовать твой TypeText
  TypeText("Динозавр имбы."); 
}

function hOld_mails_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Старые письма и фотокарточки еще из бабушкиного альбома. Какие-то дальние родственники, половину которых я даже не знаю.");
}

function oNote_AnyClick(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(2);
  oNote.Visible = false;
}
