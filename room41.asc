// room script file

function hLamp_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Кто-то же включил эту лампу. Я определенно тут не один.");
}

function hLamp_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iNote)
  {
    // --- УСПЕШНОЕ ДЕЙСТВИЕ ---
    TypeText("Может на просвет я что-то смогу рассмотреть?");
    FadeOut(4); // Закрыл глаза (очень быстро)
    Wait(40);    // Мгновение темноты
    FadeIn(4);  // Открыл глаза
    
    TypeText("Это какое-то стихотворение.");

    player.LoseInventory(iNote); 
    ReadAndAddNote(8);
    // После успешного действия ОБЯЗАТЕЛЬНО сбрасываем предмет с курсора
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; // возвращаем обычный курсор
    TypeText("Вы ничего не понимаете, но, на всякий случай, переписываете это в блокнот.");
    // Здесь твоя логика: например, меняем глобальную переменную, 
    // чтобы замок считался открытым.
  }
  else
  {
    // --- ЕСЛИ ИГРОК ТЫКНУЛ ДРУГИМ ПРЕДМЕТОМ ---
    // Если игрок попробует применить сигареты или динозавра
    TypeText("Ума не приложу, что с этим делать.");
  }
}

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(40, 938, 970); 
}

function hStrange_letters_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Вырезаны ножом. Если это какой-то язык, то определенно мне незнакомый.");
}
