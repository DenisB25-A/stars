// room script file
import int currentDialog;


function room_AfterFadeIn()
{
  aDrops_water.Play(eAudioPriorityNormal, eRepeat);
  
  if (mirror2 == true)
  {
    player.FaceDirection(eDirectionRight, eBlock);
    aHeartbeat.Play();
    Wait(80);
    TypeText("Господи, я что, схожу с ума?");
    aHeartbeat.Play();
    mirror2 = false;
  }
}

function room_Unload()
{
  aDrops_water.Stop();
}

function hBathroom_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(2, 970, 1043); 
  }
}


bool sinkFirstTime = true;
function hSink_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    if (sinkFirstTime == true)
    {
      aDrops_water.Stop();
      aSplash.Play();
      TypeText("Вы поворачиваете кран, и тот долго гудит, прежде, чем выплюнуть в раковину струю ржавой воды. Вы терпеливо ждете пока муть сольется, отвлекаетесь и успеваете опомниться в последний момент.");
      aSink_water.Play();
      TypeText("За пару секунд до того, как мутная жижа грозит ливануть через край и устроить соседят потоп, вы резко заворачиваете вентиль."); 
      TypeText("Раковина чем-то забита.");
      TypeText("Когда вода все же уходит, вы различаете что-то в сливном отверстии. Достаточно близко, чтобы заметить. Но пальцами не достать.");
      sinkFirstTime = false;
    }
    else
    {
      TypeText("Раковина забита. В сливе торчит что-то блестящее.");
    }
  }
}


function hBath_choise_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (is_washed == false)
  {
    aDrops_water.Stop();
    TypeText("Этому чугунному облупившемуся корыту место где-то на скотобойне. Эмаль сколота, на стенках - потеки ржавчины. В прожилках кафеля буйной порослю цветет плесень.");
    TypeText("Въезжая сюда, я первым делом хотел сделать ремонт. Но, глядя на все это, просто опускаются руки.");
    TypeText("Тем не менее, я не мылся уже пару дней. Стоило бы привести себя в порядок. Хотя, с другой стороны, кому какое до этого дело?");
    dBathchoice.Start();
  }
  else
  {
    TypeText("Старая чугунная ванна. Из отверстия несет гнилью.");
  }
}

function hBath_table_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("На столике, среди шампуней, лежит опасная бритва.");
  TypeText("Такими уже не пользуются. Она здесь не нужна. Ее давно следует выбросить.");
  TypeText("Но вы этого не делаете. Почему?");
}

function hMirror_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    if (mirror == false)
    {
      SetScreenTransition(eTransitionInstant);
      player.ChangeRoom(29, 0, 0); 
    }
    else
    {
      TypeText("Нет. Я не хочу смотреть в зеркало.");
    }
  }
}


function hSink_UseInv(Hotspot *theHotspot, CursorMode mode)
{
// Проверяем, держит ли игрок в руках именно заколку
  if (player.ActiveInventory == iBarrete2)
  {
    // --- УСПЕШНОЕ ДЕЙСТВИЕ ---
    TypeText("Наверно, должно получиться.");
    FadeOut(4); // Закрыл глаза (очень быстро)
    Wait(40);    // Мгновение темноты
    FadeIn(4);  // Открыл глаза
    
    TypeText("Вы аккуратно пытаетесь подцепить проволокой нечто, застрявшее в сливе, и через минуту на свет появляется небольшой металлический ключ.");
    TypeText("Как он там оказался, остается только гадать.");
    // Если заколка при этом ломается или исчезает из инвентаря:
    player.LoseInventory(iBarrete2); 
    player.AddInventory(iKey_storeroom);
    TypeText("Получен предмет: 'Ключ от кладовки'");
    // После успешного действия ОБЯЗАТЕЛЬНО сбрасываем предмет с курсора
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; // возвращаем обычный курсор
    
    // Здесь твоя логика: например, меняем глобальную переменную, 
    // чтобы замок считался открытым.
  }
  else
  {
    // --- ЕСЛИ ИГРОК ТЫКНУЛ ДРУГИМ ПРЕДМЕТОМ ---
    // Если игрок попробует применить сигареты или динозавра
    TypeText("Этот предмет здесь совершенно бесполезен.");
  }
}
