// room script file
bool sink = false;

function room_AfterFadeIn()
{
  aDrops_water.Play(eAudioPriorityNormal, eRepeat);
}

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(24, 970, 1042); 
}

function hShower_Interact(Hotspot *theHotspot, CursorMode mode)
{
  dBathchoice.Start(); 
}

function hSink_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (sink == false)
  {
    FadeOut(4);
    aDrops_water.Stop();
    AudioChannel *channel1 = aSplash.Play();
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); 
    }
    Wait(40);    
    FadeIn(4);
    sink = true;
    TypeText("Вот так вот. Немного получше.");
    aDrops_water.Play(eAudioPriorityNormal, eRepeat);
  }
  else
  {
    TypeText("Нет нужды умываться еще раз.");
  }

}

function hMirror_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(29, 0, 0); 
}

function hBath_table_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Бритва лежит на своем месте. Вы то и дело бросаете на нее взгляд.");

}

function room_Unload()
{
  aDrops_water.Stop();
}