// room script file

function room_AfterFadeIn()
{
  aDrops_water.Play(eAudioPriorityNormal, eRepeat);
}

function hExit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(24, 970, 1042); 
  }
}

function hShower_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("В данный момент - это не лучшая идея."); 
  }
}

function hSink_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    FadeOut(4);
    AudioChannel *channel1 = aSplash.Play();
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); 
    }
    Wait(40);    
    FadeIn(4);
    TypeText("Немного лучше.");
  }
}


function room_Unload()
{
  aDrops_water.Stop();
}
