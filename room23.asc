// room script file

function room_Load()
{
  IsNight = true;
  cBeatle.Animate(0, 20, eRepeat, eNoBlock);

}


function hCoridor_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    player.ChangeRoom(24, 631, 1042); 
  }
}

function hPainting1_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
  TypeText("На фото искрящийся на солнце золотой пляж.");
  }
}

function hPainting2_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
  TypeText("Рамка картины пуста.");
  }
}

function hBig_painting_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3])
  {
  TypeText("Не знаю почему, но ночью она выглядит немного зловеще.");
  }
}

