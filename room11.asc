// room script file
bool close_drawer = false;
bool photo_strangeman = false;
bool chocolate = false;


function room_Load()
{
// Правильный синтаксис для отключения авто-анимации фонов:
  if (IsNight == true) {
    SetBackgroundFrame(1); // Включает ночной фон (слот 1) и фиксирует его
  }
  else {
    SetBackgroundFrame(0); // Включает дневной фон (слот 0) и фиксирует его
  }
}

function hShelf_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
  player.ChangeRoom(3, 566, 850);
  }
  else
  {
  player.ChangeRoom(25, 566, 850);
  }
}

function hClose_drawer_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (close_drawer == false)
  {
    aLocking_shelf.Play();
    TypeText("Заперто.");
    TypeText("На секунду вам кажется, будто изнутри донесся какой-то звук. Игра воображения? Или просто скрип старого дерева? Вы осторожно прикладываете ухо к дверце.");
    FadeOut(4);
    aScary_breath.Play();
    Wait(300);
    FadeIn(4);
    TypeText("Какого... черта?");
    TypeText("Что это?");
    close_drawer = true;
  }
  else
  {
    FadeOut(4);
    aScary_breath.Play();
    Wait(300);
    FadeIn(4);
    TypeText("Я понятия не имею, что это.");
    TypeText("Такое ощущение, что... внутри кто-то дышит.");
  }
}

function hDrawer_photo_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (photo_strangeman == false)
  {
    aDrawer_open.Play();
    TypeText("Ящик пуст, за исключением черно-белой фотокарточки, почти приклеившейся к задней стенке.");
    ReadAndAddNote(1);
    TypeText("Слева мама, а справа... Кто этот человек?");
    TypeText("Я не знаю его. Да и сама фотография какая-то жуткая.");
    photo_strangeman = true;
  }
  else
  {
    aDrawer_open.Play();
    TypeText("Пустой.");
  }
}

function hEncyclopedias_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("На полке - целое собрание советских энциклопедий. Тяжёлые тома в одинаковых переплётах.");
}

function hBooks_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Старые книги, словари, справочники... От них приятно пахнет старой бумагой.");
  TypeText("От этого запаха по венам разливается томная ностальгия.");
}

function hHigh_closed_drawer_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aLocking_shelf.Play();
  TypeText("Закрыто. Если ключи где-то и есть, очень сомневаюсь, что я их найду.");
}

function oDrawer_close_Interact(Object *theObject, CursorMode mode)
{
  aDrawer_open.Play();
  oDrawer_open1.Visible = true;
  oDrawer_open2.Visible = true;
  oDrawer_close.Visible = false;
  if (chocolate == false)
  {
    oChocolate.Visible = true;
  }
  else
  {
    oChocolate.Visible = false;
  }
}

function oDrawer_open_Interact(Object *theObject, CursorMode mode)
{
    aDrawer_open.Play();
    oDrawer_open1.Visible = false;
    oDrawer_open2.Visible = false;
    oDrawer_close.Visible = true;
    oChocolate.Visible = false;
}

function oDrawer_open2_Interact(Object *theObject, CursorMode mode)
{
    aDrawer_open.Play();
    oDrawer_open1.Visible = false;
    oDrawer_open2.Visible = false;
    oDrawer_close.Visible = true;
    oChocolate.Visible = false;
}

function oChocolate_Interact(Object *theObject, CursorMode mode)
{
  TypeText("В ящичке лежит забытая плитка шоколада.");
  oChocolate.Visible = false;
  player.AddInventory(iChocolate);
  TypeText("Получен предмет: «Плитка шоколада»");
  chocolate = true;
}

function hLow_closed_drawer_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aLocking_shelf.Play();
  TypeText("Закрыто. Если ключи где-то и есть, очень сомневаюсь, что я их найду.");
}

function hHigh_closed_drawer_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iArmature)
  {
    TypeText("Чтобы на это сказала матушка...");
    FadeOut(4); 
    AudioChannel *channel1 = aBreaking2.Play();
    
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); 
    }
    oHigh_draw.Visible = true;
    FadeIn(4);  
    TypeText("Черт, этот пустой.");
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; 
    }
  else
  {
    TypeText("Ума не приложу, что с этим делать.");
  }

}


function hLow_closed_drawer_UseInv(Object *theObject, CursorMode mode)
{
  if (player.ActiveInventory == iArmature)
  {
    TypeText("Чтобы на это сказала матушка...");
    FadeOut(4); 
    AudioChannel *channel1 = aBreaking2.Play();
    
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); 
    }
    oLow_draw.Visible = true;
    FadeIn(4);  
    TypeText("Ящик забит школьными тетрадками и дневниками, которые мама сохранила на память, хотя я все порывался их выкинуть.");
    TypeText("Это мило, но...");      
    TypeText("Почему это здесь?");
    ReadAndAddNote(7);
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; 
    }
  else
  {
    TypeText("Ума не приложу, что с этим делать.");
  }

}

function hClose_drawer_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iArmature)
  {
    TypeText("Черт, закрыт так плотно, что этой штукой тут не подлезть. Боюсь, ничего не получится.");
  }
  else
  {
    TypeText("Ума не приложу, что с этим делать.");
  }
}

