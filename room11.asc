// room script file
bool close_drawer = false;
bool photo_strangeman = false;

function hShelf_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(3, 566, 850);
}

function hClose_drawer_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (close_drawer == false)
  {
    aLocking_shelf.Play();
    TypeText("Заперто.");
    TypeText("На секунду вам кажется, будто изнутри донесся какой-то звук. Игра воображения? Или просто ветер? Вы осторожно прикладываете ухо к дверце.");
    FadeOut(4);
    aScary_breath.Play();
    Wait(300);
    FadeIn(4);
    TypeText("Какого черта?");
    TypeText("Что это?");
    close_drawer = true;
  }
  else
  {
    FadeOut(4);
    aScary_breath.Play();
    Wait(300);
    FadeIn(4);
    TypeText("Я понятия не имею, что это.");
    TypeText("Такое ощущение, что внутри кто-то дышит...");
  }
}

function hDrawer_photo_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (photo_strangeman == false)
  {
    aDrawer_open.Play();
    TypeText("Ящик пуст, за исключением черно-белой фотокарточки, почти приклеевшейся к задней стенке.");
    ReadAndAddNote(1);
    TypeText("Слева мама, а справа... Кто этот человек?");
    TypeText("Если честно, выглядит жутко.");
    photo_strangeman = true;
  }
  else
  {
    aDrawer_open.Play();
    TypeText("Пустой.");
  }
}
