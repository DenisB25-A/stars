{
  TypeText("Раздолбанный шкафчик. Зато любопытство удовлетворено.");
}

function oLow_draw_Interact(Object *theObject, CursorMode mode)
{
  TypeText("Раздолбанный шкафчик. Зато любопытство удовлетворено.");
}


