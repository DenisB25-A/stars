bool introDone = false;
bool windowFirstTime = true; // Переменная-флаг: правда ли, что мы кликаем впервые?

// Вступительная анимация
function room_Load()
{
  if (introDone == false)
  {
  // Илья уже в позе, когда мы входим в комнату
  cEgo.SayAt(-10, -10, 10, " "); 
  cEgo.LockView(2); 
  cEgo.Animate(0, 30, eRepeat, eNoBlock); // 20 — отличная скорость для тяжелого дыхания
  }
}

function room_AfterFadeIn()
{
  if (introDone == false)
  {
  // 1. Монолог Ильи
  // Твоя функция TypeText сама включит рамку и будет ждать клика
  TypeText("Снова кошмары... С тех пор, как переехал сюда, стало лишь хуже.");
  TypeText("Не помню, когда я высыпался в последний раз. Честно признаться, даже не помню, какой сегодня день.");
  TypeText("Бессоница - ужасная штука. Как трещина, распирающая тебя изнутри. Дробящая на осколки, которые под утро мучительно трудно собрать. Теряется ощущение времени: все сливается в один бесконечно-долгий и серый день, который никак не может закончиться.");
  TypeText("... и в котором абсолютно ни на что нету сил.");
  TypeText("Очень хочется покурить. Хех. Пожалуй единственное, что не надоело мне за последние дни.");

  // 2. Затемнение экрана
  FadeOut(5); // Цифра 5 — это скорость (чем меньше, тем медленнее)

    // 3. Мгновенное изменение состояния Ильи
  cEgo.UnlockView(); // Возвращаем обычный вид (ходьба/ожидание)
    
    // Укажи здесь координаты центра твоей комнаты
    // Например, если разрешение 1280x720, то центр примерно:
  cEgo.x = 1258; 
  cEgo.y = 996; 
    
    // Можно также сменить направление взгляда персонажа, чтобы он смотрел на игрока
  cEgo.FaceDirection(eDirectionDown);

  Wait(40); // Небольшая пауза в темноте для атмосферы

    // 4. Появление экрана
  FadeIn(5);
    
  introDone = true;
  }
}

function hBears_1_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    if (windowFirstTime == true) 
    {
      // Текст для самого первого раза
      TypeText(
      "'Утро в сосновом лесу'... Висит здесь, сколько себя помню. В детстве она очень мне нравилась. Правда, по вечерам немного пугала. Казалось, будто в моей комнате есть свой маленький лес."
      );
      
      // Сразу меняем флаг на false, чтобы в следующий раз сработало другое условие
      windowFirstTime = false; 
    }
    else 
    {
      // Текст для всех последующих нажатий
      TypeText("Смотря на нее, я сам мечтал стать художником. Конечно же, не стал.");
    }
  }
}

function hPainting_1_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("Фотография с какого-то отпуска, в который я ездил с мамой, когда был ребенком. Если честно, я ничего оттуда не помню.");
  }
}

function hPainting_2_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("В рамке ничего нет... Странно.");
  }
}

function hBed_1_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("Постель не помешало бы сменить.");
  }
}

function hHotspot6_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
// 1. Проверяем, стоит ли Илья рядом с дверью (используем наш регион)
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3])
  {
    player.ChangeRoom(2, 631, 1043); 
  }
}

function hUnder_bed_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    TypeText("Темное, свитое тенями пространство щекочет ваши детские страхи, и вы невольно ежитесь. Но вы ведь уже взрослый, верно?");
    dUnder_bed.Start();
  }
}

function hShelf_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[4])    
  {
    player.ChangeRoom(12, 0, 0);
  }
}

function hBedside_table_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("На прикроватной тумбочке мелочь и пустая упаковка гидроксизина.");
  TypeText("Впрочем, пара таблеток еще завалялась на дне картонной коробки. Последних. Теперь я не могу себе больше его позволить.");
}
