bool introDone = false;
bool windowFirstTime = true; // Переменная-флаг: правда ли, что мы кликаем впервые?

// Вступительная анимация
function room_Load()
{
  
  if (introDone == false)
  {
  // Илья уже в позе, когда мы входим в комнату
  cEgo.Transparency = 0;
  cEgo.SayAt(-10, -10, 10, " "); 
  cEgo.LockView(2); 
  cEgo.Animate(0, 30, eRepeat, eNoBlock); // 20 — отличная скорость для тяжелого дыхания
  }
  
}

function room_AfterFadeIn()
{
  
  if (introDone == false)
  {
  // 1. Монолог Ильи
  // Твоя функция TypeText сама включит рамку и будет ждать клика
  start_diming();
  move_carret_back();
// Увеличили второй параметр с 150 до 200–220 для более размеренного темпа
  show_accumulated_text_after("Кошмары.", 200, true);
  show_accumulated_text_after("С тех пор, как переехал сюда, стало лишь хуже.", 220, true);
  show_accumulated_text_after("Бессоница... и мне кажется, что я уже неделю не выходил из дома.", 220, true);
  show_accumulated_text_after("А еще я чувствую, что полезу на стену, если сейчас же не выкурю сигарету.", 220, true);


  Wait(200);
  move_carret_back();
  start_lighter();
  
 
  // 2. Затемнение экрана
  FadeOut(5); // Цифра 5 — это скорость (чем меньше, тем медленнее)

    // 3. Мгновенное изменение состояния Ильи
  cEgo.UnlockView(); // Возвращаем обычный вид (ходьба/ожидание)
    
    // Укажи здесь координаты центра твоей комнаты
    // Например, если разрешение 1280x720, то центр примерно:
  cEgo.Loop = 2;
  cEgo.x = 1258; 
  cEgo.y = 996; 
    


  Wait(40); // Небольшая пауза в темноте для атмосферы

    // 4. Появление экрана
  FadeIn(5);
  TypeText("Ну нет, только не это.");
  TypeText("Где же они?");
  TypeText("Кажется, я где-то выронил пачку.");
  ChangeMood(-1);
  introDone = true;
  }

  if (unknown_sound == 1)
  {
    TypeText("Здесь... здесь кто-нибудь есть?");
    unknown_sound = unknown_sound + 1;
  }


}

function hBears_1_Interact(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    if (windowFirstTime == true) 
    {
      // Текст для самого первого раза
      TypeText(
      "'Утро в сосновом лесу'... Висит здесь, сколько себя помню. В детстве она очень мне нравилась. Правда, по вечерам немного пугала. Казалось, будто в моей комнате есть свой маленький лес."
      );
      
      // Сразу меняем флаг на false, чтобы в следующий раз сработало другое условие
      windowFirstTime = false; 
    }
    else 
    {
      // Текст для всех последующих нажатий
      TypeText("Смотря на нее, я сам мечтал стать художником. Конечно же, не стал.");
    }
  }
}

function hPainting_1_Interact(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("Фотография с пляжа, на который мы ездили с мамой, когда я был ребенком. Если честно, я ничего оттуда не помню.");
  }
}

function hPainting_2_Interact(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("Рамка пуста. Хм.");
  }
}

function hBed_1_Interact(Hotspot *theHotspot, CursorMode mode)
{
if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    TypeText("Постель не помешало бы сменить.");
  }
}

function hHotspot6_Interact(Hotspot *theHotspot, CursorMode mode)
{
// 1. Проверяем, стоит ли Илья рядом с дверью (используем наш регион)
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3])
  {
    player.ChangeRoom(2, 631, 1043); 
  }
}

function hUnder_bed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    TypeText("Под кроватью темно и пыльно. Как и всегда.");
    dUnder_bed.Start();
  }
}

function hShelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[4])    
  {
    player.ChangeRoom(12, 0, 0);
  }
}
