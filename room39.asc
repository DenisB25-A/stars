// room script file

function room_AfterFadeIn()
{
  if (Game.DoOnceOnly("room39_first_visit"))
  {
    Wait(40);
    TypeText("Так... а где шкаф?");
  }
}

function hExit_storeroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound2.Play();
  player.ChangeRoom(24, 970, 1042); 
}

function hBoxes_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Вы наклоняетесь и бегло осматриваете содержимое коробок, но не находите ничего интересного. Это просто старый хлам. Когда-нибудь нужно будет навести здесь порядок.");
}

function hJars_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Полки доверху забиты соленьями. Все-таки матушка была очень запасливой.");
}

function hJars2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Коллекция пустой стеклотары. Как это бывает у стариков - особо и не нужна, а выбросить жалко.");
}

function hDark_hole_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Ваш взгляд падает на темную полку у самого пола. Раньше вы не обращали на нее внимания. Да и что там может быть, кроме пыли и паутины? Или... чего-нибудь совсем неприятного.");
  dDark_hole.Start();
}

function hPassage_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(40, 430, 970);
}


