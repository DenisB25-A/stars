// room script file

function hExit_storeroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound2.Play();
  player.ChangeRoom(24, 970, 1042); 
}

function hBoxes_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Груда коробок, в которых нет ничего интересного.");
}

function hJars_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Банки с огурцами, соленья, консервированные помидоры, варенье, грибы. Чтож, по крайней мере, в ближайший месяц я не умру с голоду.");
}

function hBoxes2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Коробки набиты старой макулатурой, которую никто не удосужился выбросить. По типу журналов из 90-х: 'Сделай сам' и 'Крестьянка'.");
}

function hJars2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стеклотара для засолки. Мне она точно не пригодится.");
}

function hBoxes3_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Не сомневаюсь, что если хорошенько покопаться в этом барахле, то можно собрать и ядерный реактор. Однако у меня нет на это ни сил, ни желания.");
}

function room_FirstLoad()
{
  TypeText("Так... а где шкаф?");
}

function hPassage_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(40, 430, 970);
}
