// room script file

function hRight_door_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound3.Play();
  player.ChangeRoom(44, 288, 948); 
}

function hLeft_door_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aOld_door.Play();
  player.ChangeRoom(40, 1533, 970); 
}

function room_AfterFadeIn()
{
  if (ManekenPhase == 2)
    {
      // Небольшая пауза, чтобы зритель успел понять, что происходит
      Wait(20);

      // Манекен идет влево (например, к точке X=500)
      cEvil_Maneken.Walk(500, 1018, eBlock, eAnywhere);
      
      cEvil_Maneken.LockViewFrame(MANEKEN_CUT, 2, 0);
      Wait(80);
      cEvil_Maneken.Walk(1450, 1018, eBlock, eAnywhere);
      // КАТСЦЕНА ОКОНЧЕНА. Наводим порядок:
      ManekenPhase = 0; // Сбрасываем фазу
      cEgo.Transparency = 0; // Возвращаем главному герою тело (делаем видимым)
      EndCutscene(); // Выключаем режим катсцены

      // Возвращаем игрока обратно в 40-ю комнату 
      // Укажи те координаты X, Y, где он стоял до начала события!
      cEgo.ChangeRoom(40, 805, 970); 
    }
}

function room_Load()
{
  if (ManekenPhase == 2)
    {
      // Телепортируем манекена заранее, пока экран черный
      cEvil_Maneken.ChangeRoom(43, 1450, 1018);
    }
}
