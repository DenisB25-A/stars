// room script file
function room_Load()
{
  SetBackgroundFrame(0);
}

function room_AfterFadeIn()
{
// Скрипт комнаты с зеркалом
  // 1. Пауза для атмосферы
  TypeText("Мешки под глазами.");
  FadeIn(1);
  FadeOut(1);


  // Эффект моргания
  FadeIn(1);
  FadeOut(1);
  FadeIn(1);
  FadeOut(1);

  // Меняем фон на кадр с женщиной
  SetBackgroundFrame(1);
  aMirror.Play();
  FadeIn(50);
  Wait(10);

  FadeOut(50);  
  player.ChangeRoom(4, 665, 1058);

}


