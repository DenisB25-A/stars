// room script file
function room_Load()
{
  SetBackgroundFrame(0);
  FadeOut(1);
  Wait(15);
  FadeIn(1);
}
function room_AfterFadeIn()
{
  if (IsNight == false)
  {
  // 1. Начало: мы уже в комнате, экран чёрный.

    // Открываем глаза в первый раз
    FadeIn(60); // Быстрый вход
    TypeText("Не люблю смотреть в зеркало.");
    

    // ПЕРВОЕ МОРГАНИЕ
    FadeOut(2); // Закрыл глаза (очень быстро)
    Wait(40);    // Мгновение темноты
    FadeIn(2);  // Открыл глаза
    
    // Теперь текст будет виден!
    TypeText("Я порядком устал видеть это лицо каждый день.");
    TypeText("Мы оба застряли, верно, приятель? Я здесь, а ты — там.");


    // ВТОРОЕ МОРГАНИЕ (перед изменением реальности)
    FadeOut(2);
    Wait(40);
    FadeIn(2);
    TypeText("Иногда думаю, почему бы тебе не исчезнуть? Почему бы нам просто не покончить со всем?");
    
    FadeOut(2);
    Wait(40);
    
    // Пока глаза закрыты, меняем фон на кадр с женщиной
    SetBackgroundFrame(1);
    aMirror.Play();
    FadeIn(50);
    Wait(10);
    FadeOut(50);  
    player.ChangeRoom(4, 665, 1077);
    ChangeMood(-1);
    mirror = true;
    mirror2 = true;
  }
  else
  {
    TypeText("Только мое отражение. Никаких фантомов. Никаких теней за спиной. Я пока еще не рехнулся.");
    player.ChangeRoom(26, 665, 1077);
  }

}