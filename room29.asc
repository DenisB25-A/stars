// room script file
function room_Load()
{
  SetBackgroundFrame(0);
  FadeOut(1);
  Wait(15);
  FadeIn(1);
}
function room_AfterFadeIn()
{
  if (IsNight == false)
  {
  // 1. Начало: мы уже в комнате, экран чёрный.

    // Открываем глаза в первый раз
    Wait(40);
    TypeText("Я не люблю смотреть в зеркало.");
    

    // ПЕРВОЕ МОРГАНИЕ
    FadeOut(2); 
    Wait(40);    
    FadeIn(2);  
    
    // Теперь текст будет виден!
    TypeText("Опять это лицо. Те же глаза. Снова эта усталость.");
    TypeText("Мы будто застряли, правда, приятель? Я здесь, а ты — там.");


    // ВТОРОЕ МОРГАНИЕ (перед изменением реальности)
    FadeOut(2);
    Wait(40);
    FadeIn(2);
    TypeText("Иногда я думаю... тебе ведь тоже это все надоело? Почему бы нам просто...");
    
    FadeOut(2);
    Wait(40);
    
    // Пока глаза закрыты, меняем фон на кадр с женщиной
    SetBackgroundFrame(1);
    aMirror.Play();
    FadeIn(50);
    Wait(10);
    FadeOut(50);
    SetNextScreenTransition(eTransitionInstant);
    mirror = true;
    mirror2 = true;
    player.ChangeRoom(4, 665, 1077);
    ChangeMood(-1);
  }
  else
  {
    TypeText("Только мое отражение. Никаких фантомов. Никаких теней за спиной. Я пока еще не рехнулся.");
    player.ChangeRoom(26, 665, 1077);
  }

}