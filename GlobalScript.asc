function UpdateMoodUI()
{
// 1. Проверяем ноль — пустая бутыль
  if (mood_score == 0) 
  {
    btn_Bottle.NormalGraphic = 189; // Пустая бутыль
    return;
  }

  // 2. Берем абсолютное значение (модуль)
  int val = mood_score;
  if (val < 0) val = -val;

  // 3. Считаем уровень бутыли (от 1 до 6)
  int level = (val + 1) / 2;
  if (level > 6) level = 6; // Все, что выше 10, остаётся 6-м уровнем

  // 4. Присваиваем нужный спрайт
  if (mood_score > 0) 
  {
    // При level = 1 получим: 189 + 1 = 190 (зелёная-1)
    btn_Bottle.NormalGraphic = 189 + level; 
  }
  else 
  {
    // Если первая красная бутыль имеет ID 196:
    // При level = 1 получим: 195 + 1 = 196 (красная-1)
    btn_Bottle.NormalGraphic = 195 + level; 
  }
}

// Смена НАСТРОЕНИЯ:
function ChangeMood(int amount) 
{
  mood_score = mood_score + amount; 
  
  if (mood_score > 10) mood_score = 10;
  if (mood_score < -10) mood_score = -10;

  // --- НАШ НОВЫЙ БЛОК: РЕАКЦИЯ НА ПАДЕНИЕ НАСТРОЕНИЯ ---
  if (amount < 0) 
  {
    // Резко нагоняем тьму (0 - сплошная чернота, 30 - густая тень, 100 - невидимо)
    gDarkOverlay.Transparency = 30; 
    gDarkOverlay.Visible = true;
    
    // Включаем "моторчик" плавного исчезновения
    stressFlash = 1; 
  }
  // -----------------------------------------------------

  if (amount > 0) {
      lblMoodStatus.Text = String.Format("+%d", amount);
      lblMoodStatus.TextColor = 2016; 
  }
  else {
      lblMoodStatus.Text = String.Format("%d", amount);
      lblMoodStatus.TextColor = 63488; 
  }
  
  UpdateMoodUI();
  
  gMoodPanel.Visible = true;
  moodTimer = 160; 
  if (moodFadeState == 0 || moodFadeState == 3) {
      moodFadeState = 1; 
  }
}

    //Осмотр предметов в инвентаре
function btnExamine_OnClick(GUIControl *control, MouseButton button) {
  gContext.Visible = false; 
  
  if (itemToExamine != null) {
    // Получаем текст из созданного нами свойства "Description"
    String lookText = itemToExamine.GetTextProperty("Description");

    // Если свойство не заполнено (пустое), выводим стандартную фразу
    if (String.IsNullOrEmpty(lookText)) {
      TypeText("Ничего особенного.");
    } 
    else {
      // Иначе выводим то, что написали в редакторе
      TypeText(lookText);
    }
  }
}

// Функция ИСПОЛЬЗОВАТЬ инвентаря
function Use_button_OnClick(GUIControl *control, MouseButton button)
{
  gContext.Visible = false;
  if (itemToExamine == null) return;

  if (itemToExamine == iCigarettes) 
  {
    if (was_balcony_thoughts == false)
    {
      TypeText("Пожалуй, хоть раз стоит побыть приличным человеком и покурить на балконе, а не здесь.");
    }
    else
    {
      // 1. Запоминаем, куда сейчас смотрит Илья
      int currentLoop = cEgo.Loop; 
      
      // 2. Блокируем View 4 (анимация курения)
      cEgo.LockView(4); 
      aSmoke.Play();
      
      // 3. Проигрываем анимацию в зависимости от направления.
      cEgo.Animate(currentLoop, 5, eOnce, eBlock); 
      
      cEgo.UnlockView();
      
      TypeText("...");
    }
  }
  else if (itemToExamine == iVodka) 
  {
    if (Game.DoOnceOnly("first_vodka_drink")) 
      {
          // Этот блок сработает только один раз
          TypeText("Если честно, выпить сейчас бы не помешало.");
          int currentLoop = cEgo.Loop; 
          
          // 2. Блокируем View 15 (в комментарии у тебя указано 4, но вызывается 15)
          cEgo.LockView(15); 
                
          // 3. Проигрываем анимацию в зависимости от направления.
          cEgo.Animate(currentLoop, 5, eOnce, eBlock); 
          
          cEgo.UnlockView();
          
          TypeText("Тело реагирует быстрее, чем мозг, давая понять, что это была крайне плохая идея.");
          TypeText("Вкусовые рецепторы взрываются от смеси чего-то, напоминающего стеклоочиститель пополам с кислотой, и вас едва не выворачивает наизнанку.");
          TypeText("Вы сплевываете, откашливаетесь и решаете, что все же недостаточно опустились до того, чтобы это пить.");
          TypeText("(Но еще не вечер, как говорится).");
      }
      else 
      {
          // Этот блок будет срабатывать при всех повторных попытках выпить
          TypeText("Эту штуку нужно запретить Женевской Конвенцией."); 
      }
  }
    else if (itemToExamine == iMilk) 
    {
    if (Game.DoOnceOnly("first_milk_drink")) 
      {
          // Этот блок сработает только один раз
          int currentLoop = cEgo.Loop; 
          
          // 2. Блокируем View 15 (в комментарии у тебя указано 4, но вызывается 15)
          cEgo.LockView(16); 
                
          // 3. Проигрываем анимацию в зависимости от направления.
          cEgo.Animate(currentLoop, 5, eOnce, eBlock); 
          
          cEgo.UnlockView();
          
          TypeText("Вы замираете на секунду и тут же сплевываете несколько раз, пытаясь избавиться от липкого вкуса плесени.");
          TypeText("Оно прокисло. Надо было хотя бы глянуть срок годности. Или положить молоко в холодильник несколько дней назад.");
          TypeText("Почему такие вещи всегда происходят именно со мной?");
          TypeText("Мелочь, однако настроение безнадежно испорчено.");
          ChangeMood(-1);
      }
      else 
      {
          // Этот блок будет срабатывать при всех повторных попытках выпить
          TypeText("Это пакет прокисшего молоко. Со вкусом грибка, соскобленного с подвальной стены. Что с ним можно сделать?"); 
      }
    } 
  else if (itemToExamine == iBarrete)
  {
    FadeOut(4);
    aBarrete.Play();
    Wait(40);
    player.LoseInventory(iBarrete);
    player.AddInventory(iBarrete2);
    FadeIn(4);  
  }
  else if (itemToExamine == iChocolate)
  {
    FadeOut(4);
    aEating.Play();
    Wait(40);
    player.LoseInventory(iChocolate);
    FadeIn(4);  
    ChangeMood(1);
    TypeText("Всего лишь шоколад, но настроение немного улучшилось."); 
  }

  else if (itemToExamine == iMusic_player)
  {
    TypeText("К сожалению, он сломался давным давно. Да и кассет для него уже не найти.");
  }
  
  else 
  {
    // --- НОВАЯ ЛОГИКА ДЛЯ ОСТАЛЬНЫХ ПРЕДМЕТОВ ---
    
    // 1. Кладем выбранный предмет в активный слот игрока
    player.ActiveInventory = itemToExamine;
    
    // 2. Меняем режим курсора на "Использование инвентаря" (курсор станет картинкой предмета)
    mouse.Mode = eModeUseinv;
    
    // 3. Закрываем инвентарь. В твоем коде используется gInventory_menu и gInventory,
    // скрываем их, чтобы игрок сразу видел комнату.
    gInventory_menu.Visible = false;
    gInventory.Visible = false; 
    
    // Если при закрытии инвентаря нужно возвращать обычный режим клавиатуры, 
    // можно добавить это здесь.
  }
  
  itemToExamine = null; 
}



