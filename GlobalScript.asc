function btnAbout_OnClick(GUIControl *control, MouseButton button)
{
  Display("%s\nAGS %s", Game.Name, System.Version);
}

function btnQuit_OnClick(GUIControl *control, MouseButton button)
{
  close_owning_gui(control);
  open_gui(gExitGame);
}

function sldAudio_OnChange(GUIControl *control)
{
  System.Volume = sldAudio.Value;
}

function sldVoice_OnChange(GUIControl *control)
{
  SetSpeechVolume(sldVoice.Value);
}

function btnVoice_OnClick(GUIControl *control, MouseButton button)
{
  if (Speech.VoiceMode == eSpeechVoiceAndText)
  {
    Speech.VoiceMode = eSpeechVoiceOnly;
    btnVoice.Text = "Voice only";
  }
  else if (Speech.VoiceMode == eSpeechVoiceOnly)
  {
    Speech.VoiceMode = eSpeechTextOnly;
    btnVoice.Text = "Text only";
  }
  else if (Speech.VoiceMode == eSpeechTextOnly)
  {
    Speech.VoiceMode = eSpeechVoiceAndText;
    btnVoice.Text = "Voice and Text";
  }
}

function sldGamma_OnChange(GUIControl *control)
{
  System.Gamma = sldGamma.Value;
}

function btnDefault_OnClick(GUIControl *control, MouseButton button)
{
  set_default_options();
}

function sldSpeed_OnChange(GUIControl *control)
{
  SetGameSpeed(sldSpeed.Value);
}

//=============================================================================
// SAVE / LOAD DIALOGS
//=============================================================================

int find_save_slot(String name)
{
  bool slots[] = new bool[999];
  int slots_used = 0;

  // record which slots are occupied already, 
  // if the types save name matches any existing one, then use that
  for (int i = 0; i < lstSaveGamesList.ItemCount; i++)
  {
    if (lstSaveGamesList.Items[i] == name)
    {
      // found existing save with matching name
      return lstSaveGamesList.SaveGameSlots[i];
    }

    // remember which slots are already taken
    slots[lstSaveGamesList.SaveGameSlots[i]] = true;
    slots_used++;
  }
  
  // current version of AGS has a limit of 50 save slots
  // that may be displayed in the ListBox at the same time
  if (slots_used >= 50)
  {
    return -1;
  }

  // find first free save slot, starting with slot 1 (for "cosmetic" purposes)
  for (int i = 1; i < 999; i++)
  {
    if (!slots[i])
    {
      return i;
    }
  }

  // no free slots found
  return -1;
}

function btnSaveGame_OnClick(GUIControl *control, MouseButton button)
{
  int gameSlotToSaveInto = find_save_slot(txtNewSaveName.Text);

  if (gameSlotToSaveInto < 0)
  {
    Display("Save slots limit of 50 is reached, delete some of the existing saves first!");
  }
  else
  {
    SaveGameSlot(gameSlotToSaveInto, txtNewSaveName.Text);
    close_owning_gui(control);
  }
}

function btnRestoreGame_OnClick(GUIControl *control, MouseButton button)
{
  if (lstRestoreGamesList.SelectedIndex >= 0)
  {
    RestoreGameSlot(lstRestoreGamesList.SaveGameSlots[lstRestoreGamesList.SelectedIndex]);
  }

  close_owning_gui(control);
}

function lstSaveGamesList_OnSelectionCh(GUIControl *control)
{
  txtNewSaveName.Text = lstSaveGamesList.Items[lstSaveGamesList.SelectedIndex];
}

function txtNewSaveName_OnActivate(GUIControl *control)
{
  // pressing Return in the text box simulates clicking the save button
  btnSaveGame_OnClick(control, eMouseLeft);
}

function btnDeleteSave_OnClick(GUIControl *control, MouseButton button)
{
  if (lstSaveGamesList.SelectedIndex >= 0)
  {
    DeleteSaveSlot(lstSaveGamesList.SaveGameSlots[lstSaveGamesList.SelectedIndex]);
    lstSaveGamesList.FillSaveGameList();
  }
}

//=============================================================================
// RESTART DIALOG
//=============================================================================

function btnRestart_OnClick(GUIControl *control, MouseButton button)
{
  close_owning_gui(control);
}

function btnRestartYes_OnClick(GUIControl *control, MouseButton button)
{
  RestartGame();
}

//=============================================================================
// QUIT DIALOG
//=============================================================================

function btnConfirmedQuit_OnClick(GUIControl *control, MouseButton button)
{
  QuitGame(0);
}

function SetMainMenuButtonsActive(bool active)
{
  for (int i = 0; i < gMainMenu.ControlCount; i++)
  {
    gMainMenu.Controls[i].Enabled = active;
  }
}

//=============================================================================
// PLAYER INPUT
//=============================================================================


function CancelSaveNameInput()
{
  // Если карточка была выбрана
  if (selectedSaveCard >= 0 && selectedSaveCard < 4)
  {
    // Очищаем поле ввода выбранной карточки
    saveSlotInputs[selectedSaveCard].Text = "";
    saveSlotInputs[selectedSaveCard].Visible = false;

    // Возвращаем подпись
    saveSlotLabels[selectedSaveCard].Visible = true;
  }

  // Сбрасываем выбор
  selectedSaveCard = -1;
  selectedSaveSlot = -1;
}

function on_key_press(eKeyCode keycode, int mod)
{
  // =================================================
  // ESCAPE — ПРИОРИТЕТНАЯ ОБРАБОТКА
  // =================================================

  if (keycode == eKeyEscape)
  {
        // Если открыто подтверждение выхода из игры,
    // сначала закрываем только его.
    if (gExit_in_game.Visible)
    {
        gExit_in_game.Visible = false;
        gMenu_ingame.Clickable = true;
        return;
    }
    // Сначала закрываем окно подтверждения выхода
    if (gExit.Visible)
    {
        gExit.Visible = false;

        // Если мы в главном меню — снова активируем его кнопки
        if (player.Room == 99)
        {
          SetMainMenuButtonsActive(true);
        }

        return;
    }
    // Если открыто подтверждение удаления
    if (gDeleteSaveConfirm.Visible)
    {
      gDeleteSaveConfirm.Visible = false;
      gSave_game.Clickable = true;

      if (selectedSaveCard >= 0 && selectedSaveCard < 4)
      {
        saveSlotInputs[selectedSaveCard].Visible = true;
      }
      pendingDeleteSaveSlot = -1;
      pendingOverwriteSaveSlot = -1;
      pendingOverwriteSaveCard = -1;
      pendingOverwriteSaveName = "";

      saveConfirmAction = 0;

      return;
    }
    // Если открыто окно сохранения — закрываем его
    if (gSave_game.Visible)
    {
      CancelSaveNameInput();

      gSave_game.Visible = false;

      // Возвращаем меню паузы
      gMenu_ingame.Visible = true;

      mouse.Mode = eModePointer;
      return;
    }

    // В главном меню Escape больше ничего не делает
    if (player.Room == 99)
       return;

    // Закрываем только один интерфейс за нажатие
    if (gInventory_menu.Visible)
    {
      gInventory_menu.Visible = false;
      gContext.Visible = false;
      itemToExamine = null;

      mouse.Mode = eModeWalkto;
      return;
    }
    else if (gViewer.Visible)
    {
      gViewer.Visible = false;
      return;
    }
    else if (gJournal.Visible)
    {
      gJournal.Visible = false;
      return;
    }
    else if (gEmailReader.Visible)
    {
      gEmailReader.Visible = false;
      return;
    }
    else if (gContext.Visible)
    {
      gContext.Visible = false;
      return;
    }

    // Закрываем внутриигровое меню
    if (gMenu_ingame.Visible)
    {
      gMenu_ingame.Visible = false;
      gDarkOverlay.Visible = false;
      UnPauseGame();
      mouse.Mode = eModeWalkto;
      return;
    }

    // Если других окон нет — открываем внутриигровое меню
    PauseGame();

    gDarkOverlay.Transparency = 50;
    gDarkOverlay.Visible = true;

    gMenu_ingame.Visible = true;
    mouse.Mode = eModePointer;

    return;
  }


  // =================================================
  // ДАЛЬШЕ — ТОЛЬКО ИГРОВЫЕ КЛАВИШИ
  // =================================================

  // В главном меню игровые клавиши не работают
  if (player.Room == 99)
    return;

  // Не обрабатываем клавиши во время паузы
  if (IsGamePaused() || !IsInterfaceEnabled())
    return;


  // =================================================
  // ОТЛАДОЧНЫЕ КОМБИНАЦИИ
  // =================================================

  if (mod & eKeyModCtrl)
  {
    if (keycode == eKeyS)
      Debug(0, 0);

    else if (keycode == eKeyV)
      Debug(1, 0);

    else if (keycode == eKeyA)
      Debug(2, 3);

    else if (keycode == eKeyX)
      Debug(3, 0);

    return;
  }


  // =================================================
  // СОХРАНЕНИЕ И ЗАГРУЗКА
  // =================================================

  if (keycode == eKeyF5)
  {
    show_save_game_dialog();
  }

  else if (keycode == eKeyF7)
  {
    show_restore_game_dialog();
  }

  else if (keycode == eKeyF12)
  {
    SaveScreenShot("screenshot.pcx");
  }


  // =================================================
  // ИНВЕНТАРЬ
  // =================================================

  else if (keycode == eKeyTab)
  {
    if (!gInventory_menu.Visible)
    {
      gInventory_menu.Visible = true;
      mouse.Mode = eModeInteract;
    }
    else
    {
      gInventory_menu.Visible = false;
      gContext.Visible = false;
      itemToExamine = null;

      mouse.Mode = eModeWalkto;
    }
  }


  // =================================================
  // НАСТРОЕНИЕ
  // =================================================

  else if (keycode == eKeySpace)
  {
    moodPanelToggled = !moodPanelToggled;
    moodFadeState = 0;

    if (moodPanelToggled)
    {
      gMoodPanel.Visible = true;
    }
  }


  // =================================================
  // ЖУРНАЛ
  // =================================================

  else if (keycode == eKeyJ)
  {
    if (!gJournal.Visible)
    {
      UpdateJournalUI();
      gJournal.Visible = true;
      mouse.Visible = true;
    }
    else
    {
      gJournal.Visible = false;
    }
  }
}

function handle_room_click(MouseButton button)
{
  if (button == eMouseLeft)
  {
    Room.ProcessClick(mouse.x, mouse.y, mouse.Mode );
  }
  else if (button == eMouseRight || button == eMouseWheelSouth)
  {
    // ИСПРАВЛЕНИЕ: Если держим предмет - правый клик его сбрасывает
    if (player.ActiveInventory != null) 
    {
      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto; // Возвращаем обычный курсор-шаги
    }

  }
  else if (button == eMouseMiddle)
  {
    Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
  }
 
  if (gContext.Visible) 
  {
    gContext.Visible = false;
    return; 
  }
}

// Скрипт: взаимодействие - мысли

function TypeText(String message)
{
  if (message.Chars[0] == '>') 
  {
    lblGameText.TextColor = 2; // Твой зеленый цвет
    
    // Исправлено: Substring с маленькой 's'
    lblGameText.Text = message.Substring(1, message.Length - 1); 
  }
  else if (message.Chars[0] == '<') 
  {
    lblGameText.TextColor = 4; 
    
    // Исправлено: Substring с маленькой 's'
    lblGameText.Text = message.Substring(1, message.Length - 1); 
  }
  else
  {
    lblGameText.TextColor = 65535; // Твой стандартный цвет (например, белый)
    lblGameText.Text = message;    
  }
    // Временно показываем нейтральный курсор
  mouse.UseModeGraphic(eModeNeutral);
  
  gTextBar.Visible = true;    
  WaitMouseKey(500);
  // --- ВОТ ЭТА СТРОЧКА ---
  // Ждем, пока игрок физически ОТПУСТИТ левую кнопку мыши, 
  // прежде чем убрать текстовую плашку и вернуть управление игре.

  gTextBar.Visible = false;   
  
    // Возвращаем стандартный курсор текущего режима
  mouse.UseDefaultGraphic();
}

function handle_inventory_click(MouseButton button)
{
  // Получаем предмет, на который кликнули
  InventoryItem* item = inventory[game.inv_activated];
  
  if (button == eMouseLeftInv)
  {
    if (mouse.Mode == eModeInspect)
    {
      itemToExamine = item;

      // Настраиваем высоту контекстного меню
      if (item.ID == iChocolate.ID ||
          item.ID == iChewing_gum.ID ||
          item.ID == iVodka.ID ||
          item.ID == iMilk.ID)
      {
          BtnEat.Visible = true;
          gContext.Height = 150;
      }
      else
      {
          BtnEat.Visible = false;
          gContext.Height = 100;
      }

        // Определяем положение контекстного меню
        int contextX = mouse.x;
        int contextY = mouse.y;

        // Проверяем правую границу экрана
        if (contextX + gContext.Width > Screen.Width)
        {
            contextX = Screen.Width - gContext.Width;
        }

        // Проверяем нижнюю границу экрана
        if (contextY + gContext.Height > Screen.Height)
        {
            contextY = Screen.Height - gContext.Height;
        }

        // Не позволяем меню выйти за левую или верхнюю границу
        if (contextX < 0)
        {
            contextX = 0;
        }

        if (contextY < 0)
        {
            contextY = 0;
        }

        // Устанавливаем положение меню
        gContext.SetPosition(contextX, contextY);
        gContext.Visible = true;
    }
    else if (mouse.Mode == eModeUseinv)
    {
      // Если предмет в руке НЕ совпадает с тем, на который кликнули - применяем
      if (item.ID != player.ActiveInventory.ID)
      {
        item.RunInteraction(eModeUseinv); 
      }
      else 
      {
        // ИСПРАВЛЕНИЕ: Кликнули предметом по самому себе — убираем предмет из рук
        player.ActiveInventory = null;
        mouse.Mode = eModeInspect; 
      }
    }
    else
    {
      item.RunInteraction(mouse.Mode); 
    }
  }
  else
  {
    // ИСПРАВЛЕНИЕ ДЛЯ ПРАВОГО КЛИКА В ИНВЕНТАРЕ
    if (player.ActiveInventory != null) 
    {
      // Если что-то держим в руках - сбрасываем
      player.ActiveInventory = null;
      mouse.Mode = eModeInspect;
    }
    else 
    {
      // Если руки пусты - осматриваем предмет
      item.RunInteraction(eModeLookat);
    }
  }
}




// called when a mouse button is clicked
function on_mouse_click(MouseButton button)
{
  if (button == eMouseLeftInv || button == eMouseRightInv || button == eMouseMiddleInv)
  {
    handle_inventory_click(button);
  }
  // game is paused, then don't process mouse clicks inside the room
  else if (!IsGamePaused())
  {
    handle_room_click(button);
  }
}

// Постепенное затемнение комнаты
int dimmerValue = 100;
bool isDimming = false;
bool isLighter = false;

function start_diming()
{
  gDarkOverlay.Visible = true;
  gDarkOverlay.Transparency = 100;
  dimmerValue = 100;
  isDimming = true;
  isLighter = false;
}

function start_lighter()
{
  gDarkOverlay.Visible = true;
  dimmerValue = 25;
  isLighter = true;
  isDimming = false;
}

function stop_diming()
{
      gDarkOverlay.Visible = false;
}

function repeat_diming()
{
  if (isDimming)
  {
    if (dimmerValue > 25)
    {
      dimmerValue -= 1;
      gDarkOverlay.Transparency = dimmerValue;
    }
    else
    {
      isDimming = false;
    }
  }
  else if (isLighter)
  {
    if (dimmerValue < 100)
    {
      dimmerValue += 1;
      gDarkOverlay.Transparency = dimmerValue;
    }
    else
    {
      isLighter = false;
      gDarkOverlay.Visible = false;
    }
  }
}


function SaveAndClearEpisode1Inventory()
{
  // 1. Запоминаем наличие нужных предметов

  ep1KeepDino = player.HasInventory(iDino);
  ep1KeepCigarettes = player.HasInventory(iCigarettes);
  ep1KeepVodka = player.HasInventory(iVodka);
  ep1KeepChocolate = player.HasInventory(iChocolate);
  ep1KeepStarSalve = player.HasInventory(iStar_salve);
  ep1KeepMusicPlayer = player.HasInventory(iMusic_player);

  // Снимок инвентаря готов
  ep1InventorySnapshotReady = true;


  // 2. Очищаем инвентарь первого эпизода

  if (player.HasInventory(iDino))
    player.LoseInventory(iDino);

  if (player.HasInventory(iCigarettes))
    player.LoseInventory(iCigarettes);

  if (player.HasInventory(iCoffee))
    player.LoseInventory(iCoffee);

  if (player.HasInventory(iVodka))
    player.LoseInventory(iVodka);

  if (player.HasInventory(iSugar))
    player.LoseInventory(iSugar);

  if (player.HasInventory(iKey_storeroom))
    player.LoseInventory(iKey_storeroom);

  if (player.HasInventory(iMilk))
    player.LoseInventory(iMilk);

  if (player.HasInventory(iChocolate))
    player.LoseInventory(iChocolate);

  if (player.HasInventory(iCup))
    player.LoseInventory(iCup);

  if (player.HasInventory(iBook))
    player.LoseInventory(iBook);

  if (player.HasInventory(iBarrete))
    player.LoseInventory(iBarrete);

  if (player.HasInventory(iBarrete2))
    player.LoseInventory(iBarrete2);

  if (player.HasInventory(iStar_salve))
    player.LoseInventory(iStar_salve);

  if (player.HasInventory(iMusic_player))
    player.LoseInventory(iMusic_player);


  // 3. Сбрасываем активный предмет и интерфейс

  player.ActiveInventory = null;
  mouse.Mode = eModeWalkto;

  gContext.Visible = false;
  gInventory_menu.Visible = false;
}


function RestoreEpisode1Inventory()
{
  // Если сохранение не проводилось, ничего не делаем
  if (ep1InventorySnapshotReady == false)
    return;


  // Возвращаем только те предметы, которые были у игрока

  if (ep1KeepDino && !player.HasInventory(iDino))
    player.AddInventory(iDino);

  if (ep1KeepCigarettes && !player.HasInventory(iCigarettes))
    player.AddInventory(iCigarettes);

  if (ep1KeepVodka && !player.HasInventory(iVodka))
    player.AddInventory(iVodka);

  if (ep1KeepChocolate && !player.HasInventory(iChocolate))
    player.AddInventory(iChocolate);

  if (ep1KeepStarSalve && !player.HasInventory(iStar_salve))
    player.AddInventory(iStar_salve);

  if (ep1KeepMusicPlayer && !player.HasInventory(iMusic_player))
    player.AddInventory(iMusic_player);


  // Сбрасываем снимок, чтобы его нельзя было применить повторно

  ep1KeepDino = false;
  ep1KeepCigarettes = false;
  ep1KeepVodka = false;
  ep1KeepChocolate = false;
  ep1KeepStarSalve = false;
  ep1KeepMusicPlayer = false;

  ep1InventorySnapshotReady = false;
}

 // Конец блока

//=============================================================================
// GAME EVENTS
//=============================================================================

// called on every game cycle, except when the game is blocked
function repeatedly_execute() 
{
    // В главном меню движение не обрабатывается
  if (player.Room == 99)
  {
    playerDirection = 0;
    return;
  }

  if (!IsInterfaceEnabled() || IsGamePaused()) return;
  // --- 1. ОБРАБОТКА ДВИЖЕНИЯ (Клавиши A/D) ---
  int newDir = 0;
  if (IsKeyPressed(eKeyD)) newDir = 1;
  else if (IsKeyPressed(eKeyA)) newDir = 2;
  
  if (newDir != playerDirection)
  {
    playerDirection = newDir;
    if (playerDirection == 1) cEgo.Walk(cEgo.x + 2000, cEgo.y, eNoBlock, eWalkableAreas);
    else if (playerDirection == 2) cEgo.Walk(cEgo.x - 2000, cEgo.y, eNoBlock, eWalkableAreas);
    else cEgo.StopMoving();
  }

  // --- 2. УМНЫЙ КУРСОР (Логика наведения) ---
  InventoryItem *item = InventoryItem.GetAtScreenXY(mouse.x, mouse.y);
  LocationType locType = GetLocationType(mouse.x, mouse.y);
  bool showApproachCursor = false;

  // Сначала проверяем предметы инвентаря
  if (item != null)
  {
    if (player.ActiveInventory != null)
    {
      if (mouse.Mode != eModeUseinv)
        mouse.Mode = eModeUseinv;
    }
    else if (mouse.Mode != eModeInspect)
    {
      mouse.Mode = eModeInspect;
    }
  }

  // Потом проверяем персонажей
  else if (locType == eLocationCharacter)
  {
    Character *charUnderMouse = Character.GetAtScreenXY(mouse.x, mouse.y);

    if (charUnderMouse != null && charUnderMouse != player)
    {
      if (player.ActiveInventory != null)
      {
        if (mouse.Mode != eModeUseinv)
          mouse.Mode = eModeUseinv;
      }
      else if (mouse.Mode != eModeTalkto)
      {
        mouse.Mode = eModeTalkto;
      }
    }
    else
    {
      if (player.ActiveInventory != null)
      {
        if (mouse.Mode != eModeUseinv)
          mouse.Mode = eModeUseinv;
      }
      else if (mouse.Mode == eModeInspect ||
               mouse.Mode == eModeInteract ||
               mouse.Mode == eModeTalkto)
      {
        mouse.Mode = eModeWalkto;
      }
    }
  }

  // Затем проверяем хотспоты и объекты
  else if (locType == eLocationHotspot || locType == eLocationObject)
  {
    int reqRegion = 0;

    if (locType == eLocationHotspot)
    {
      Hotspot *hot = Hotspot.GetAtScreenXY(mouse.x, mouse.y);
      reqRegion = hot.GetProperty("RequiredRegion");
    }
    else if (locType == eLocationObject)
    {
      Object *obj = Object.GetAtScreenXY(mouse.x, mouse.y);
      reqRegion = obj.GetProperty("RequiredRegion");
    }

    Region *playerRegion = Region.GetAtRoomXY(player.x, player.y);

    // Проверяем, находится ли игрок в нужном регионе
    bool canInteract = (reqRegion > 0 && reqRegion == playerRegion.ID);

    if (player.ActiveInventory != null)
    {
      // Предмет можно применить только из нужного региона
      if (canInteract)
      {
        if (mouse.Mode != eModeUseinv)
          mouse.Mode = eModeUseinv;
      }
      else
      {
        // Игрок далеко — нужно подойти ближе
        showApproachCursor = true;

        if (mouse.Mode != eModeWalkto)
            mouse.Mode = eModeWalkto;
      }
    }
    else
    {
      // Обычное взаимодействие без предмета
      if (canInteract)
      {
        if (mouse.Mode != eModeInteract)
          mouse.Mode = eModeInteract;
      }
      else
      {
        if (mouse.Mode == eModeInteract ||
            mouse.Mode == eModeInspect ||
            mouse.Mode == eModeTalkto)
        {
          mouse.Mode = eModeWalkto;
        }
      }
    }
  }

  // Мышка на пустом фоне
  else
  {
    if (player.ActiveInventory != null)
    {
      if (mouse.Mode != eModeUseinv)
        mouse.Mode = eModeUseinv;
    }
    else if (mouse.Mode == eModeInspect ||
             mouse.Mode == eModeInteract ||
             mouse.Mode == eModeTalkto)
    {
      mouse.Mode = eModeWalkto;
    }
  }
  
    // --- КУРСОР «НУЖНО ПОДОЙТИ БЛИЖЕ» ---

  if (showApproachCursor)
  {
      mouse.UseModeGraphic(eModeUsermode1);
      approachCursorShown = true;
  }
  else if (approachCursorShown)
  {
      // Если режим уже сменился, движок сам установил
      // стандартную графику нового режима.
      // Если остался WalkTo — восстанавливаем её вручную.
      if (mouse.Mode == eModeWalkto)
          mouse.UseDefaultGraphic();

      approachCursorShown = false;
  }
  
}

// Анимация катсцены на вечернем балконе
function reset_evening_balcony_animation()
{
    eveningBalconyTimer = 0;
    eveningBalconyFrame = 0;
}

// Анимация катсцены на вечернем балконе
function update_evening_balcony_animation()
{
    // Анимация работает исключительно на вечернем балконе
    if (player.Room != 34)
        return;

    eveningBalconyTimer++;

    int currentDelay = 25;

    // Третий кадр задерживается дольше остальных
    if (eveningBalconyFrame == 2)
    {
        currentDelay = 60;
    }

    if (eveningBalconyTimer >= currentDelay)
    {
        eveningBalconyTimer = 0;

        eveningBalconyFrame++;

        if (eveningBalconyFrame >= 5)
        {
            eveningBalconyFrame = 0;
        }

        SetBackgroundFrame(eveningBalconyFrame);
    }
}

// called on every game cycle, even when the game is blocked
function repeatedly_execute_always()
{
    repeat_diming();
    
    update_evening_balcony_animation();
    // Ручное отображение настроения по пробелу
    if (moodPanelToggled || moodPanelForced)
    {
        gMoodPanel.Visible = true;
        
        // Плавно проявляем панель при зажатой Z
        if (gMoodPanel.Transparency > 0)
        {
            int newTrans = gMoodPanel.Transparency - 10; // Скорость появления при нажатии
            if (newTrans < 0) newTrans = 0;
            gMoodPanel.Transparency = newTrans;
        }
    }
    else
    {
        // --- СТАНДАРТНАЯ АНИМАЦИЯ (когда Z не зажата) ---
        if (moodFadeState == 1) // Фаза 1: Плавное появление (от ChangeMood)
        {
            int newTrans = gMoodPanel.Transparency - 2;
            if (newTrans <= 0)
            {
                gMoodPanel.Transparency = 0;
                moodFadeState = 2; // Переходим к удержанию
            }
            else
            {
                gMoodPanel.Transparency = newTrans;
            }
        }
        else if (moodFadeState == 2) // Фаза 2: Удержание на экране (от ChangeMood)
        {
            if (moodTimer > 0)
            {
                moodTimer--;
            }
            else
            {
                moodFadeState = 3; // Время вышло, начинаем исчезать
            }
        }
        else if (moodFadeState == 3) // Фаза 3: Плавное исчезновение (от ChangeMood)
        {
            int newTrans = gMoodPanel.Transparency + 2;
            if (newTrans >= 100)
            {
                gMoodPanel.Transparency = 100;
                gMoodPanel.Visible = false; // Скрываем GUI
                lblMoodStatus.Text = "";    // Очищаем текст
                moodFadeState = 0;          // Состояние "Скрыта"
            }
            else
            {
                gMoodPanel.Transparency = newTrans;
            }
        }
        else if (moodFadeState == 0 && gMoodPanel.Visible)
        {
            // Если игрок только что отпустил Z, а ChangeMood не активен — плавно убираем панель
            int newTrans = gMoodPanel.Transparency + 10; // Скорость исчезновения после отпускания Z
            if (newTrans >= 100)
            {
                gMoodPanel.Transparency = 100;
                gMoodPanel.Visible = false;
                lblMoodStatus.Text = "";
            }
            else
            {
                gMoodPanel.Transparency = newTrans;
            }
        }
    }
// Плавное возвращение экрана в норму после стресса
// Плавное возвращение экрана в норму после стресса
  if (stressFlash == 1) 
  {
      // Сначала удерживаем затемнение
      if (stressFlashHoldTimer > 0)
      {
          stressFlashHoldTimer--;
      }
      // Затем постепенно возвращаем изображение
      else if (gDarkOverlay.Transparency < 100) 
      {
          int newTransparency = gDarkOverlay.Transparency + 1;

          if (newTransparency >= 100)
          {
              gDarkOverlay.Transparency = 100;
          }
          else
          {
              gDarkOverlay.Transparency = newTransparency;
          }
      } 
      else 
      {
          // Затемнение полностью исчезло
          gDarkOverlay.Visible = false;
          stressFlash = 0;
      }
  }
}

// Called when a dialog script line "run-script" is processed
function dialog_request(int param)
{
  // Если пришел сигнал №1 из диалога
  if (param == 1) 
  {
    Button3.Visible = false; // Прячем кнопку
  }
}

// Обработка взаимодействий, для которых нет собственного обработчика
function unhandled_event(int what, int type)
{
  // type == 3 — использование предмета инвентаря на цели
  if (type == 3)
  {
    // 1 — хотспот
    // 2 — объект
    // 3 — персонаж
    // 5 — другой предмет инвентаря
    if (what == 1 || what == 2 || what == 3 || what == 5)
    {
      TypeText("Ума не приложу, что с этим делать.");
    }
  }
}

