// Выбираем одну из четырёх карточек
function SelectSaveSlot(int cardIndex)
{
  // Сбрасываем предыдущий выбор
  CancelSaveNameInput();

  // Запоминаем индекс карточки
  selectedSaveCard = cardIndex;

  // Вычисляем настоящий номер сохранения
  selectedSaveSlot = currentSavePage * 4 + cardIndex + 1;

  // Получаем название существующего сохранения
  String previousName = Game.GetSaveSlotDescription(selectedSaveSlot);

  // Скрываем подпись и показываем поле ввода
  saveSlotLabels[cardIndex].Visible = false;
  saveSlotInputs[cardIndex].Visible = true;

  // Подставляем прежнее название
  if (String.IsNullOrEmpty(previousName))
  {
    saveSlotInputs[cardIndex].Text = "";
  }
  else
  {
    saveSlotInputs[cardIndex].Text = previousName;
  }
}

// Универсальный обработчик кнопок сохранения
function SaveSlot_OnClick(GUIControl *control, MouseButton button)
{
  for (int i = 0; i < 4; i++)
  {
    if (control == saveSlotButtons[i])
    {
      SelectSaveSlot(i);
      return;
    }
  }
}

// Завершаем сохранение после всех проверок
function FinishSaveSlot(int slotToSave, String saveName, int cardIndex)
{
  // Обновляем название карточки
  saveSlotLabels[cardIndex].Text = saveName;
  saveSlotLabels[cardIndex].Visible = true;
  saveSlotInputs[cardIndex].Visible = false;
  saveSlotInputs[cardIndex].Text = "";
  gSave_game.Clickable = true;
  // Закрываем окна
  gDeleteSaveConfirm.Visible = false;
  gSave_game.Visible = false;
  gMenu_ingame.Visible = false;
  gDarkOverlay.Visible = false;

  // Возобновляем игру
  UnPauseGame();
  mouse.Mode = eModeWalkto;

  // Сбрасываем выбор
  selectedSaveCard = -1;
  selectedSaveSlot = -1;

  // Записываем сохранение
  SaveGameSlot(slotToSave, saveName);
}

function SaveCurrentSlot()
{
  // Проверяем, выбрана ли карточка
  if (selectedSaveCard < 0 || selectedSaveCard >= 4)
  {
    TypeText("Сначала выберите ячейку для сохранения.");
    return;
  }

  // Получаем название
  String saveName = saveSlotInputs[selectedSaveCard].Text;

  if (String.IsNullOrEmpty(saveName))
  {
    TypeText("Введите название сохранения.");
    return;
  }

  int slotToSave = selectedSaveSlot;
  int cardIndex = selectedSaveCard;

  // Проверяем, существует ли сохранение в этой ячейке
  String previousName = Game.GetSaveSlotDescription(slotToSave);

  // Если ячейка уже занята — спрашиваем разрешение
  if (!String.IsNullOrEmpty(previousName))
  {
    pendingOverwriteSaveSlot = slotToSave;
    pendingOverwriteSaveCard = cardIndex;
    pendingOverwriteSaveName = saveName;

    saveConfirmAction = 2;

    lbl_del_verification.Text = "Перезаписать выбранное сохранение?";

    // Временно блокируем окно сохранений
    saveSlotInputs[cardIndex].Visible = false;
    gSave_game.Clickable = false;
    gDeleteSaveConfirm.Visible = true;
    return;
  }

  // Если ячейка пустая — сохраняем сразу
  FinishSaveSlot(slotToSave, saveName, cardIndex);
}

// Сохранение через кнопку GUI
function btn_saveg_OnClick(GUIControl *control, MouseButton button)
{
  aClick.Play();
  SaveCurrentSlot();
}

function cBum_Talk(Character *theCharacter, CursorMode mode)
{
  if (BumMeeting == 1)
  {
    // Если Антон ранее дал сигарету —
    // снова усаживаем его на ступеньки.
    if (dBum.HasOptionBeenChosen(2))
    {
      FadeOut(2);

      cEgo.StopMoving();
      cEgo.x = 1270;
      cEgo.y = 925;
      cEgo.LockView(ILYA_ON_STAIRS);

      FadeIn(2);
    }

    // Запускаем диалог.
    dBum.Start();
  }
  else if (BumMeeting == 2)
  {
    TypeText("Из-под глубокого капюшона слышно размеренное дыхание. Кажется, бомж задремал. Лучше его не тревожить.");
  }
  else
  {
    TypeText("На лестнице сидит человек в засаленной и грязной одежде. Он не обращает на вас внимания.");
  }
}


function BtnEat_OnClick(GUIControl *control, MouseButton button)
{
    gContext.Visible = false;

    if (itemToExamine == null)
        return;

    // Шоколад
    if (itemToExamine == iChocolate)
    {
      FadeOut(4);
      aEating.Play();
      Wait(40);
      player.LoseInventory(iChocolate);
      FadeIn(4);
      ChangeMood(1);
      TypeText("Всего лишь шоколад, но настроение немного улучшилось.");
    }

    // Жевательная резинка
    else if (itemToExamine == iChewing_gum)
    {
      FadeOut(4);
      aEating.Play();
      Wait(40);
      player.LoseInventory(iChewing_gum);
      FadeIn(4);
      ChangeMood(1);
      TypeText("Мятная жвачка. Мелочь, а приятно.");
    }

    else if (itemToExamine == iVodka) 
    {
      if (Game.DoOnceOnly("first_vodka_drink")) 
        {
            // Этот блок сработает только один раз
            TypeText("Если честно, выпить сейчас бы не помешало.");
            int currentLoop = cEgo.Loop; 
            
            // 2. Блокируем View 15 (в комментарии у тебя указано 4, но вызывается 15)
            cEgo.LockView(15); 
                  
            // 3. Проигрываем анимацию в зависимости от направления.
            cEgo.Animate(currentLoop, 5, eOnce, eBlock); 
            
            cEgo.UnlockView();
            
            TypeText("Тело реагирует быстрее, чем мозг, давая понять, что это была крайне плохая идея.");
            TypeText("Вкусовые рецепторы взрываются от смеси чего-то, напоминающего стеклоочиститель пополам с кислотой, и вас едва не выворачивает наизнанку.");
            TypeText("Вы сплевываете, откашливаетесь и решаете, что все же недостаточно опустились до того, чтобы это пить.");
            TypeText("(Но еще не вечер, как говорится).");
        }
        else 
        {
            // Этот блок будет срабатывать при всех повторных попытках выпить
            TypeText("Эту штуку нужно запретить Женевской Конвенцией."); 
        }
    }
      else if (itemToExamine == iMilk) 
      {
      if (Game.DoOnceOnly("first_milk_drink")) 
        {
            // Этот блок сработает только один раз
            int currentLoop = cEgo.Loop; 
            
            // 2. Блокируем View 15 (в комментарии у тебя указано 4, но вызывается 15)
            cEgo.LockView(16); 
                  
            // 3. Проигрываем анимацию в зависимости от направления.
            cEgo.Animate(currentLoop, 5, eOnce, eBlock); 
            
            cEgo.UnlockView();
            
            TypeText("Вы замираете на секунду и тут же сплевываете несколько раз, пытаясь избавиться от липкого вкуса плесени.");
            TypeText("Оно прокисло. Надо было хотя бы глянуть срок годности. Или положить молоко в холодильник несколько дней назад.");
            TypeText("Почему такие вещи всегда происходят именно со мной?");
            TypeText("Мелочь, однако настроение безнадежно испорчено.");
            ChangeMood(-1);
        }
        else 
        {
            // Этот блок будет срабатывать при всех повторных попытках выпить
            TypeText("Это пакет прокисшего молоко. Со вкусом грибка, соскобленного с подвальной стены. Что с ним можно сделать?"); 
        }
      } 

    itemToExamine = null;
}


function gInventory_menu_OnClick(GUI *theGui, MouseButton button)
{
  gContext.Visible = false;
  itemToExamine = null;
}



function txtSaveName1_OnActivate(GUIControl *control)
{
  SaveCurrentSlot();
}

// Переход на предыдущую страницу
function btn_saveLeft_OnClick(GUIControl *control, MouseButton button)
{
  aClick.Play();
  // Если мы уже на первой странице — ничего не делаем
  if (currentSavePage <= 0)
    return;

  // Отменяем незавершённый ввод
  CancelSaveNameInput();

  // Переходим назад
  currentSavePage--;

  // Обновляем карточки и индикатор
  RefreshSavePage();
  RefreshSavePageIndicator();
}

// Переход на следующую страницу
function btn_saveRight_OnClick(GUIControl *control, MouseButton button)
{
  aClick.Play();
  // Если мы уже на пятой странице — ничего не делаем
  if (currentSavePage >= 4)
    return;

  // Отменяем незавершённый ввод
  CancelSaveNameInput();

  // Переходим вперёд
  currentSavePage++;

  // Обновляем карточки и индикатор
  RefreshSavePage();
  RefreshSavePageIndicator();
}

function btn_save_del_OnClick(GUIControl *control, MouseButton button)
{
  aClick.Play();

  // Сначала проверяем, выбрана ли карточка
  if (selectedSaveCard < 0 ||
      selectedSaveCard >= 4 ||
      selectedSaveSlot < 1)
  {
    TypeText("Сначала выберите сохранение, которое хотите удалить.");
    return;
  }

  // Получаем название сохранения
  String saveDescription = Game.GetSaveSlotDescription(selectedSaveSlot);

  // Проверяем, не пуста ли ячейка
  if (String.IsNullOrEmpty(saveDescription))
  {
    TypeText("Эта ячейка уже пуста.");
    return;
  }

  // Только теперь блокируем окно сохранений
  saveSlotInputs[selectedSaveCard].Visible = false;
  gSave_game.Clickable = false;

  // Запоминаем слот
  pendingDeleteSaveSlot = selectedSaveSlot;
  saveConfirmAction = 1;

  // Показываем вопрос
  lbl_del_verification.Text = String.Format(
    "Удалить сохранение:\n%s?",
    saveDescription
  );

  gDeleteSaveConfirm.Visible = true;
}

// Подтверждение удаления
function btnDeleteSaveConfirm_OnClick(GUIControl *control, MouseButton button)
{
  aClick.Play();

  // =================================
  // УДАЛЕНИЕ СОХРАНЕНИЯ
  // =================================

  if (saveConfirmAction == 1)
  {
    if (pendingDeleteSaveSlot < 1)
      return;

    DeleteSaveSlot(pendingDeleteSaveSlot);

    pendingDeleteSaveSlot = -1;
    saveConfirmAction = 0;

    gDeleteSaveConfirm.Visible = false;
    gSave_game.Clickable = true;
    // Сбрасываем выбранную карточку
    CancelSaveNameInput();

    // Обновляем страницу
    RefreshSavePage();
    RefreshSavePageIndicator();
    gSave_game.Clickable = true;
    return;
  }

  // =================================
  // ПЕРЕЗАПИСЬ СОХРАНЕНИЯ
  // =================================

  if (saveConfirmAction == 2)
  {
    if (pendingOverwriteSaveSlot < 1 ||
        pendingOverwriteSaveCard < 0 ||
        pendingOverwriteSaveCard >= 4)
      return;

    int slot = pendingOverwriteSaveSlot;
    int card = pendingOverwriteSaveCard;
    String name = pendingOverwriteSaveName;

    // Сбрасываем ожидающие данные
    pendingOverwriteSaveSlot = -1;
    pendingOverwriteSaveCard = -1;
    pendingOverwriteSaveName = "";
    saveConfirmAction = 0;

    // Выполняем перезапись
    FinishSaveSlot(slot, name, card);
    gSave_game.Clickable = true;
    return;
  }
}

// Отмена удаления
function btnDeleteSaveCancel_OnClick(GUIControl *control, MouseButton button)
{
  aClick.Play();

  // Закрываем подтверждение
  gDeleteSaveConfirm.Visible = false;
  // Возвращаем доступ к окну сохранений
  gSave_game.Clickable = true;

  // Возвращаем поле ввода выбранной карточки
  if (selectedSaveCard >= 0 && selectedSaveCard < 4)
  {
    saveSlotInputs[selectedSaveCard].Visible = true;
  }
  // Сбрасываем ожидающие операции
  pendingDeleteSaveSlot = -1;
  pendingOverwriteSaveSlot = -1;
  pendingOverwriteSaveCard = -1;
  pendingOverwriteSaveName = "";

  saveConfirmAction = 0;

  // Не сбрасываем выбранную карточку!
  // Игрок может продолжить редактирование.
}


