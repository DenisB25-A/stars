// Скрипты отрисовки диалогов

int dlg_opt_color = 0;
int dlg_opt_acolor = 4;
int dlg_opt_ncolor = 15;
#define DLG_GAP 15  // Расстояние между вариантами в пикселях. Можешь менять это число.

function dialog_options_get_dimensions(DialogOptionsRenderingInfo *info)
{
    // Скрипт сам подсмотрит координаты и размеры твоего GUI
    info.X = gDialogMenu.X;
    info.Y = gDialogMenu.Y;
    info.Width = gDialogMenu.Width;
    info.Height = gDialogMenu.Height;
    
    // Включаем альфа-канал для прозрачности
    info.HasAlphaChannel = true; 
}

function dialog_options_render(DialogOptionsRenderingInfo *info)
{
    info.Surface.Clear(0); 
    info.Surface.DrawImage(0, 0, gDialogMenu.BackgroundGraphic);

    int ypos = 20; // Стартовый отступ сверху
    
    for (int i = 1; i <= info.DialogToRender.OptionCount; i++)
    {
        if (info.DialogToRender.GetOptionState(i) == eOptionOn)
        {
            if (info.ActiveOptionID == i) info.Surface.DrawingColor = dlg_opt_acolor;
            else info.Surface.DrawingColor = dlg_opt_ncolor;

            info.Surface.DrawStringWrapped(200, ypos, info.Width - 100, eFontFont5, eAlignLeft, info.DialogToRender.GetOptionText(i));
            
            // К высоте текста прибавляем наш разрыв DLG_GAP
            ypos += GetTextHeight(info.DialogToRender.GetOptionText(i), eFontFont5, info.Width - 100) + DLG_GAP;
        }
    }
}

function dialog_options_repexec(DialogOptionsRenderingInfo *info)
{
    info.ActiveOptionID = 0;
    
    if (mouse.y < info.Y || mouse.y >= info.Y + info.Height ||
        mouse.x < info.X || mouse.x >= info.X + info.Width)
    {
        return; 
    }

    int ypos = 20; // ОБЯЗАТЕЛЬНО: такой же стартовый отступ, как в render!
    
    for (int i = 1; i <= info.DialogToRender.OptionCount; i++)
    {
        if (info.DialogToRender.GetOptionState(i) == eOptionOn)
        {
            // Считаем ту же высоту с тем же разрывом
            ypos += GetTextHeight(info.DialogToRender.GetOptionText(i), eFontFont5, info.Width - 100) + DLG_GAP;
            
            if ((mouse.y - info.Y) < ypos)
            {
                info.ActiveOptionID = i;
                return;
            }
        }
    }
}

function dialog_options_mouse_click(DialogOptionsRenderingInfo *info, MouseButton button)
{
    if (info.ActiveOptionID > 0)
        info.RunActiveOption();
}


