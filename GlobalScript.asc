//=============================================================================
// PLAYER INPUT
//=============================================================================



// called when a key is pressed
function on_key_press(eKeyCode keycode, int mod)
{
  // check for Escape first, so it can be used on GUIs that pause the game
  if (keycode == eKeyEscape)
  {
  // 1. СНАЧАЛА ЗАКРЫВАЕМ КАСТОМНЫЕ ИНТЕРФЕЙСЫ (если они открыты)
      if (gInventory_menu.Visible) 
      {
        gInventory_menu.Visible = false;
        mouse.Mode = eModeWalkto; // Возвращаем обычный курсор для ходьбы
      }
      else if (gJournal.Visible) gJournal.Visible = false;
      else if (gViewer.Visible) gViewer.Visible = false;
      else if (gEmailReader.Visible) gEmailReader.Visible = false;
      else if (gContext.Visible) gContext.Visible = false;
      
      // 2. ОТКРЫТИЕ И ЗАКРЫТИЕ НАШЕГО КАСТОМНОГО МЕНЮ (gMenu_ingame)
      else if (gMenu_ingame.Visible)
      {
        // Если меню уже открыто — закрываем его
        gMenu_ingame.Visible = false;
        gDarkOverlay.Visible = false; // Убираем затемнение экрана
        UnPauseGame(); // Разблокируем управление и снимаем игру с паузы
        mouse.Mode = eModeWalkto;
      }
      else
      {
        // Если на экране нет никаких окон — открываем главное меню
        PauseGame(); // Блокируем управление и ставим всё на паузу
        gDarkOverlay.Visible = true; // Включаем затемнение
        gMenu_ingame.Visible = true; // Показываем само меню
        mouse.Mode = eModePointer;
      }
      
  }

  else if (IsGamePaused() || !IsInterfaceEnabled())
  {
    // game paused, so don't react to any keypresses
    keycode = 0;
  }
  else if (keycode == eKeyQ && (mod & eKeyModCtrl))
  {
    // Ctrl-Q will quit the game
    open_gui(gExitGame);
  }
  else if (keycode == eKeyF5)
  {
    // F5 will prompt to save a game
    show_save_game_dialog();
  }
  else if (keycode == eKeyF7)
  {
    // F7 will prompt to save a game
    show_restore_game_dialog();
  }
  else if (keycode == eKeyF9)
  {
    // F9 will prompt to restart the game
    open_gui(gRestart);
  }
  else if (keycode == eKeyF12)
  {
    // F12 will save a screenshot to the save game folder
    SaveScreenShot("screenshot.pcx");
  }
  else if (keycode == eKeyReturn)
  {
    if (gRestart.Visible)
    {
      // Enter confirms a restart
      RestartGame();
    }
  }
  else if (keycode == eKeyTab)
  {
    // Tab opens the inventory
    show_inventory_window();
  }
  else if (mod & eKeyModCtrl)
  {
    if (keycode == eKeyS)
    {
      // Ctrl-S will give the player all defined inventory items
      Debug(0, 0);
    }
    else if (keycode == eKeyV)
    {
      // Ctrl-V will show game engine version and build date
      Debug(1, 0);
    }
    else if (keycode == eKeyA)
    {
      // Ctrl-A will show walkable areas
      Debug(2, 3);
    }
    else if (keycode == eKeyX)
    {
      // Ctrl-X will let the player teleport to any room
      Debug(3, 0);
    }
  }
  // Показывать / Скрывать инвентарь
  if (keycode == eKeyQ) 
  {
    if (!gInventory_menu.Visible) {
      gInventory_menu.Visible = true;
      mouse.Mode = eModeInteract; 
    }
    else {
      gInventory_menu.Visible = false;
      // Возвращаем обычный курсор, если нужно
      mouse.Mode = eModeWalkto; 
    }
  }
  //Видимость Журнала
  if (keycode == eKeyJ) // Если нажата клавиша J
  {
    if (gJournal.Visible == false) // Журнал закрыт?
    {
      
      UpdateJournalUI();       // Обновляем список записок перед показом
      gJournal.Visible = true; 
      mouse.Visible = true;    // Включаем курсор, чтобы кликать по списку
    }
    else // Журнал уже был открыт?
    {
      gJournal.Visible = false;
      //gNoteView.Visible = false; // Не забываем спрятать саму записку
      // Если у тебя horror-режим без курсора, здесь можно его снова спрятать:
      // mouse.Visible = false; 
    }
  }
}

function handle_room_click(MouseButton button)
{
  if (button == eMouseLeft)
  {
    Room.ProcessClick(mouse.x, mouse.y, mouse.Mode );
  }
  else if (button == eMouseRight || button == eMouseWheelSouth)
  {
    // ИСПРАВЛЕНИЕ: Если держим предмет - правый клик его сбрасывает
    if (player.ActiveInventory != null) 
    {
      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto; // Возвращаем обычный курсор-шаги
    }
    else 
    {
      // Если предмет не держим - просто переключаем режимы как раньше
      mouse.SelectNextMode();
    }
  }
  else if (button == eMouseMiddle)
  {
    Room.ProcessClick(mouse.x, mouse.y, eModeWalkto);
  }
  else if (button == eMouseWheelNorth)
  {
    mouse.SelectPreviousMode();
  }
  
  if (gContext.Visible) 
  {
    gContext.Visible = false;
    return; 
  }
}

// Скрипт: взаимодействие - мысли

function TypeText(String message)
{
  if (message.Chars[0] == '>') 
  {
    lblGameText.TextColor = 2; // Твой зеленый цвет
    
    // Исправлено: Substring с маленькой 's'
    lblGameText.Text = message.Substring(1, message.Length - 1); 
  }
  else if (message.Chars[0] == '<') 
  {
    lblGameText.TextColor = 4; 
    
    // Исправлено: Substring с маленькой 's'
    lblGameText.Text = message.Substring(1, message.Length - 1); 
  }
  else
  {
    lblGameText.TextColor = 65535; // Твой стандартный цвет (например, белый)
    lblGameText.Text = message;    
  }

  gTextBar.Visible = true;    
  WaitMouseKey(500);
  // --- ВОТ ЭТА СТРОЧКА ---
  // Ждем, пока игрок физически ОТПУСТИТ левую кнопку мыши, 
  // прежде чем убрать текстовую плашку и вернуть управление игре.
  while (Mouse.IsButtonDown(eMouseLeft)) Wait(1);
  gTextBar.Visible = false;   
}

function handle_inventory_click(MouseButton button)
{
  // Получаем предмет, на который кликнули
  InventoryItem* item = inventory[game.inv_activated];
  
  if (button == eMouseLeftInv)
  {
    if (mouse.Mode == eModeInspect) 
    {
      itemToExamine = item;
      gContext.SetPosition(mouse.x, mouse.y);
      gContext.Visible = true;
    }
    else if (mouse.Mode == eModeUseinv)
    {
      // Если предмет в руке НЕ совпадает с тем, на который кликнули - применяем
      if (item.ID != player.ActiveInventory.ID)
      {
        item.RunInteraction(eModeUseinv); 
      }
      else 
      {
        // ИСПРАВЛЕНИЕ: Кликнули предметом по самому себе — убираем предмет из рук
        player.ActiveInventory = null;
        mouse.Mode = eModeInspect; 
      }
    }
    else
    {
      item.RunInteraction(mouse.Mode); 
    }
  }
  else
  {
    // ИСПРАВЛЕНИЕ ДЛЯ ПРАВОГО КЛИКА В ИНВЕНТАРЕ
    if (player.ActiveInventory != null) 
    {
      // Если что-то держим в руках - сбрасываем
      player.ActiveInventory = null;
      mouse.Mode = eModeInspect;
    }
    else 
    {
      // Если руки пусты - осматриваем предмет
      item.RunInteraction(eModeLookat);
    }
  }
}




// called when a mouse button is clicked
function on_mouse_click(MouseButton button)
{
  if (button == eMouseLeftInv || button == eMouseRightInv || button == eMouseMiddleInv)
  {
    handle_inventory_click(button);
  }
  // game is paused, then don't process mouse clicks inside the room
  else if (!IsGamePaused())
  {
    handle_room_click(button);
  }
}

// Постепенное затемнение комнаты
int dimmerValue = 100;
bool isDimming = false;
bool isLighter = false;

function start_diming()
{
  gDarkOverlay.Visible = true;
  dimmerValue = 100;
  isDimming = true;
  isLighter = false;
}

function start_lighter()
{
  gDarkOverlay.Visible = true;
  dimmerValue = 25;
  isLighter = true;
  isDimming = false;
}

function stop_diming()
{
      gDarkOverlay.Visible = false;
}

function repeat_diming()
{
  if (isDimming)
  {
    if (dimmerValue > 25)
    {
      dimmerValue -= 1;
      gDarkOverlay.Transparency = dimmerValue;
    }
    else
    {
      isDimming = false;
    }
  }
  else if (isLighter)
  {
    if (dimmerValue < 100)
    {
      dimmerValue += 1;
      gDarkOverlay.Transparency = dimmerValue;
    }
    else
    {
      isLighter = false;
      gDarkOverlay.Visible = false;
    }
  }
}

 // Конец блока

//=============================================================================
// GAME EVENTS
//=============================================================================

// called on every game cycle, except when the game is blocked
function repeatedly_execute() 
{
  if (!IsInterfaceEnabled() || IsGamePaused()) return;
  // --- 1. ОБРАБОТКА ДВИЖЕНИЯ (Клавиши A/D) ---
  int newDir = 0;
  if (IsKeyPressed(eKeyD)) newDir = 1;
  else if (IsKeyPressed(eKeyA)) newDir = 2;
  
  if (newDir != playerDirection)
  {
    playerDirection = newDir;
    if (playerDirection == 1) cEgo.Walk(cEgo.x + 2000, cEgo.y, eNoBlock, eWalkableAreas);
    else if (playerDirection == 2) cEgo.Walk(cEgo.x - 2000, cEgo.y, eNoBlock, eWalkableAreas);
    else cEgo.StopMoving();
  }

  // --- 2. УМНЫЙ КУРСОР (Логика наведения) ---
  InventoryItem *item = InventoryItem.GetAtScreenXY(mouse.x, mouse.y);
  LocationType locType = GetLocationType(mouse.x, mouse.y);

  // Сначала проверяем предметы инвентаря
  if (item != null)
  {
    if (player.ActiveInventory == null && mouse.Mode != eModeInspect)
    {
      mouse.Mode = eModeInspect;
    }
  }
  // Потом проверяем персонажей (кроме Ильи)
  else if (locType == eLocationCharacter) 
  {
    Character *charUnderMouse = Character.GetAtScreenXY(mouse.x, mouse.y);
    if (charUnderMouse != null && charUnderMouse != player) 
    {
      if (player.ActiveInventory == null && mouse.Mode != eModeTalkto) 
      {
         mouse.Mode = eModeTalkto; 
      }
    }
    else 
    {
      if (player.ActiveInventory == null && (mouse.Mode == eModeInspect || mouse.Mode == eModeInteract || mouse.Mode == eModeTalkto)) 
      {
        mouse.Mode = eModeWalkto; 
      }
    }
  }
  // Затем проверяем хотспоты и объекты (логика регионов)
  else if (locType == eLocationHotspot || locType == eLocationObject)
  {
    int reqRegion = 0;
    if (locType == eLocationHotspot)
    {
        Hotspot *hot = Hotspot.GetAtScreenXY(mouse.x, mouse.y);
        reqRegion = hot.GetProperty("RequiredRegion");
    }
    else if (locType == eLocationObject)
    {
        Object *obj = Object.GetAtScreenXY(mouse.x, mouse.y);
        reqRegion = obj.GetProperty("RequiredRegion");
    }
    
    Region *playerRegion = Region.GetAtRoomXY(player.x, player.y);
    
    if (reqRegion > 0 && reqRegion == playerRegion.ID)
    {
      if (player.ActiveInventory == null && mouse.Mode != eModeInteract)
      {
         mouse.Mode = eModeInteract;
      }
    }
    else 
    {
      if (player.ActiveInventory == null && (mouse.Mode == eModeInteract || mouse.Mode == eModeInspect || mouse.Mode == eModeTalkto)) 
      {
         mouse.Mode = eModeWalkto; 
      }
    }
  }
  // Мышка на пустом фоне
  else 
  {
    if (player.ActiveInventory == null && (mouse.Mode == eModeInspect || mouse.Mode == eModeInteract || mouse.Mode == eModeTalkto))
    {
      mouse.Mode = eModeWalkto;
    }
  }
  
}

// Анимация катсцены на вечернем балконе
function reset_evening_balcony_animation()
{
    eveningBalconyTimer = 0;
    eveningBalconyFrame = 0;
}

// Анимация катсцены на вечернем балконе
function update_evening_balcony_animation()
{
    // Анимация работает исключительно на вечернем балконе
    if (player.Room != 34)
        return;

    eveningBalconyTimer++;

    int currentDelay = 25;

    // Третий кадр задерживается дольше остальных
    if (eveningBalconyFrame == 2)
    {
        currentDelay = 60;
    }

    if (eveningBalconyTimer >= currentDelay)
    {
        eveningBalconyTimer = 0;

        eveningBalconyFrame++;

        if (eveningBalconyFrame >= 5)
        {
            eveningBalconyFrame = 0;
        }

        SetBackgroundFrame(eveningBalconyFrame);
    }
}

// called on every game cycle, even when the game is blocked
function repeatedly_execute_always()
{
    repeat_diming();
    
    update_evening_balcony_animation();
    // --- ПРАВКА: Зажатие клавиши Z для показа панели настроения ---
    if (IsKeyPressed(eKeyZ) || moodPanelForced)
    {
        gMoodPanel.Visible = true;
        
        // Плавно проявляем панель при зажатой Z
        if (gMoodPanel.Transparency > 0)
        {
            int newTrans = gMoodPanel.Transparency - 10; // Скорость появления при нажатии
            if (newTrans < 0) newTrans = 0;
            gMoodPanel.Transparency = newTrans;
        }
    }
    else
    {
        // --- СТАНДАРТНАЯ АНИМАЦИЯ (когда Z не зажата) ---
        if (moodFadeState == 1) // Фаза 1: Плавное появление (от ChangeMood)
        {
            int newTrans = gMoodPanel.Transparency - 2;
            if (newTrans <= 0)
            {
                gMoodPanel.Transparency = 0;
                moodFadeState = 2; // Переходим к удержанию
            }
            else
            {
                gMoodPanel.Transparency = newTrans;
            }
        }
        else if (moodFadeState == 2) // Фаза 2: Удержание на экране (от ChangeMood)
        {
            if (moodTimer > 0)
            {
                moodTimer--;
            }
            else
            {
                moodFadeState = 3; // Время вышло, начинаем исчезать
            }
        }
        else if (moodFadeState == 3) // Фаза 3: Плавное исчезновение (от ChangeMood)
        {
            int newTrans = gMoodPanel.Transparency + 2;
            if (newTrans >= 100)
            {
                gMoodPanel.Transparency = 100;
                gMoodPanel.Visible = false; // Скрываем GUI
                lblMoodStatus.Text = "";    // Очищаем текст
                moodFadeState = 0;          // Состояние "Скрыта"
            }
            else
            {
                gMoodPanel.Transparency = newTrans;
            }
        }
        else if (moodFadeState == 0 && gMoodPanel.Visible)
        {
            // Если игрок только что отпустил Z, а ChangeMood не активен — плавно убираем панель
            int newTrans = gMoodPanel.Transparency + 10; // Скорость исчезновения после отпускания Z
            if (newTrans >= 100)
            {
                gMoodPanel.Transparency = 100;
                gMoodPanel.Visible = false;
                lblMoodStatus.Text = "";
            }
            else
            {
                gMoodPanel.Transparency = newTrans;
            }
        }
    }
// Плавное возвращение экрана в норму после стресса
  if (stressFlash == 1) 
  {
    if (gDarkOverlay.Transparency < 100) 
    {
      // Предохранитель: если следующий шаг сделает число больше 100, 
      // жестко фиксируем его на 100.
      if (gDarkOverlay.Transparency + 1 > 100) 
      {
        gDarkOverlay.Transparency = 100;
      }
      else 
      {
        // Иначе спокойно прибавляем 3
        gDarkOverlay.Transparency = gDarkOverlay.Transparency + 1; 
      }
    } 
    else 
    {
      // Когда стало полностью прозрачно (ровно 100), прячем GUI и выключаем процесс
      gDarkOverlay.Visible = false;
      stressFlash = 0; 
    }
  }
}

// Called when a dialog script line "run-script" is processed
function dialog_request(int param)
{
  // Если пришел сигнал №1 из диалога
  if (param == 1) 
  {
    Button3.Visible = false; // Прячем кнопку
  }
}

// called when processclick wasn't handled anywhere else
function unhandled_event (int what, int type)
{
  if (what == 1) // Unhandled events for HOTSPOTS
  {
    if (type == 1) // look
    {
      player.Say("I see nothing special about it.");
    }
    else if (type == 2) // interact
    {
      player.Say("I can't do anything with it.");
    }
    else if (type == 3) // use inv on
    {
      TypeText("Ума не приложу, что с этим делать.");
    }
    else if (type == 4) // talk to
    {
      player.Say("I don't think it's going to talk back.");
    }
    else if (type == 7) // pick up
    {
      player.Say("I'm not sure I should be taking it.");
    }
  }
  else if (what == 2) // Unhandled events for OBJECTS
  {
    if (type == 0) // look
    {
      player.Say("Looks alright.");
    }
    else if (type == 1) // interact
    {
      player.Say("I'm not sure how to use it.");
    }
    else if (type == 2) // talk to
    {
      player.Say("I don't think it's going to answer me.");
    }
    else if (type == 3) // use inv on
    {
      player.Say("That's a funny idea.");
    }
    else if (type == 5) // pick up
    {
      player.Say("I don't want to have it.");
    }
  }
  else if (what == 3) // Unhandled events for CHARACTERS
  {
    if (type == 0) // look
    {
      player.Say("Hm.");
    }
    else if (type == 1) // interact
    {
      player.Say("Eh?");
    }
    else if (type == 2) // talk to
    {
      player.Say("Got nothing to say.");
    }
    else if (type == 3) // use inv on
    {
      player.Say("I don't think I should give that away.");
    }
    else if (type == 5) // pick up
    {
      player.Say("I'm not sure they would be compliant.");
    }
  }
  else if (what == 5) // Unhandled events for INVENTORY ITEMS
  {
    if (type == 0) // look
    {
      player.Say("It's just some junk in my inventory.");
    }
    else if (type == 1) // interact
    {
      player.Say("Er, no?");
    }
    else if (type == 3) // use inv on
    {
      player.Say("That's ridiculous.");
    }
  }
}

