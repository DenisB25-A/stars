// Универсальная функция показа ЖУРНАЛА (вставляем её ВЫШЕ функций клика)
function ShowJournalItem(int index) {
    // ПРОВЕРКА: если записок найдено меньше, чем индекс кнопки — ничего не делаем
    if (index >= notesFoundCount) return; 

    int id = notesOrder[index];
    
    if (notesTypes[id] == eTextNote) {
        lblViewerText.Visible = true;
        btnViewerImage.Visible = false;
        lblViewerText.Text = notesTexts[id];
    }
    else if (notesTypes[id] == ePhotograph) {
        lblViewerText.Visible = false;
        btnViewerImage.Visible = true;
        btnViewerImage.NormalGraphic = notesSprites[id];
    }
     // Эта команда сама вычислит центр экрана
    gViewer.X = 970; // ТВОЁ ЧИСЛО X
    gViewer.Y = 55;  // ТВОЁ ЧИСЛО Y
    gViewer.Visible = true;
}

// Функция ЧТЕНИЯ ЗАПИСОК при нахождении
function ReadAndAddNote(int id) {
    // 1. Сначала показываем в центре экрана (используем твой gViewer)
    if (notesTypes[id] == eTextNote) {
        lblViewerText.Visible = true;
        btnViewerImage.Visible = false;
        lblViewerText.Text = notesTexts[id];
    }
    else if (notesTypes[id] == ePhotograph) {
        lblViewerText.Visible = false;
        btnViewerImage.Visible = true;
        btnViewerImage.NormalGraphic = notesSprites[id];
    }
    gViewer.Centre();
    gViewer.Visible = true;

    // 2. Добавляем в "очередь" журнала
    notesOrder[notesFoundCount] = id;
    notesFoundCount++;

    // 3. Обновляем интерфейс журнала (твоя функция)
    UpdateJournalUI();
}

