function Laptop_Button1_OnClick(GUIControl *control, MouseButton button)
{
  if (IsNight == false)
    // ПРОВЕРКА: Если на письмо уже ответили, кнопку НЕ показываем
  {
    if (ksenia_answer == true) 
    {
      Button3.Visible = false; 
    }
    else 
    {
      Button3.Visible = true; 
    }
    lblEmailBody.Text = emailTexts[0]; // Подставляем нужный текст в наш Label
    gEmailReader.Visible = true;       // Показываем окно чтения
    CurrentEmail = 0;                  // ЗАПОМИНАЕМ: Открыто письмо 0 (Ксения)
  }
  else if (IsNight == true)
  {
    lblEmailBody.Text = emailTexts[4];
    gEmailReader.Visible = true;
    CurrentEmail = 4;
  }
}

