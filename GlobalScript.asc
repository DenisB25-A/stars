function btnNew_game_OnClick(GUIControl *control, MouseButton button)
{
  gMainMenu.Visible = false;          // Скрываем меню
  cEgo.ChangeRoom(31, 583, 996);       // Переводим в комнату №1 (укажи номер комнаты и координаты X, Y)
  mouse.Mode = eModeWalkto;           // Переключаем курсор в обычный игровой режим
}

