// Очищаем миниатюры всех четырёх карточек
function ClearSavePreviews()
{
  for (int i = 0; i < 4; i++)
  {
    // Убираем изображения с кнопок
    saveSlotButtons[i].NormalGraphic = 0;
    saveSlotButtons[i].MouseOverGraphic = 0;
    saveSlotButtons[i].PushedGraphic = 0;

    // Освобождаем память
    if (saveSlotPreviews[i] != null)
    {
      saveSlotPreviews[i].Delete();
      saveSlotPreviews[i] = null;
    }
  }
}

// Обновляем четыре карточки текущей страницы
function RefreshSavePage()
{
  // Сначала очищаем старые изображения
  ClearSavePreviews();

  for (int i = 0; i < 4; i++)
  {
    // Вычисляем настоящий номер сохранения
    int slotNumber = currentSavePage * 4 + i + 1;

    // Получаем название сохранения
    String saveDescription = Game.GetSaveSlotDescription(slotNumber);

    // Возвращаем карточку в обычное состояние
    saveSlotLabels[i].Visible = true;
    saveSlotInputs[i].Visible = false;
    saveSlotInputs[i].Text = "";

    // Если сохранение отсутствует
    if (String.IsNullOrEmpty(saveDescription))
    {
      saveSlotLabels[i].Text = "Пусто";
    }
    else
    {
      // Показываем название
      saveSlotLabels[i].Text = saveDescription;

      // Размеры миниатюры
      int previewWidth = 316;

      // Нижний ряд карточек немного уже
      if (i >= 2)
      {
        previewWidth = 314;
      }

      // Загружаем скриншот из файла сохранения
      saveSlotPreviews[i] = DynamicSprite.CreateFromSaveGame(
        slotNumber,
        previewWidth,
        192
      );

      // Устанавливаем изображение на кнопку
      if (saveSlotPreviews[i] != null)
      {
        saveSlotButtons[i].NormalGraphic = saveSlotPreviews[i].Graphic;
        saveSlotButtons[i].MouseOverGraphic = saveSlotPreviews[i].Graphic;
        saveSlotButtons[i].PushedGraphic = saveSlotPreviews[i].Graphic;
      }
    }
  }
}

// Обновляем текст номера страницы
function RefreshSavePageIndicator()
{
  lblSavePageIndicator.Text = String.Format("Страница %d / 5", currentSavePage + 1);
}

function on_event(EventType event, int data1, int data2, int data3, int data4)
{
  // Сбрасываем ввод при клике за пределами активного поля
  if (event == eEventGUIMouseDown &&
      gSave_game.Visible &&
      !gDeleteSaveConfirm.Visible &&
      selectedSaveCard >= 0)
  {
    if (data1 != gSave_game.ID)
    {
      CancelSaveNameInput();
    }
    else
    {
      GUIControl* clickedControl = GUIControl.GetAtScreenXY(
        gSave_game.X + data3,
        gSave_game.Y + data4
      );

    if (clickedControl != saveSlotInputs[selectedSaveCard] &&
        clickedControl != btn_saveg &&
        clickedControl != lbl_save &&
        clickedControl != btn_save_del &&
        clickedControl != lbl_save_del)
    {
      CancelSaveNameInput();
    }
    }
  }
      // Клик по GUI инвентаря
  if (event == eEventGUIMouseDown && data1 == gInventory_menu.ID)
  {
      gContext.Visible = false;
      itemToExamine = null;
  }
  // Проверяем, что восстановлена именно точка перезапуска
  if (event == eEventRestoreGame && data1 == 999)
  {
    gMainMenu.Visible = false;
    gExit.Visible = false;
    gMenu_ingame.Visible = false;
    gDarkOverlay.Visible = false;
    gExit_in_game.Visible = false;
    gMenu_ingame.Clickable = true;

    mouse.Mode = eModeWalkto;

    // Начинаем прохождение с самого начала
    cEgo.ChangeRoom(1, 583, 996);
  }
}

