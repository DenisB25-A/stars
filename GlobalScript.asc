function btnContinue_OnClick(GUIControl *control, MouseButton button)
{
  gMenu_ingame.Visible = false;   // Скрываем меню
  gDarkOverlay.Visible = false;   // Убираем затемнение
  UnPauseGame();                  // Снимаем игру с паузы
  mouse.Mode = eModeWalkto;       // Возвращаем игровой курсор (шаги/крестик)
}

function btnExit_OnClick(GUIControl *control, MouseButton button)
{
  gMenu_ingame.Visible = false;
  gDarkOverlay.Visible = false;
  player.ChangeRoom(99, 0, 0);
  gMainMenu.Visible = true;
  UnPauseGame();
  mouse.Mode = eModePointer;
}
