// INITIALIZATION
//=============================================================================

int notesOrder[20]; // Массив, где мы будем хранить ID найденных записок в порядке нахождения
String notesNames[20]; // Названия для кнопок
Button* btnNote[20]; // Массив указателей на наши кнопки журнала

export notesOrder;   // <--- ДОБАВИТЬ ЭТО
export notesNames;   // <--- И ЭТО (на всякий случай)

String notesTexts[20]; // Массив для самих текстов записок
export notesTexts;

enum ItemType { eTextNote, ePhotograph }; // Определяем типы контента
ItemType notesTypes[20]; // Массив типов
int notesSprites[20];    // Массив номеров спрайтов для фото

InventoryItem* itemToExamine;
int moodTimer = 0; // Таймер для отображения цифр
int playerDirection = 0; // 0 - стоит, 1 - вправо, 2 - влево
// set default game options
function set_default_options()
{
  System.Volume = 100;
  sldAudio.Value = System.Volume;
  sldSpeed.Value = 40;
  SetGameSpeed(40);

  if (IsSpeechVoxAvailable())
  {
     Speech.VoiceMode = eSpeechVoiceAndText;
     btnVoice.Text = "Voice and Text";
     sldVoice.Value = 255;
     SetSpeechVolume(255);
  }

  if (System.SupportsGammaControl)
  {
    System.Gamma = 100;
    sldGamma.Value = 100;
  }
}

// initialize gPanel
function initialize_control_panel()
{
  if (!IsSpeechVoxAvailable())
  {
    // hide the speech controls, if speech is not available
    lblVoice.Visible = false;
    btnVoice.Visible = false;
    sldVoice.Visible = false;
  }

  if (!System.SupportsGammaControl) {
    // hide the gamma control, if not supported
    sldGamma.Visible = false;
    lblGamma.Visible = false;
  }

  set_default_options();
}


function UpdateJournalUI() {
  int i = 0;
  int totalButtonsCreated = 5; // НАПРИМЕР: У тебя пока нарисовано только 4 кнопки в GUI
  
  while (i < totalButtonsCreated) { 
    if (i >= notesFoundCount) {
      btnNote[i].Visible = false; 
    } 
    else {
      int noteID = notesOrder[i];
      btnNote[i].Text = notesNames[noteID];
      btnNote[i].Visible = true;
    }
    i++;
  }
}

// called when the game starts, before the first room is loaded
function game_start()
{
  // initialize gPanel controls
  initialize_control_panel();
  mouse.EnableMode(eModePointer);
  
  // Инициализируем массив кнопок
  btnNote[0] = btnNote1; // Привязываем первую кнопку
  btnNote[1] = btnNote2; // Привязываем вторую кнопку
  btnNote[2] = btnNote3; // И так далее...
  btnNote[3] = btnNote4;
  btnNote[4] = btnNote5;
  btnNote[5] = btnNote6;

  // Предмет 0: Текстовая записка
  notesNames[0] = "Мамина фотокарточка";
  notesTypes[0] = ePhotograph;
  notesSprites[0] = 55;

  // Предмет 1: Фотография
  notesNames[1] = "Фотография со странным мужчиной";
  notesTypes[1] = ePhotograph;
  notesSprites[1] = 46; // Допустим, спрайт фотографии имеет номер 150
  
  notesNames[2] = "Недописанное письмо";
  notesTypes[2] = eTextNote;
  notesTexts[2] = "Антоша здравствуй..."; // Допустим, спрайт фотографии имеет номер 150
  
  notesNames[3] = "Записка соседке";
  notesTypes[3] = eTextNote;
  notesTexts[3] = "Не забудь закрыть дверь...";
  
  notesNames[4] = "Детский рисунок 1";
  notesTypes[4] = ePhotograph;
  notesSprites[4] = 84; // Допустим, спрайт фотографии имеет номер 150
  
  notesNames[5] = "Странное объявление";
  notesTypes[5] = eTextNote;
  notesTexts[5] = "Покайся...";
  // set KeyboardMovement movement mode
  // МЕНЯЕМ ЭТУ СТРОЧКУ на None, чтобы модуль не перехватывал управление
  //KeyboardMovement.Mode = eKeyboardMovementModeNone;
  // set KeyboardMovement keys
  //KeyboardMovement.KeyUp = eKeyW;
  //KeyboardMovement.KeyDown = eKeyS;
  //KeyboardMovement.KeyLeft = eKeyA;
  //KeyboardMovement.KeyRight = eKeyD;
  // Auto-save on the save slot 999
  SetRestartPoint();

  // Устанавливаем шрифт для диалогов (вместо 1 поставь ID своего Arial)
}

//=============================================================================
// Common GUI functions
//=============================================================================

// hide the icon bar and show a GUI
function open_gui(GUI* gui_to_open)
{
  if (gui_to_open != gInventory)
  {
    lblOverHotspot.Visible = false;
  }

  gIconbar.Visible = false;
  mouse.UseModeGraphic(eModePointer);
  gui_to_open.Visible = true;
}

// hide the GUI and show the icon bar
function close_gui(GUI* gui_to_close)
{
  gui_to_close.Visible = false;
  mouse.UseDefaultGraphic();
  lblOverHotspot.Visible = true;
  gIconbar.Visible = true;
}

// hide a GUI, based on a GUI control
function close_owning_gui(GUIControl* control)
{
  close_gui(control.OwningGUI);
}

// hide a GUI directly from an OnClick event
function close_gui_onclick(GUIControl *control, MouseButton button)
{
  close_owning_gui(control);
}

function show_inventory_window()
{
  mouse.Mode = eModeInteract;
  open_gui(gInventory);
}

function show_save_game_dialog()
{
  // get the list of save games
  lstSaveGamesList.FillSaveGameList();

  if (lstSaveGamesList.ItemCount > 0)
  {
    // if there is at least one, set the default text
    // to be the first game's name
    txtNewSaveName.Text = lstSaveGamesList.Items[0];
  }
  else
  {
    // no save games yet, so default to empty text
    txtNewSaveName.Text = "";
  }

  open_gui(gSaveGame);
}

function show_restore_game_dialog()
{
  lstRestoreGamesList.FillSaveGameList();
  open_gui(gRestoreGame);
}

