// room script file

function hGo_up_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(19, 1085, 968); 
}

function hGo_down_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(21, 1085, 968); 
}

function room_FirstLoad()
{
  TypeText("Какого... черта. Я уже должен был выйти на улицу, разве нет?");
  TypeText("Мысли путаются. Мне... мне надо хорошо выспаться. Хотя бы один раз.");
}
