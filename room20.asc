// room script file

function room_FirstLoad()
{
  TypeText("Я уже должен был выйти на улицу, разве нет?");
  TypeText("Мысли путаются. Мне... мне надо выспаться.");
}

function hGo_down_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(21, 1036, 968); 
}

function hGo_up_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(19, 340, 968); 
}

function oArmature_Interact(Object *theObject, CursorMode mode)
{
  TypeText("Брошенный кем-то кусок арматуры. Наверное, пригодится.");
  oArmature.Visible = false;
  player.AddInventory(iArmature);
  TypeText("Получен предмет: «Кусок арматуры».");
}
