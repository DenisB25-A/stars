          </Dialog>
          <Dialog>
            <ID>5</ID>
            <Name>dTeapot</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
  if (cEgo.HasInventory(iCoffee)) {
      dTeapot.SetOptionState(1, eOptionOn);
      dTeapot.SetOptionState(4, eOptionOn);
      
    if (cEgo.HasInventory(iSugar)) {
        dTeapot.SetOptionState(2, eOptionOn);
        
      if (cEgo.HasInventory(iMilk)) {
          dTeapot.SetOptionState(3, eOptionOn);
          dTeapot.SetOptionState(5, eOptionOff);
      }
    }
  }
return
@1
  FadeOut(2);
  AudioChannel *channel1 = aCoffee.Play();
  while (channel1 != null && channel1.IsPlaying) 
  {
    Wait(1); 
  }
  FadeIn(2);
  TypeText("Настолько крепкий, что сводит зубы, еще и несладкий. Не самый мой любимый напиток. Но за неимением лучшего и это сойдет.");
  was_brew_coffee = true;
  player.LoseInventory(iCoffee);
  player.AddInventory(iCup);
  TypeText("Получен предмет: 'Кружка с кофе.'");
  
stop
@2
  FadeOut(2);
  AudioChannel *channel1 = aCoffee.Play();
  while (channel1 != null && channel1.IsPlaying) 
  {
    Wait(1); 
  }
  FadeIn(2);
  TypeText("Вот, то что надо.");
  was_brew_coffee = true;
  player.LoseInventory(iCoffee);
  player.LoseInventory(iSugar);
  player.AddInventory(iCup);
  ChangeMood(1);
stop
@3
  FadeOut(2);
  AudioChannel *channel1 = aCoffee.Play();
  while (channel1 != null && channel1.IsPlaying) 
  {
    Wait(1); 
  }
  FadeIn(2);
  TypeText("...");
  TypeText("Молоко прокисло...");
  TypeText("Я или не заметил этого или снова забыл... Теперь вода из унитаза на вкус была бы приятнее.");
  TypeText("Черт, ну почему все снова идет не так?");
  TypeText("Я так больше... эх.");
  was_brew_coffee = true;
  player.LoseInventory(iCoffee);
  player.LoseInventory(iSugar);
  player.LoseInventory(iMilk);
  player.AddInventory(iCup);
  ChangeMood(-2);
stop
@4
stop
@5
  TypeText("Хотелось бы чего-то большего, чем запивать тоску кипятком.");
  TypeText("Мне нужны молоко, кофе, сахар, наверняка все это где-нибудь здесь.");
stop
]]></Script>
            <DialogOptions>
              <DialogOption>
                <ID>1</ID>
                <Say>False</Say>
                <Show>False</Show>
                <Text xml:space="preserve">Сделать крепкий черный кофе.</Text>
              </DialogOption>
              <DialogOption>
                <ID>2</ID>
                <Say>False</Say>
                <Show>False</Show>
                <Text xml:space="preserve">Сделать простой кофе с сахаром.</Text>
              </DialogOption>
              <DialogOption>
                <ID>3</ID>
                <Say>False</Say>
                <Show>False</Show>
                <Text xml:space="preserve">Сделать кофе с сахаром и молоком.</Text>
              </DialogOption>
              <DialogOption>
                <ID>4</ID>
                <Say>False</Say>
