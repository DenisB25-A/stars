          <Dialog>
            <ID>12</ID>
            <Name>dBum</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
option-off 4
option-off 5
option-off 6
option-off 7
option-off 8
option-off 9
option-off 10
option-off 11
return

@1
  cBum.LockView(cBum.SpeechView); // Включаем анимацию рта
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Человек. Которому зябко на улице.");
  TypeText(">Бомж: И который очень хочет курить.");
  cBum.UnlockView();
option-off 1

return
@2
  FadeOut(2);
  Wait(120);
  aSmoke.Play();
  player.x = 1270; 
  player.y = 925;
  player.LockView(ILYA_ON_STAIRS);
  FadeIn(2);
  Wait(40);
option-off 1
option-off 2
option-on 4
option-on 5
return
@3
  cBum.LockView(cBum.SpeechView);
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Шатаешься. Все бегаешь, суетишься. Потому никуда и не можешь прийти.");
  TypeText(">Бомж: Так никогда не оказаться на своем месте, парень.");
  cBum.UnlockView();
option-off 3
return

@4
  cBum.LockView(cBum.SpeechView); // Включаем анимацию рта
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  cBum.UnlockView();
  TypeText(">Бомж: Зачем мне? Здесь тепло. Батареи греют. Ветер не дует. Менты не гоняют.");
  TypeText("Антон: Вы не понимаете - тут что-то происходит. Надо выбираться, а я... короче я не могу найти выход.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Бежать... я много от чего в жизни бегал."); 
  TypeText(">Бомж: От неприятностей, от долгов, от женщин, от жизни - от всего."); 
  TypeText(">Бомж: Вот только когда бежишь, всегда оказываешься вот в такой бетонной коробке.");
  TypeText(">Бомж: Где воняет ссаниной.");
  cBum.UnlockView();
option-off 4
return
@5
  TypeText("Антон: Что-то странное происходит...");
  TypeText("Антон: С тех пор, как я переехал сюда.");
  TypeText("Антон: Мне постоянно кажется, что в квартире кроме меня кто-то есть.");
  TypeText("Антон: А сейчас там нет света, хотя электричество есть на всех этажах.");
  TypeText("Антон: И... я не могу выйти из дома.");
  TypeText("Антон: Подъезд куда-то исчез. Осталась только лестница вниз.");
  TypeText("Антон: В темноту.");
  TypeText("Антон: Не знаю, зачем это все говорю.");
  Wait(120);
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Говори, авось полегчает.");
  TypeText(">Бомж: Ночь - она всегда долгая, а эта будет длинее прочих.");
  TypeText(">Бомж: Времени у нас - до рассвета.");
  TypeText(">Бомж: Так чего же ты хочешь?");
  cBum.UnlockView();
option-off 4
option-off 5
option-on 6
option-on 7
return
@6
  TypeText("Антон: Как чего? Я просто хочу вернуться домой.");
  TypeText("Антон: Починить свет, зайти в свою комнату и лечь спать.");
  TypeText("Антон: А завтра сделать вид, что вся эта дичь мне приснилась.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Домой, говоришь?");
  cBum.UnlockView();
  Wait(120);
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Дом - это хорошее слово. Теплое. Но знаешь, что я тебе скажу, парень?");
  TypeText(">Бомж: Ты не хочешь домой. Ты хочешь вернуться назад.");
  TypeText(">Бомж: Ты устал, тебе страшно. Ты думаешь закрыться за дверью, провернуть все замки и оказаться в месте, где тебя когда-то любили. Когда-то давно, парень. Хочешь вернуться в прошлое.");
  TypeText(">Бомж: Носишь его, как тяжелый мешок за плечами.");
  TypeText(">Бомж: Я же вижу. Брось его. Посмотри на меня - вот я дома.");
  cBum.UnlockView();
option-off-forever 6
option-off-forever 7
option-on 8
return
@7
  TypeText("Антон: Здесь происходит что-то ненормальное. Мне надо выбраться отсюда.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Это несложно, парень. Но, знаешь, как говорят? Уйдешь из панельки, а вот панелька не уйдет из тебя. Будешь просто таскать ее всюду.");
  TypeText(">Бомж: Знаешь, что я сам понял, когда стер ноги до крови?");
  TypeText(">Бомж: Настоящий побег - это побег от самого себя.");
  TypeText(">Бомж: Треплются, что все это невозможно, но я считаю, что это как раз лучше всего. И что это - самое правильное.");
  TypeText(">Бомж: Когда удалось сбежать от себя - становится все равно, где ты и кто ты.");
  TypeText(">Бомж: Тогда ты и освободишься.");
  cBum.UnlockView();
option-off-forever 6
option-off-forever 7
option-on 8  
return
@8
  TypeText("Антон: Эээ... спасибо. Не скажу, что я понял, что делать, но я об этом подумаю на досуге.");
  TypeText("Антон: Хотя сложно о чем-то думать, когда жизнь идет наперекосяк и не спишь вторые сутки подряд.");
  TypeText("Антон: Правда, все это не решает моей насущной проблемы.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: С любой проблемой главное не спешить, парень.");
  TypeText(">Бомж: Рано или поздно она все равно решится, а ты не будешь уставшим.");
  cBum.UnlockView();
option-off 8
option-off 9
option-off 10
option-on 11
return
@9
  TypeText("Антон: Это, конечно, все очень интересно. Вот только я не понял вообще нихрена.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Если ты оказался здесь и до сих пор ничегошеньки не понял, то дела твои никудышно, парень");
  TypeText(">Бомж: Хотя, возможно, это все молодость, и время еще есть.");
  TypeText(">Бомж: Но помни - его не так много.");
  cBum.UnlockView();
option-off 8
option-off 9
option-off 10
option-on 11
return
@10
  TypeText("Антон: Слушай, я типо воспитанный, все дела, и знаю, что перед старшими надо челом бить.");
  TypeText("Антон: Но по-моему ты просто старый выживший из ума маразматик.");
  TypeText("Антон: Так что не капай мне на мозги. Со своей жизнью я как-нибудь сам разберусь.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Разберешься - охотно верю.");
  TypeText(">Бомж: Но пока ты сидишь на ступеньках с воняющим старым бомжом.");
  cBum.UnlockView();
return
@11
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Нет, я бомж-лужевидец.");
  cBum.UnlockView();
  TypeText("Антон: Чего?");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Это было давно, парень. Ты тогда еще ползал под столом на коленках и слюнявил фломастеры. А я в тот день прошатался впустую по рынкам. Никто мне не подал, ничего не удалось раздобыть, и голова кружилась от голода.");
  TypeText(">Бомж: Я присел на бордюр, чтобы немного передохнуть, и, о горе, вдобавок ко всему пошел ливень. Передо мной быстро образовалась огромная грязная лужа.");
  TypeText(">Бомж: Идти куда-то не было сил, и я просто сидел и смотрел. Смотрел, как бесконечно бьют капли, и как круги расходятся по воде. Я чувствовал себя плохо, весь вымок, от слабости кружилась голова, но я просто сидел, как побитая псина и смотрел в лужу. И в какой-то момент что-то произошло.");
  TypeText(">Бомж: Я что-то увидел. Можешь мне не верить, парень, но в луже был я сам. То есть, не мое отражение, а я, но только другой я, который сидел и тоже смотрел в такую же лужу, где был уже другой я, точно также смотрящий в еще одну - и так далее. В тот миг в моей голове что-то щелкнуло. Меня пронзило знанием.");
  TypeText(">Бомж: Из воды вылетели красные нити, они потянулись в стороны и оплели все вокруг. Меня сцепило с теми 'другими' бесконечными версиями, смотрящими в бесконечные лужи.");
  TypeText(">Бомж: Я был так поражен, что вскочил на ноги и принялся кружиться и танцевать, прямо на улице, под дождем.");
  TypeText(">Бомж: Меня после этого упекли на неделю в психушку.");
  TypeText(">Бомж: Но в тот день я много понял о жизни.");
  cBum.UnlockView();
  TypeText("Антон: ...");
  TypeText("Антон: Ахуительная история.");
return
]]></Script>
            <DialogOptions>
              <DialogOption>
                <ID>1</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Вы вообще кто?</Text>
              </DialogOption>
              <DialogOption>
                <ID>2</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">"Дать сигарету"</Text>
              </DialogOption>
              <DialogOption>
                <ID>3</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Я не шатаюсь...</Text>
              </DialogOption>
              <DialogOption>
