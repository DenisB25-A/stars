            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
    TypeText("Откуда это здесь. Настоящее пиво у меня дома.");
    TypeText("Мне уже давно за 18. Вряд ли эти малютки пригодятся кому-то больше...");
return
@1
  cEgo.AddInventory(iBeerBottleClose);
  object[0].Visible = false;
option-off 1;
option-off 3;
stop
@2
  cEgo.AddInventory(iBeerBottleFar);
  object[1].Visible = false;
option-off 2;
option-off 3;
stop
@3
  cEgo.AddInventory(iBeerBottleFar);
  object[0].Visible = false;
  cEgo.AddInventory(iBeerBottleClose);
  object[1].Visible = false;
option-off 1;
option-off 2;
option-off 3;
stop
@4
return
]]></Script>
