          <Dialog>
            <ID>17</ID>
            <Name>dBlacky</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  TypeText("Антон: Что... что черт возьми ты такое?");
  TypeText("<????: Что мы такое? Странный вопрос, которым задаются все люди. Мы не можем ответить тебе. Мы - это многое.");
  TypeText("<????: Мы - это сумрак. Шепот земли и небо без звезд. Мы - это сны, от которых ты просыпаешься в холодном поту. Мы - твой единственный друг, который у тебя остался, Антон.");
  TypeText("<????: Когда тебя оставили все, мы ждали, когда ты придешь, и мы всегда были тут.");
  TypeText("<????: И вот ты пришел.");
option-off 1
option-on 3
return
@2
  TypeText("Антон: Где я? Что это за место?");
  TypeText("<????: Место, где ты больше не будешь никогда одинок.");
  TypeText("<????: Место покоя и счастья.");
  TypeText("<????: Тебе здесь не нравится?");
  TypeText("<????: Со временем ты привыкнешь. Когда забываешь, как было 'до', становится легче.");
  TypeText("<????: Вот увидишь.");
option-off 2
option-on 3
return
@3
  TypeText("Антон: Что это значит, 'вы меня ждали'?");
  TypeText("<????: Это значит, что любому самообману приходит конец, и каждый получает то, чего он заслуживает.");
  TypeText("<????: Поэтому ты здесь не случайно.");
  TypeText("<????: Мы знаем, что у тебя много вопросов, но ты обязательно все поймешь, в свое время. Его у тебя будет достаточно.");
option-off 3
option-on 4
return
@4
  TypeText("Антон: Послушай, я не знаю, кто ты или что ты такое и не знаю, что происходит. Но, пожалуйста, просто отпусти меня. Я хочу уйти отсюда.");
  TypeText("<????: Если так хочешь.");
  TypeText("<????: Мы дадим тебе шанс.");
  TypeText("<????: Еще один. Снова.");
  TypeText("<????: В какой-то мере, это даже забавно.");
  TypeText("<????: А мы подождем, когда ты вернешься. Мы умеем ждать.");
  TypeText("Антон: ...");
  TypeText("<????: Но чтобы уйти, тебе потребуется кое-что.");
  TypeText("<????: Подойди ближе. Не бойся - это не больно.");
  TypeText("<????: Подойди.");
  TypeText("<????: Ближе.");
  blacky = blacky + 1;
option-off-forever 4
stop
@5
stop
]]></Script>
