          <Dialog>
            <ID>20</ID>
            <Name>dBeatle</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
  if (beetleDialogueStage == 0) {
    TypeText("Жук: Ц-ц-ц. Ночь длинная. Одному сидеть скучно.");
    dBeatle.SetOptionState(1, eOptionOn);
    dBeatle.SetOptionState(3, eOptionOn);
    dBeatle.SetOptionState(4, eOptionOff);
    dBeatle.SetOptionState(5, eOptionOff);
    dBeatle.SetOptionState(6, eOptionOff);
    dBeatle.SetOptionState(7, eOptionOff);
    dBeatle.SetOptionState(8, eOptionOff);
    dBeatle.SetOptionState(9, eOptionOff);
    dBeatle.SetOptionState(10, eOptionOff);
    dBeatle.SetOptionState(11, eOptionOff);
    dBeatle.SetOptionState(12, eOptionOff);
    dBeatle.SetOptionState(13, eOptionOff);
    dBeatle.SetOptionState(14, eOptionOff);
    dBeatle.SetOptionState(15, eOptionOff);
    dBeatle.SetOptionState(16, eOptionOff);
    dBeatle.SetOptionState(17, eOptionOff);
    dBeatle.SetOptionState(18, eOptionOff);
    dBeatle.SetOptionState(19, eOptionOff);
    dBeatle.SetOptionState(20, eOptionOff);
    dBeatle.SetOptionState(21, eOptionOff);
    dBeatle.SetOptionState(22, eOptionOff);
    dBeatle.SetOptionState(23, eOptionOff);
    dBeatle.SetOptionState(2, eOptionOff);
  }
  else if (beetleDialogueStage == 1) {
    TypeText("Жук: Ну?");
    dBeatle.SetOptionState(7, eOptionOn);
    if (cEgo.HasInventory(iBeerBottleClose) || cEgo.HasInventory(iBeerBottleFar)) {
      dBeatle.SetOptionState(2, eOptionOn);
    }
    else {
      dBeatle.SetOptionState(2, eOptionOff);
    }
  }
  else if (beetleDialogueStage == 2) {
    TypeText("Илья: Ты ведь не просто жук. Обычные жуки так не разговаривают.");
    TypeText("Жук: Я обычный. Просто большой.");
    beetleQuestionsAsked = 0;
    beetleDialogueStage = 3;
    dBeatle.SetOptionState(8, eOptionOn);
    dBeatle.SetOptionState(9, eOptionOn);
    dBeatle.SetOptionState(10, eOptionOn);
    dBeatle.SetOptionState(11, eOptionOn);
  }
  else if (beetleDialogueStage == 3) {
    TypeText("Жук: Ну? Спрашивай дальше.");
    dBeatle.SetOptionState(11, eOptionOn);
  }
  else if (beetleDialogueStage == 4) {
    TypeText("Жук: Ну? Кровать всё ещё здесь.");
    dBeatle.SetOptionState(12, eOptionOn);
    dBeatle.SetOptionState(13, eOptionOn);
    dBeatle.SetOptionState(14, eOptionOn);
    dBeatle.SetOptionState(15, eOptionOn);
  }
  else if (beetleDialogueStage == 5) {
    TypeText("Жук: Ты снова пришёл и стоишь рядом. Значит, хочешь что-то сказать.");
    dBeatle.SetOptionState(12, eOptionOff);
    dBeatle.SetOptionState(13, eOptionOff);
    dBeatle.SetOptionState(14, eOptionOff);
    dBeatle.SetOptionState(15, eOptionOff);
    dBeatle.SetOptionState(16, eOptionOn);
    dBeatle.SetOptionState(17, eOptionOn);
  }
  else if (beetleDialogueStage == 6) {
    TypeText("Жук: Ну и как ты решил меня называть?");
    dBeatle.SetOptionState(18, eOptionOn);
    dBeatle.SetOptionState(19, eOptionOn);
    dBeatle.SetOptionState(20, eOptionOn);
    dBeatle.SetOptionState(21, eOptionOn);
  }
  else if (beetleDialogueStage == 7) {
    TypeText("Илья: Лучше не стало?");
    TypeText("Жук: Нет. И внутри всё ещё холодно. Ищи что-нибудь пахучее.");
    dBeatle.SetOptionState(23, eOptionOn);
    if (cEgo.HasInventory(iStar_salve)) {
      dBeatle.SetOptionState(22, eOptionOn);
    }
    else {
      dBeatle.SetOptionState(22, eOptionOff);
    }
  }
return
@1
  TypeText("Илья: Ты сейчас со мной разговариваешь? Или я уже совсем устал?");
  TypeText("Жук: Разговариваю. Ты пока тоже можешь. Значит, всё нормально.");
  beetleDialogueStage = 1;
  dBeatle.SetOptionState(1, eOptionOff);
  if (cEgo.HasInventory(iBeerBottleClose) || cEgo.HasInventory(iBeerBottleFar)) {
    dBeatle.SetOptionState(2, eOptionOn);
  }
  else {
    dBeatle.SetOptionState(2, eOptionOff);
  }
  dBeatle.SetOptionState(3, eOptionOff);
  dBeatle.SetOptionState(4, eOptionOn);
  dBeatle.SetOptionState(5, eOptionOn);
  dBeatle.SetOptionState(6, eOptionOn);
  dBeatle.SetOptionState(7, eOptionOn);
return
@2
  if (cEgo.HasInventory(iBeerBottleClose) && cEgo.HasInventory(iBeerBottleFar)) {
    cEgo.LoseInventory(iBeerBottleClose);
    cEgo.LoseInventory(iBeerBottleFar);
    AudioChannel *drinkChannel = aBeerGlassesClink.Play();
    while (drinkChannel != null && drinkChannel.IsPlaying) {
      Wait(1);
    }
    drinkChannel = aBeerBottleOpen.Play();
    while (drinkChannel != null && drinkChannel.IsPlaying) {
      Wait(1);
    }
    aBeerFizz.Play();
    TypeText("Жук: Теперь можно поговорить. Только сядь куда-нибудь. Ты надо мной стоишь.");
    TypeText("Илья: На кровать я сесть не могу. Там огромный жук.");
    TypeText("Жук: Тогда стой. У тебя ещё под кроватью пыль.");
  }
  else {
    if (cEgo.HasInventory(iBeerBottleClose)) {
      cEgo.LoseInventory(iBeerBottleClose);
    }
    else {
      cEgo.LoseInventory(iBeerBottleFar);
    }
    AudioChannel *drinkChannel = aBeerBottleOpen.Play();
    while (drinkChannel != null && drinkChannel.IsPlaying) {
      Wait(1);
    }
    aBeerFizz.Play();
    TypeText("Илья: У меня только одна. Забирай. Мне сейчас и без пива странно.");
    TypeText("Жук: Правильно. Одному мало. Делить нечего.");
  }
  beetleDialogueStage = 1;
  dBeatle.SetOptionState(1, eOptionOff);
  dBeatle.SetOptionState(2, eOptionOff);
  dBeatle.SetOptionState(3, eOptionOff);
  dBeatle.SetOptionState(4, eOptionOn);
  dBeatle.SetOptionState(5, eOptionOn);
  dBeatle.SetOptionState(6, eOptionOn);
  dBeatle.SetOptionState(7, eOptionOn);
return
@3
stop
@4
  TypeText("Илья: Раз уж мы разговариваем, расскажи хоть что-нибудь о себе.");
  TypeText("Жук: Я жук. Живу в тепле. Ем что найду. Иногда сплю. Больше ничего важного нет.");
  TypeText("Илья: Это вся твоя жизнь?");
  TypeText("Жук: Пока хватает.");
option-off 4
return
@5
  TypeText("Илья: Тебе вообще нравится моя комната? Ты устроился здесь как хозяин.");
  TypeText("Жук: Нравится. Кровать мягкая. Трубы тёплые. И ты редко убираешь.");
  TypeText("Илья: Последнее сейчас было оскорблением?");
  TypeText("Жук: Нет. В чистом месте жить неудобно. Всё сразу видно.");
option-off 5
return
@6
  TypeText("Илья: Раз ты решил остаться, скажи сразу, что тебе нужно.");
  TypeText("Жук: Тепло. Чтобы дверь не закрывали до конца. И чтобы покрывало не дёргали.");
  TypeText("Илья: А если я всё-таки дёрну?");
  TypeText("Жук: Тогда упаду. Потом ты будешь виноват.");
option-off 6
return
@7
  TypeText("Илья: Ладно. Я пойду. Слишком странный вечер.");
  TypeText("Жук: Иди. Только свет не выключай. В темноте холоднее.");
  beetleDialogueStage = 2;
  dBeatle.SetOptionState(4, eOptionOff);
  dBeatle.SetOptionState(5, eOptionOff);
  dBeatle.SetOptionState(6, eOptionOff);
  dBeatle.SetOptionState(7, eOptionOff);
stop
@8
  TypeText("Илья: Почему ты вообще такой огромный? Майские жуки такими не бывают.");
  TypeText("Жук: Я вырос. Сначала был маленький. Потом стало много места и еды.");
  TypeText("Илья: И ты просто рос, пока не стал размером с человека?");
  TypeText("Жук: Да. Потом перестал. Кровать уже стала мала.");
  beetleQuestionsAsked = beetleQuestionsAsked + 1;
option-off 8
return
@9
  TypeText("Илья: Откуда ты взялся в моей спальне? Я бы заметил тебя у двери.");
  TypeText("Жук: Из стены за шкафом. Там идут трубы. Раньше было тепло.");
  TypeText("Илья: А потом?");
  TypeText("Жук: Трубы остыли. Я пошёл туда, где теплее.");
  beetleQuestionsAsked = beetleQuestionsAsked + 1;
option-off 9
return
@10
  TypeText("Илья: Хорошо. Допустим, ты пришёл из стены. Что ты теперь здесь делаешь?");
  TypeText("Жук: Живу. Комната хорошая. Ты пока не мешаешь.");
  TypeText("Илья: Пока?");
  TypeText("Жук: Ты ещё не пытался меня выгнать.");
  beetleQuestionsAsked = beetleQuestionsAsked + 1;
option-off 10
return
@11
  if (beetleQuestionsAsked < 3) {
    return RUN_DIALOG_STOP_DIALOG;
  }
  TypeText("Жук: Ты всё спросил не про то. Самое главное осталось.");
  TypeText("Илья: Что ещё может быть главным? Ты огромный жук в моей спальне.");
  TypeText("Жук: Почему я сел именно на кровать.");
  TypeText("Илья: Хорошо. Почему именно на неё?");
  TypeText("Жук: Ты на ней давно не спишь. Только лежишь и смотришь в потолок.");
  TypeText("Илья: Это почти одно и то же.");
  TypeText("Жук: Нет. После сна встают.");
  TypeText("Илья: Всё. Хватит. Это моя кровать, и тебе надо с неё слезть.");
  TypeText("Жук: Знаю, что твоя. Но слезать не хочу. Здесь тепло.");
  beetleDialogueStage = 4;
  dBeatle.SetOptionState(8, eOptionOff);
  dBeatle.SetOptionState(9, eOptionOff);
  dBeatle.SetOptionState(10, eOptionOff);
  dBeatle.SetOptionState(11, eOptionOff);
  dBeatle.SetOptionState(12, eOptionOn);
  dBeatle.SetOptionState(13, eOptionOn);
  dBeatle.SetOptionState(14, eOptionOn);
  dBeatle.SetOptionState(15, eOptionOn);
return
@12
  TypeText("Илья: Я сейчас тебя просто сдвину. Хотя бы к стене.");
  TypeText("Жук: Попробуй. Только кровать не сломай.");
  TypeText("Кровать скрипит. Жук остаётся на месте.");
  TypeText("Илья: Ты вообще не двигаешься. Как будто я толкаю шкаф.");
  TypeText("Жук: Шкаф пустой. Я тяжёлый.");
