          <Dialog>
            <ID>4</ID>
            <Name>dUnder_bed</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  if (packofcigarettes == false)
  {
    TypeText("Вы вытягиваете руку и пытаетесь нащупать что-то вслепую.");
    TypeText("Среди фантиков, старых оберток и закатившихся рублевых монеток вам попадается что-то прямоугольное и хрустящее. Ну конечно! Где же она еще могла быть?");
    TypeText("Получен предмет 'Пачка сигарет'");
    player.AddInventory(iCigarettes);
    packofcigarettes = true;
  }
  else
  {
    TypeText("Там никого нет.");
  }
stop
@2
stop
]]></Script>
