              </DialogOption>
              <DialogOption>
                <ID>2</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Знаете, с выходом из дома у меня сейчас некие трудности...</Text>
              </DialogOption>
              <DialogOption>
                <ID>3</ID>
                <Say>False</Say>
                <Show>True</Show>
