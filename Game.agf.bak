          <Dialog>
            <ID>12</ID>
            <Name>dBum</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
option-off 4
option-off 5
option-off 6
option-off 7
return

@1
  cBum.LockView(cBum.SpeechView); // Включаем анимацию рта
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Человек. Которому зябко на улице.");
  TypeText(">Бомж: И который очень хочет курить.");
  cBum.UnlockView();
option-off 1

return
@2
  FadeOut(2);
  Wait(120);
  aSmoke.Play();
  player.x = 1270; 
  player.y = 925;
  player.LockView(ILYA_ON_STAIRS);
  FadeIn(2);
  Wait(40);
option-off 1
option-off 2
option-on 4
option-on 5
return
@3
  cBum.LockView(cBum.SpeechView);
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Шатаешься. Все бегаешь, суетишься. Потому никуда и не можешь прийти.");
  TypeText(">Бомж: Так никогда не оказаться на своем месте, парень.");
  cBum.UnlockView();
option-off 3
return

@4
  cBum.LockView(cBum.SpeechView); // Включаем анимацию рта
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  cBum.UnlockView();
  TypeText(">Бомж: Зачем мне? Здесь тепло. Батареи греют. Ветер не дует. Менты не гоняют.");
  TypeText("Антон: Вы не понимаете - тут что-то происходит. Надо выбираться, а я... короче я не могу найти выход.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Бежать... я много от чего в жизни бегал."); 
  TypeText(">Бомж: От неприятностей, от долгов, от женщин, от жизни - от всего."); 
  TypeText(">Бомж: Вот только когда бежишь, всегда оказываешься вот в такой бетонной коробке.");
  TypeText(">Бомж: Где воняет ссаниной.");
  cBum.UnlockView();
option-off 4
return
@5
  TypeText("Антон: Что-то странное происходит...");
  TypeText("Антон: С тех пор, как я переехал сюда.");
  TypeText("Антон: Мне постоянно кажется, что в квартире кроме меня кто-то есть.");
  TypeText("Антон: А сейчас там нет света, хотя электричество есть на всех этажах.");
  TypeText("Антон: И... я не могу выйти из дома.");
  TypeText("Антон: Подъезд куда-то исчез. Осталась только лестница вниз.");
  TypeText("Антон: В темноту.");
  TypeText("Антон: Не знаю, зачем это все говорю.");
  Wait(120);
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Говори, парень, авось полегчает.");
  TypeText(">Бомж: Ночь - она всегда долгая, а эта будет длинее прочих.");
  TypeText(">Бомж: Времени у нас - до рассвета.");
  TypeText(">Бомж: Так чего же ты хочешь?");
  cBum.UnlockView();
option-off 4
option-on 6
option-on 7
return
@6
  TypeText("Антон: Я хочу просто вернуться домой.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Домой, говоришь?");
  cBum.UnlockView();
  Wait(120);
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Хорошее слово. Теплое. Но знаешь, что я тебе скажу, парень?");
  TypeText(">Бомж: Ты не хочешь домой. Ты хочешь вернуться назад.");
  TypeText(">Бомж: Ты устал, тебе страшно. Ты думаешь закрыться за дверью, провернуть все замки и оказаться в месте, где тебя когда-то любили. Когда-то давно, парень. Хочешь вернуться в прошлое.");
  TypeText(">Бомж: Носишь его, как тяжелый мешок за плечами.");
  TypeText(">Бомж: Я же вижу. Брось его. Посмотри на меня - вот я дома.");
  cBum.UnlockView();
option-off 6
option-off 7
option-on 8
return
@7
  TypeText("Антон: Здесь творится какое-то безумие. Я просто хочу отсюда выбраться.");
  cBum.LockView(cBum.SpeechView); 
  cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
  TypeText(">Бомж: Можно сбежать из панельки, парень. Но, как говорится, панелька не уйдет мз тебя.");
  TypeText(">Бомж: Знаешь, что я сам понял, когда стер ноги до крови?");
  TypeText(">Бомж: Настоящий побег - это побег от самого себя.");
  TypeText(">Бомж: Говорят, что это невозможно. Но это, как раз, лучше всего. И это - самое правильное.");
  TypeText(">Бомж: Когда удалось сбежать от себя - тебе становится все равно, где ты и кто ты.");
  TypeText(">Бомж: Тогда-то ты и становишься свободным.");
  cBum.UnlockView();
option-off 6
option-off 7
option-on 8  
return
@8
  TypeText("Антон: Здесь творится какое-то безумие. Я просто хочу отсюда выбраться.");
return
@9
return
@10
return
]]></Script>
