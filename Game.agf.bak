    <Dialogs>
      <DialogFolder Name="Main">
        <SubFolders />
        <Dialogs>
          <Dialog>
            <ID>0</ID>
            <Name>dBathchoice</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return 
@1
  FadeOut(2);
  Wait(120);
  FadeIn(2);
  TypeText("Преодолевая апатию и некоторую брезгливость вы все же снимаете с себя и одежду и становитесь на холодную эмалированную поверхность.");
  aShower.Play();
  TypeText("В голове свербит привычная мысль: 'А смысл?' Однако горячая вода и аромат какого-то дешевого шампуня делает свое дело.");
  TypeText("Постояв несколько минут под душем, вы чувствуете себя значительно лучше.");
  is_washed = true;
  ChangeMood(1);
stop
@2
  TypeText("Темно и несет плесенью. Мне совершенно точно не хочется там копаться без веской причины.");
return
@3
stop
]]></Script>
