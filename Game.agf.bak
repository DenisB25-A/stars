            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  TypeText("В темноте под кроватью белеет клочок бумаги.");
  TypeText("Вы протягиваете руку и вытаскиваете его, поднося к свету.");
  ReadAndAddNote(4);
  TypeText("Это мой детский рисунок.");
  TypeText("В памяти начинает шевелиться что-то темное и склизкое, что-то, что вы годами пытались загнать как можно глубже.");
  TypeText("Откуда он здесь?");
stop
@2
