            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  aFridge_close.Play();
  TypeText("Дверца не открывается.");
  TypeText("Может примерзла? Не знал, что такое бывает. Ладно. Сейчас я все равно не голоден.");
stop
@2
stop
]]></Script>
