          <Dialog>
            <ID>7</ID>
            <Name>dBookshelf</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  TypeText("Вы пробегаете взглядом по угрюмым советским многотомникам, занимающим полки, и он останавливается на невзрачном корешке бордового цвета.");
  TypeText("Вы встаете на цыпочки и тянетесь к верхней полке. В лицо летит облачко пыли.");
  TypeText("Герман Гессе 'Степной волк'. Странный выбор, но ладно.");
  TypeText("Получен предмет: 'Книга'");
  player.AddInventory(iBook);
option-off 1;
option-on 3;
stop
@2
  if (prompts == 3)
  {
    TypeText("Тоненькая книжица 'Агаты Кристи' уместилась на нижней полке, в дальнем ряду. Вы бы и не заметили, если б не знали, что ищете наверняка.");
    TypeText("Она легко распахивается на середине, заложенная небольшим металлическим предметом вместо закладки.");
    TypeText("Это не ключ. Между страниц - обычная заколка для волос.");
    TypeText("Получен предмет: 'Женская заколка для волос.'");
    player.AddInventory(iBarrete);
// ИСПРАВЛЕНИЕ: Выключаем опцию НАВСЕГДА
    dBookshelf.SetOptionState(2, eOptionOffForever);
  }
  else
  {
    TypeText("Вы осматриваете полки, пытаясь уловить хоть какой-нибудь след нарушенного порядка в рядах строго выстроенных книг. Однако все корешки выглядят одинаково. Вы берете несколько наугад, пролистываете, но внутри - ничего.");
    TypeText("Так можно копаться хоть до самого вечера.");
  }
return
@3
  TypeText("На сегодня уже есть, чем заняться.");
return
@4
stop

]]></Script>
