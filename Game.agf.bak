            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  FadeOut(2); 
  AudioChannel *channel1 = aUnder_bed.Play();

  Wait(120);   
  FadeIn(2); 
  TypeText("Черт...");
  TypeText("Вы резко отдергиваете руку, и видите, как на безымянном пальце выступает капелька крови.");
  TypeText("Вы вновь наклоняетесь и уже более осторожно протягиваете руку в темноту.");
  TypeText("Пальцы нащупывают бугристое от ржавчины лезвие.");
  TypeText("Получен предмет: 'Ржавый нож'");
  player.AddInventory(iRastyKnife);
  Preamble_under_bed = true;
stop
@2
stop
]]></Script>
