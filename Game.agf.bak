            <Name>dKnife</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
return
@1
  player.AddInventory(iKnife);
  TypeText("Получен предмет: 'Кухонный нож'");
  knife = true;
stop
@2
stop
]]></Script>
            <DialogOptions>
              <DialogOption>
                <ID>1</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Взять нож</Text>
              </DialogOption>
              <DialogOption>
                <ID>2</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text>Уйти</Text>
              </DialogOption>
            </DialogOptions>
          </Dialog>
