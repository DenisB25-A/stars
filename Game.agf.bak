              </DialogOption>
              <DialogOption>
                <ID>7</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Я хочу уйти отсюда.</Text>
              </DialogOption>
              <DialogOption>
                <ID>8</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Спасибо, я над этим подумаю.</Text>
              </DialogOption>
              <DialogOption>
