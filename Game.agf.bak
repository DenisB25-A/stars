          <Dialog>
            <ID>6</ID>
            <Name>dKitchen_sink</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
  TypeText("Что у нас тут интересно!?");
return
@1
  if (IsNight == false)
  {
    TypeText("На полках стоит мука, сахар, сода и ещё какие-то крупы. Не помню, чтобы я когда-то их использовал. Обычно мама готовила. А я был беспомощен: и пельмени сварить не в состоянии.");
option-on 2;
option-off 1;
  }
  else
  {
    TypeText("Не вижу ничего, что могло бы мне пригодиться.");
option-off 1;
  }
return
@2
  cEgo.AddInventory(iSugar);
  TypeText("Сахар, наверное, пригодится.");
option-off-forever 2;
return
@3
  if (IsNight == false)
  {
    TypeText("Внутри почти пусто, но пахнет неприятно.");
    TypeText("Поворошив рукой картофельные очистки, вы нащупываете что-то маленькое и металлическое.");
    TypeText("На свет появляется крохотная шайба с логотипом, знакомым с детства: мазь 'Звездочка'.");
    TypeText("Не понимая, зачем она вам, вы кладете ее в карман.");
    player.AddInventory(iStar_salve);
    TypeText("Получен предмет: 'мазь Звездочка'.");
  }
  else
  {
    TypeText("За день произошло так много всего, что перспектива покопаться в мусоре уже не пугает.");
    TypeText("Разворошив гниющую кучку, вы находите небольшой плотный листок, сложенный вдвое. Развернув его и протерев рукавом, вы с удивлением понимаете, что это фотография.");
    ReadAndAddNote(9);
    TypeText("На ней я, а вот девочку я не помню, хотя она почему-то кажется мне знакомой.");
  }
option-off 3;
return
@4
stop
@5
stop
]]></Script>
            <DialogOptions>
              <DialogOption>
                <ID>1</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Осмотреть полки</Text>
              </DialogOption>
              <DialogOption>
