          <Dialog>
            <ID>6</ID>
            <Name>dKitchen_sink</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
  TypeText("Что у нас тут интересно!?");
option-off 2;
option-off 4;
return
@1
  TypeText("На полках стоит мука, сахар, сода и ещё какие-то крупы. Не помню, чтобы я когда-то их использовал. Обычно мама готовила. А я был беспомощен: и пельмени сварить не в состоянии.");
option-on 2;
option-off 1;
return
@2
  cEgo.AddInventory(iSugar);
  TypeText("Сахар, наверное, пригодится");
option-off 2;
return
@3
  TypeText("Там почти ничего нет, хотя пахнет неприятно.");
  TypeText("Что это? Жук? Нет...");
  TypeText("Таракан!");
  TypeText("Смотрит на меня. Шевелит своими усищами.");
option-on 4;
option-off 3;
return
@4
stop
@5
stop
]]></Script>
