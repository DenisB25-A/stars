                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Вы пытались выйти на улицу?</Text>
              </DialogOption>
              <DialogOption>
                <ID>5</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">Что-то странное происходит.</Text>
              </DialogOption>
              <DialogOption>
