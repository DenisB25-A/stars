// room script file
bool dark_coridor = false;

function hD_corridor_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
    aDoor_sound3.Play();
    player.ChangeRoom(15, 1352, 968); 
}

function hBedroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
      player.ChangeRoom(13, 1576, 996);
}

function hStoreroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Нет. Туда я точно не пойду.");
}


function hDarkness_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (dark_coridor == false)
  {
    TypeText("Во всей квартире нет света. Совсем не вовремя, черт возьми. Может выбило пробки?");
    FadeOut(3);
    aScary_coridor.Play();
  // 1. Блокируем управление на время сцены, чтобы игрок никуда не нажал
    cEgo.SetAsPlayer(); // на всякий случай проверяем, что это активный игрок
    
    // 2. Делаем игрока невидимым (он исчезает из кадра)
    cEgo.Transparency = 100; 

    // 3. Начинаем поочередно менять бэкграунды (эффект приближения)
    // Допустим, Frame 0 — обычный вид, 1 — чуть ближе, 2 — крупный план
    
    SetBackgroundFrame(1);
    FadeIn(3);
    Wait(160); // задержка в циклах (40 циклов = примерно 1 секунда при 40 FPS)
    
    SetBackgroundFrame(2);
    Wait(160); 
    
    SetBackgroundFrame(3);
    Wait(120); 
    
    SetBackgroundFrame(4);
    Wait(20); 
    // Если у тебя больше фреймов, просто продолжи эту цепочку:
    // SetBackgroundFrame(3);
    // Wait(40);

    // 4. На последнем бэкграунде запускаем звук шагов
    // Замени aSteps на точное название твоего аудио-файла в AGS
    AudioChannel *channel1 = aScary_steps.Play();
      
      // Ждем, пока первый звук полностью проиграется
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); // Ставим игру на микро-паузу в 1 кадр, пока звук идет
    }

    // 5. Возвращаем всё назад (если нужно после сцены вернуть игрока и обычный фон)
    // Если сцена должна так и остаться на крупном плане, эти строчки можно не писать
    SetBackgroundFrame(0);
    cEgo.Transparency = 0;
    dark_coridor = true;
    TypeText("Черт, черт, черт... Клянусь, я слышал чьи-то шаги.");
    TypeText("Антон: Здесь кто-нибудь есть?");
  }
  else
  {
    TypeText("Серьезно? Ни за какие коврижки. Надо как-то включить свет.");
  }
}

function room_Load()
{
  SetBackgroundFrame(0);
}

function room_Leave()
{
  aScary_coridor.Stop();
}
