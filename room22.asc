// room script file
bool darknessfirsttime = true;

function room_FirstLoad()
{
  Go_to_dark = true;
}

function hDarkness_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (darknessfirsttime == true)
  {
    TypeText("Вы делаете всего пару шагов и понимаете, что не можете различить даже собственных рук. Мрак кажется почти осязаемым, будто дрожащий на сквозняке студень.");
    TypeText("Спускаться дальше - плохая идея. Я не вижу дальше своего носа.");
    darknessfirsttime = false;
    
  }
  else
  {
    gDarkOverlay.Transparency = 100;
    gDarkOverlay.Visible = true;

    int trans = 100;
    while (trans > 0)
    {
      trans -= 5;
      gDarkOverlay.Transparency = trans;
      Wait(1); // ждем 1 кадр для обновления экрана
    }
    DisableInterface(); // Блокируем управление и курсор
    Wait(40);
    aWhispers.Play();
    TypeText("Где-то далеко внизу едва различимо капает вода, и бьется запертый в бетонных стенах ветер. Если долго вслушиваться, то возникает очень нехорошее чувство, что там, в темноте, кто-то шепчет.");
    
    
    Wait(180);
    
    
// --- Плавное ОСВЕТЛЕНИЕ (от 0 к 100) ---
    trans = 0; // Переменная уже есть, просто задаем стартовое значение
    while (trans < 100)
    {
      trans += 5; // ПРИБАВЛЯЕМ прозрачность, чтобы экран светлел
      gDarkOverlay.Transparency = trans;
      Wait(1); 
    }
    
    gDarkOverlay.Visible = false;
    aWhispers.Stop();
    EnableInterface();  // Возвращаем управление игроку
  }
}

function hUp_tohomeless_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(19, 404, 968); 
}
