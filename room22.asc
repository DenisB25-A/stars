// room script file
bool darknessfirsttime = true;

function room_FirstLoad()
{
  Go_to_dark = true;
}

function hDarkness_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (darknessfirsttime == true)
  {
    TypeText("Вы делаете всего пару шагов и понимаете, что не видите дальше своего носа. Мрак кажется почти осязаемым, будто дрожащий на сквозняке студень.");
    TypeText("Спускаться дальше - плохая идея. Любой неосторожный шаг, и я рискую свернуть себе шею.");
    darknessfirsttime = false;
    
  }
  else
  {
    DisableInterface(); // Блокируем управление и курсор
    gDarkOverlay.Transparency = 100;
    gDarkOverlay.Visible = true;
    Mouse.Visible = false;
    int trans = 100;
    while (trans > 0)
    {
      trans -= 5;
      gDarkOverlay.Transparency = trans;
      Wait(1); // ждем 1 кадр для обновления экрана
    }
    Wait(40);
    TypeText("Где-то далеко внизу едва различимо капает вода и бьется запертый в бетонных стенах ветер. Если долго вслушиваться, то возникает очень нехорошее чувство, будто там, в темноте, кто-то шепчет.");
    
    AudioChannel *channel1 = aWhispers2.Play();

    while (channel1 != null && channel1.IsPlaying)
    {
        Wait(1);
    }
    
// --- Плавное ОСВЕТЛЕНИЕ (от 0 к 100) ---
    trans = 0; // Переменная уже есть, просто задаем стартовое значение
    while (trans < 100)
    {
      trans += 5; // ПРИБАВЛЯЕМ прозрачность, чтобы экран светлел
      gDarkOverlay.Transparency = trans;
      Wait(1); 
    }
    
    gDarkOverlay.Visible = false;
    EnableInterface();  // Возвращаем управление игроку
    Mouse.Visible = true;
    TypeText("Мурашки по коже...");
  }
}

function hUp_tohomeless_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Go_to_dark == true)
  {
    player.ChangeRoom(18, 404, 968, eDirectionRight); 
  }
  else
  {
    player.ChangeRoom(21, 340, 968);
  }
}
