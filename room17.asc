// room script file
bool neighbor_door = false;

function hGo_to_deep_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(18, 1253, 968); 
}

function hEnter_to_main_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(15, 655, 968); 
}

function hNeighbor_door_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (neighbor_door == false)
  {
    TypeText("Квартира соседа. Я слышал, что он пропал примерно месяц назад. Кажется, в газетах об этом писали. Раньше я не задумывался над этим всерьез, но сейчас его исчезновение вызывает у меня нехорошие чувства.");
    neighbor_door = true;
  }
  else
  {
    TypeText("Насколько знаю, он жил один. Так что мне никто не откроет.");
  }
  
  //player.ChangeRoom(48, 720, 1030); 
}

function hScribbled_walls_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стена загажена скверного вида граффити, объявлениями, похабщиной и матерными стишками. Кое-что в этом доме никогда не меняется.");
}
