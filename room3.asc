// room script file
bool pfotografsFirstTime = true;

function hLiving_room_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(2, 970, 1043); 
  aDoor_sound.Play();
}

function hDrawer_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(8, 0, 0); // Переносим игрока в комнату шкафа (номер 2)
  aDrawer_open.Play();
}

function oLaptop_Interact(Object *theObject, CursorMode mode)
{
  player.ChangeRoom(9, 0, 0);
}

function htable_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(10, 0, 0); 
}

function hShelfs_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(11, 0, 0); // Переносим игрока в комнату полок (11)
}


function hPainting_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Кажется, это называется «панно». В Союзе за такими охотились, чтобы занять каждый свободный угол квартиры. Теперь они никому не нужны.");
}

function hphotografs_Interact(Hotspot *theHotspot, CursorMode mode)
{
// Проверяем, стоит ли Илья в нужном регионе
  if (pfotografsFirstTime == true) 
    {
      // 1. Выводим твой атмосферный текст
      TypeText("Картины в рамках, пара приколотых бумажных листков. Один из них отклеился и спланировал на спинку дивана");
      
      // 2. ВМЕСТО трех строчек старого кода вызываем нашу умную функцию. 
      // Передаем ей ID 3 (видимо, это ID записки с дивана)
      ReadAndAddNote(3); 
      
      // 3. ВАЖНО: Выключаем флаг первого раза, чтобы записка не дублировалась
      pfotografsFirstTime = false; 
      TypeText("Не прошло и месяца после этой записки, как мамы не стало...");
      prompts = prompts + 1;
    }
    else
    {
      // Опционально: что скажет Илья, если кликнуть сюда во второй раз
      TypeText("Пара дешевых картин и заметки.");
    }
  }


function hWindow_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Как долго я спал? Наверно, сейчас уже полдень.");
}

function hNotes_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стена увешана листками-напоминалками.");
  TypeText("Под конец мама стала забывать даже самые элементарные вещи.");
}

function hBookshelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
TypeText("Щербатый и темный шкаф нависает над вами, полный книг, которые вы так и не удосужились прочитать.");
TypeText("Но, может быть, начать все же не поздно?");

// Поиск книги с закладкой: нужна записка матери
if (prompts == 1 || prompts == 3)
{
  if (dBookshelf.GetOptionState(2) != eOptionOffForever)
    dBookshelf.SetOptionState(2, eOptionOn);
}
else if (dBookshelf.GetOptionState(2) != eOptionOffForever)
{
  dBookshelf.SetOptionState(2, eOptionOff);
}


// Поиск книги из библиотеки: найден формуляр
if (prompts == 2)
{
  if (dBookshelf.GetOptionState(3) != eOptionOffForever)
    dBookshelf.SetOptionState(3, eOptionOn);
}
else if (dBookshelf.GetOptionState(3) != eOptionOffForever)
{
  dBookshelf.SetOptionState(3, eOptionOff);
}
  dBookshelf.Start();
}
