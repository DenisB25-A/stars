// room script file

function hLiving_room_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(2, 970, 1042); 
  }
}

function hDrawer_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(8, 0, 0); // Переносим игрока в комнату шкафа (номер 2)
}
