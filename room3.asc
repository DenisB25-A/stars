// room script file
bool pfotografsFirstTime = true;

function hLiving_room_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(2, 970, 1043); 
    aDoor_sound.Play();
  }
}

function hDrawer_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
  player.ChangeRoom(8, 0, 0); // Переносим игрока в комнату шкафа (номер 2)
  aDrawer_open.Play();
  }
}

function oLaptop_AnyClick(Object *theObject, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
  player.ChangeRoom(9, 0, 0);
  }
}

function htable_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
  player.ChangeRoom(10, 0, 0); 
  }
}

function hShelfs_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
  player.ChangeRoom(11, 0, 0); // Переносим игрока в комнату полок (11)
  }
}


function hPainting_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
  TypeText("Кажется, это называется 'Панно'. В Союзе за подобным охотились, чтобы забить каждый свободный угол квартиры. Теперь они никому не нужны.");
  }
}

function hphotografs_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
// Проверяем, стоит ли Илья в нужном регионе
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    if (pfotografsFirstTime == true) 
    {
      // 1. Выводим твой атмосферный текст
      TypeText("Картины в рамках, пара приколотых бумажных листков. Один из них отклеился и спланировал на спинку дивана");
      
      // 2. ВМЕСТО трех строчек старого кода вызываем нашу умную функцию. 
      // Передаем ей ID 3 (видимо, это ID записки с дивана)
      ReadAndAddNote(3); 
      
      // 3. ВАЖНО: Выключаем флаг первого раза, чтобы записка не дублировалась
      pfotografsFirstTime = false; 
      TypeText("Из больницы мама уже не вышла...");
    }
    else{
      // Опционально: что скажет Илья, если кликнуть сюда во второй раз
      TypeText("Пара дешевых картин и заметки.");
    }
    }
  }


function hWindow_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Как долго я спал? Наверно, сейчас уже полдень.");
}

function hNotes_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стена истыкана листками-напоминалками.");
  TypeText("Под конец мама стала забывать даже самые элементарные вещи.");
}

function hBookshelf_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Щербатый и темный, книжный шкаф нависает на вами, будто какой-то алтарь, посвященный давно забытым бумажным богам.");
  TypeText("Полный книг, которые вы так и не удосужились прочитать и уже вряд ли прочтете.");
  TypeText("Но, может быть, все же не поздно начать?");
  dBookshelf.Start();
}
