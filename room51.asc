// room script file

function room_AfterFadeIn()
{
  int trans = 0;

  // Плавно открываем изображение
  while (trans < 100)
  {
    trans += 1;
    gDarkOverlay.Transparency = trans;
    Wait(1);
  }

  gDarkOverlay.Visible = false;
  gDarkOverlay.Transparency = 100;
  Mouse.Visible = true;
  TypeText("Чего не скажешь о вас.");
  TypeText("Медленно сгибая и разгибая пальцы, вы с облегчением понимаете, что рука работает. Чудо, что вы вообще остались в живых.");
  TypeText("Однако кое-что будет напоминать вам о вашем поступке.");
  TypeText("Вы получили «Шрам от ожога». Он останется с вами на всю жизнь.");
  Wound = true;
  Electricity = true;
  gDarkOverlay.Visible = false;
  gDarkOverlay.Transparency = 100;
  gDarkOverlay.ZOrder = 1;
  player.ChangeRoom(50, 1310, 942, eDirectionRight);

}

function room_Load()
{
  gDarkOverlay.ZOrder = 101;
  gDarkOverlay.Transparency = 0;
  gDarkOverlay.Visible = true;
}
