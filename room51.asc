// room script file

function room_AfterFadeIn()
{
  TypeText("Чего не скажешь о вас.");
  TypeText("Вы медленно сжимаете и разжимаете пальцы. Рука работает. Пожалуй, чудо, что вы вообще остались в живых.");
  TypeText("Однако кое-что будет напоминать вам о вашем поступке до конца жизни.");
  TypeText("Вы получили Незаживающую рану. Она останется с вами навсегда.");
  player.ChangeRoom(50, 1310, 942, eDirectionRight);
}
