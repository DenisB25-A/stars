String GetClockwiseNeighbors(String vertex)
{
  if (vertex == "a") return "lfhg";
  if (vertex == "b") return "jcie";
  if (vertex == "c") return "dbhl";
  if (vertex == "d") return "eicg";
  if (vertex == "e") return "bidl";
  if (vertex == "f") return "ijga";
  if (vertex == "g") return "dfha";
  if (vertex == "h") return "jgac";
  if (vertex == "i") return "bfde";
  if (vertex == "j") return "hflb";
  if (vertex == "l") return "ejca";

  return "";
}

String GetNextEdge(String previousEdge, int position)
{
  if (currentEdge == null) {
    previousEdge = "l-a";
  }
  
  // Формат previousEdge: "a-c".
  // Это означает, что мы пришли из a в c.
  if (previousEdge.Length != 3 || previousEdge.Substring(1, 1) != "-")
    return "";

  if (position < 1 || position > 4) 
    position = 1;

  if (previousPosition < 1 || previousPosition > 4) 
    previousPosition = 1;
    
  String previousVertex = previousEdge.Substring(0, 1);
  String currentVertex = previousEdge.Substring(2, 1);
  String neighbors = GetClockwiseNeighbors(currentVertex);
  //String neighborsOrb = GetClockwiseNeighbors(currentVertex);
  //String neighbors2 = String.Format("%s%s", neighborsOrb, neighborsOrb);
  //String neighbors = neighbors2.Substring(previousPosition - 1, 4);

  int inputIndex = neighbors.IndexOf(previousVertex);

  // Предыдущего ребра нет в графе.
  if (inputIndex < 0)
    return "";
    
  int roomShift = (4 + (position - 1) - (previousPosition - 1)) % 4;
  int outputIndex = (inputIndex + roomShift) % 4;
  //Display(String.Format("inputIndex: %d position: %d outputIndex: %d neighbors: %s",  inputIndex,  position, outputIndex,  neighbors));
  String nextVertex = neighbors.Substring(outputIndex, 1);

  return String.Format("%s-%s", currentVertex, nextVertex);
}

function room_AfterFadeIn()
{
  oManeken.SetView(MANEKEN);
}

function room_RepExec()
{

  // Если анимация манекена сейчас НЕ запущена встроенным движком
  if (!oManeken.Animating) 
  {
    // Запускаем её ОДИН ОДНОКРАТНЫЙ РАЗ (eOnce) на минимальной скорости (0)
    // Движок просто отыграет твои 5 и 35 кадров без ухода в цикл фриза
    oManeken.Animate(0, 0, eOnce, eNoBlock);
  }

}

function oManeken_Interact(Object *theObject, CursorMode mode)
{
  if (maneken == false) 
  {
    if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
    {
      TypeText("Слава богу... это всего лишь манекен.");
      maneken = true;
    }
  }
  else if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    TypeText("Деревянный манекен, подвешенный на веревке. Но выглядит жутко.");
    TypeText("Я мог бы попытаться снять его, однако мне нечем перерезать канат.");
  }
}

function hSky_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (maneken == false) {
    TypeText("Глядя на небо, становится страшно - звезды огромны, как изумруды. И я не узнаю ни одного созвездия.");
    TypeText("Если долго всматриваться - кружится голова.");
  } else {
    ReadAndAddNote(6);
  }
}

function pass_through()
{
  player.ChangeRoom(33, 450, 931);
}
function hExit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  //if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  //{
  //  player.ChangeRoom(31, 996, 996); 
  //}
  
  currentEdge = GetNextEdge(currentEdge, 1);
  previousPosition = 1;
  TypeText(currentEdge.Append(String.Format(" %d", previousPosition)));
  
    if (currentEdge.Substring(2, 1) == "b") {
    pass_through();
} else {
    player.ChangeRoom(32, 250, 960);
    aWoodenDoorOpeningCreaking.Play();
}
}

