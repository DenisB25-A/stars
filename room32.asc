function oManeken_UseInv(Object *theObject, CursorMode mode)
{
    if (player.ActiveInventory == iRastyKnife &&
    Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
      {
      // --- УСПЕШНОЕ ДЕЙСТВИЕ ---
    FadeOut(4); // Закрыл глаза (очень быстро)
    AudioChannel *channel1 = aRop_cut.Play();
    
    // Ждем, пока первый звук полностью проиграется
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); // Ставим игру на микро-паузу в 1 кадр, пока звук идет
    }
    // 2. Как только первый затих, запускаем второй звук
    AudioChannel *channel2 = aFall.Play();
    
    // Точно так же ждем окончания второго звука
    while (channel2 != null && channel2.IsPlaying) 
    {
      Wait(1);
    }
      oManeken.Visible = false;
      oManeken_sitting.Visible = true;
      maneken_cut = true;
      FadeIn(4);  // Открыл глаза
      

      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto; // возвращаем обычный курсор
      }
    else
    {
      TypeText("Ума не приложу, что с этим делать.");
    }
  }


function oManeken_sitting_Interact(Object *theObject, CursorMode mode)
{
  // 1. Проверяем, стоит ли игрок в нужном месте
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    // 2. Если стоит, проверяем, брал ли он записку
    if (maneken_note == false) 
    {
      TypeText("Это всего лишь деревянная кукла в человеческий рост, однако она чем-то неуловимо пугает.");
      TypeText("Вы с опаской обшариваете карманы. Они пусты. Затем замечаете глубокое отверстие на месте рта. Оттуда торчит скомканный бумажный листок.");
      TypeText("Вы достаете и аккуратно расправляете его.");
      ReadAndAddNote(6);
      maneken_note = true;
    }
    else 
    {
      // Этот текст сработает, если игрок на регионе, но записка УЖЕ взята
      TypeText("Манекен сидит неподвижно, уставившись пустыми глазницами в пол. Рядом с ним вы чувствуете себя неуютно.");
    }
  }
}



function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  int currentBg = GetBackgroundFrame();
  
  if (currentBg == 0) 
  {
    aTeleport.Play();
    ResetLabyrinthState();
    player.ChangeRoom(31, 992, 996);
  }
  else if (currentBg == 1) 
  {
    // Действие, если включен Кадр 1 (дверь светится изумрудным светом)
    TypeText("Глухая стена. Двери обратно здесь нет.");
  }

}

function oArrows_Interact(Object *theObject, CursorMode mode)
{
  player.ChangeRoom(42, 0, 0);
}
