// room script file
bool maneken = false;
bool maneken_note = false;
bool maneken_cut = false;
bool arrowsExitUsed = false;
bool second_room = false;

String currentEdge;
int previousPosition;
int labyrinthStepCount = 0;

// Спрайты покачивающегося манекена
DynamicSprite *manekenCW2;
DynamicSprite *manekenCW4;
DynamicSprite *manekenCCW2;
DynamicSprite *manekenCCW4;

// Исходное состояние изображения
int manekenSourceGraphic = 0;
int manekenSourceX;
int manekenSourceY;
int manekenSourceWidth;
int manekenSourceHeight;
int manekenSourceScale;
int manekenSourceBaseline;

// Управление покачиванием
bool manekenSwayReady = false;
int manekenSwayStep = 0;
int manekenSwayTimer = 0;


function ResetLabyrinthState()
{
  currentEdge = null;
  previousPosition = 0;
  arrowsExitUsed = false;
  
  labyrinthStepCount = 0;
}

function room_Load()
{
String currentVertex = "a"; // По умолчанию считаем, что мы на старте

    
    // Вытягиваем текущую вершину из ребра, если оно уже существует
    if (currentEdge != null && currentEdge.Length >= 3) {
        currentVertex = currentEdge.Substring(2, 1);
    }

    // Рисунок на полу виден только в стартовой комнате
    if (currentVertex == "a")
      oArrows.Visible = true;
    else
      oArrows.Visible = false;
      
    // Если мы в стартовой точке "a"
    if (currentVertex == "a") {
        SetBackgroundFrame(0);
        // Проверяем, висит манекен или уже сидит
        if (maneken_cut == false) {
            oManeken.Visible = true;
            oManeken_sitting.Visible = false;
        } else {
            oManeken.Visible = false;
            oManeken_sitting.Visible = true;
        }
    } 
    // Если мы ушли вглубь неевклидова лабиринта (любые другие узлы кроме "a")
    else {
        SetBackgroundFrame(1);
        oManeken.Visible = false;
        oManeken_sitting.Visible = false;
    }

}

function PrepareManekenSway()
{
  if (!manekenSwayReady)
  {
    // Сохраняем исходное изображение и положение
    manekenSourceGraphic = oManeken.Graphic;
    manekenSourceX = oManeken.X;
    manekenSourceY = oManeken.Y;

    manekenSourceWidth = Game.SpriteWidth[manekenSourceGraphic];
    manekenSourceHeight = Game.SpriteHeight[manekenSourceGraphic];

    manekenSourceScale = oManeken.Scaling;
    manekenSourceBaseline = oManeken.Baseline;

    // Создаём копии исходного изображения
    manekenCW2 = DynamicSprite.CreateFromExistingSprite(manekenSourceGraphic, true);
    manekenCW4 = DynamicSprite.CreateFromExistingSprite(manekenSourceGraphic, true);

    manekenCCW2 = DynamicSprite.CreateFromExistingSprite(manekenSourceGraphic, true);
    manekenCCW4 = DynamicSprite.CreateFromExistingSprite(manekenSourceGraphic, true);

    // Поворачиваем копии по часовой стрелке
    manekenCW2.Rotate(2);
    manekenCW4.Rotate(4);

    // Против часовой стрелки
    manekenCCW2.Rotate(358);
    manekenCCW4.Rotate(356);

    manekenSwayReady = true;
  }

  // Фиксируем масштаб объекта
  oManeken.ManualScaling = true;
  oManeken.Scaling = manekenSourceScale;

  // Сохраняем исходный порядок отрисовки,
  // если базовая линия не была задана вручную
  if (manekenSourceBaseline == 0)
    oManeken.Baseline = manekenSourceY;
}

function SetManekenSwayPose(int angle)
{
  DynamicSprite *pose = null;

  float sinA = 0.0;
  float cosA = 1.0;

  // Выбираем нужное изображение и угол
  if (angle == 2)
  {
    pose = manekenCW2;
    sinA = 0.0348995;
    cosA = 0.9993908;
  }
  else if (angle == 4)
  {
    pose = manekenCW4;
    sinA = 0.0697565;
    cosA = 0.9975641;
  }
  else if (angle == -2)
  {
    pose = manekenCCW2;
    sinA = -0.0348995;
    cosA = 0.9993908;
  }
  else if (angle == -4)
  {
    pose = manekenCCW4;
    sinA = -0.0697565;
    cosA = 0.9975641;
  }

  // Возвращение в исходное положение
  if (angle == 0)
  {
    oManeken.Graphic = manekenSourceGraphic;
    oManeken.X = manekenSourceX;
    oManeken.Y = manekenSourceY;
    return;
  }

  if (pose == null)
    return;

  // Учитываем масштаб объекта
  float scaleFactor = IntToFloat(manekenSourceScale) / 100.0;

  float originalW = IntToFloat(manekenSourceWidth) * scaleFactor;
  float originalH = IntToFloat(manekenSourceHeight) * scaleFactor;

  float rotatedW = IntToFloat(pose.Width) * scaleFactor;
  float rotatedH = IntToFloat(pose.Height) * scaleFactor;

  // Положение точки крепления относительно исходного изображения
  float localX = IntToFloat(1600 - manekenSourceX);

  int originalHeight = FloatToInt(originalH, eRoundNearest);

  float localY = IntToFloat(90 - (manekenSourceY - originalHeight));

  // Смещение точки крепления относительно центра изображения
  float dx = localX - originalW / 2.0;
  float dy = localY - originalH / 2.0;

  // Новое положение точки крепления после вращения
  float pivotX = rotatedW / 2.0 + dx * cosA - dy * sinA;
  float pivotY = rotatedH / 2.0 + dx * sinA + dy * cosA;

  // Назначаем новое изображение
  oManeken.Graphic = pose.Graphic;

  // Корректируем координаты так, чтобы точка (1600, 90)
  // осталась на прежнем месте
  oManeken.X = FloatToInt(1600.0 - pivotX, eRoundNearest);

  oManeken.Y = FloatToInt(
    90.0 - pivotY + rotatedH,
    eRoundNearest
  );
}

function room_FirstLoad()
{
  Wait(40);
  TypeText("Антон: О Господи.");

  // Начало видения
  FadeOut(30);

  oManeken.Visible = false;
  oManeken_sitting.Visible = false;
  oArrows.Visible = false;

  cEgo.ManualScaling = true;
  cEgo.Scaling = cEgo.Scaling + 15;

  SetBackgroundFrame(2);
  aMirror.Play();
    // Лёгкое затемнение видения
  gDarkOverlay.Transparency = 40;
  gDarkOverlay.Visible = true;
  

  FadeIn(30);
  Wait(30);

  // Возвращение в реальность
  FadeOut(20);
  gDarkOverlay.Visible = false;
  SetBackgroundFrame(0);

  cEgo.Scaling = cEgo.Scaling - 15;
  cEgo.ManualScaling = false;

  oManeken.Visible = true;
  oManeken_sitting.Visible = false;
  oArrows.Visible = true;

  FadeIn(20);

  aHeartbeat.Play();
}

String GetClockwiseNeighbors(String vertex)
{
  if (vertex == "a") return "lfhg";
  if (vertex == "b") return "jcie";
  if (vertex == "c") return "dbhl";
  if (vertex == "d") return "eicg";
  if (vertex == "e") return "bidl";
  if (vertex == "f") return "ijga";
  if (vertex == "g") return "dfha";
  if (vertex == "h") return "jgac";
  if (vertex == "i") return "bfde";
  if (vertex == "j") return "hflb";
  if (vertex == "l") return "ejca";

  return "";
}

String GetNextEdge(String previousEdge, int position)
{
  if (previousEdge == null) {
      previousEdge = "l-a";
  }
  
  // Формат previousEdge: "a-c".
  // Это означает, что мы пришли из a в c.
  if (previousEdge.Length != 3 || previousEdge.Substring(1, 1) != "-")
    return "";

  if (position < 1 || position > 4) 
    position = 1;

  if (previousPosition < 1 || previousPosition > 4) 
    previousPosition = 1;
    
  String previousVertex = previousEdge.Substring(0, 1);
  String currentVertex = previousEdge.Substring(2, 1);
  String neighbors = GetClockwiseNeighbors(currentVertex);

  int inputIndex = neighbors.IndexOf(previousVertex);

  // Предыдущего ребра нет в графе.
  if (inputIndex < 0)
    return "";
    
  int roomShift = (4 + (position - 1) - (previousPosition - 1)) % 4;
  int outputIndex = (inputIndex + roomShift) % 4;
  String nextVertex = neighbors.Substring(outputIndex, 1);

  return String.Format("%s-%s", currentVertex, nextVertex);
}

function room_AfterFadeIn()
{
    // Если игрок вернулся в исходную точку "a",
  // начинаем отсчёт заново
  if (currentEdge != null &&
      currentEdge.Length >= 3 &&
      currentEdge.Substring(2, 1) == "a")
  {
    labyrinthStepCount = 0;
  }
    // Четвертый переход оказался неудачным
  if (labyrinthStepCount >= 4)
  {
    TypeText("Нить кончилась. Если рискну пойти дальше, то могу застрять здесь навечно... Нужно возвращаться, пока еще можно.");

    FadeOut(20);

    ResetLabyrinthState();

    // Возвращаем Антона в начальную точку лабиринта
    player.ChangeRoom(32, 955, 960);
    return;
  }

  // Если включен второй фон (индекс 1) и мы видим его впервые:
  
    if (oManeken.Visible && maneken_cut == false)
  {
    oManeken.SetView(MANEKEN);

    PrepareManekenSway();
    SetManekenSwayPose(0);

    manekenSwayStep = 0;
    manekenSwayTimer = 0;
  }
  
  if (GetBackgroundFrame() == 1 && second_room == false)
  {
    second_room = true; // Сразу ставим флаг, чтобы реплика не повторялась
    
    // Твоя реплика или мысли:
    TypeText("Точно такая же комната. Спокойно, главное не паниковать."); 
  }
    // Третий переход: предупреждаем, что нить почти закончилась
  if (labyrinthStepCount == 3)
  {
    TypeText("Из целого клубка ниток остался жалкий моток. Мне нужно хорошо подумать, куда идти в этот раз.");
  }
}

function room_RepExec()
{
  if (!manekenSwayReady || !oManeken.Visible || maneken_cut)
    return;

  manekenSwayTimer++;

  // Скорость покачивания
  int swayDelay = 20;

  // Увеличиваем задержку в крайних положениях (+4° и -4°)
  if (manekenSwayStep == 2 || manekenSwayStep == 6)
      swayDelay = 30;

  if (manekenSwayTimer < swayDelay)
      return;

  manekenSwayTimer = 0;

  manekenSwayStep++;

  if (manekenSwayStep >= 8)
    manekenSwayStep = 0;

  // Последовательность покачивания
  if (manekenSwayStep == 0)
    SetManekenSwayPose(0);

  else if (manekenSwayStep == 1)
    SetManekenSwayPose(2);

  else if (manekenSwayStep == 2)
    SetManekenSwayPose(4);

  else if (manekenSwayStep == 3)
    SetManekenSwayPose(2);

  else if (manekenSwayStep == 4)
    SetManekenSwayPose(0);

  else if (manekenSwayStep == 5)
    SetManekenSwayPose(-2);

  else if (manekenSwayStep == 6)
    SetManekenSwayPose(-4);

  else if (manekenSwayStep == 7)
    SetManekenSwayPose(-2);
}

function oManeken_Interact(Object *theObject, CursorMode mode)
{
  if (maneken == false) 
  {
    if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
    {
      TypeText("Слава Богу, это всего лишь деревянный манекен... Но легче от этого не становится. Кому вообще пришло в голову повесить его здесь?");
      maneken = true;
    }
  }
  else if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    TypeText("Я мог бы попытаться снять его, однако мне нечем перерезать веревку.");
  }
}

function hSky_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Глядя на небо, мне становится страшно. Звезды просто огромны, и я не узнаю ни одного созвездия.");
}

function pass_through()
{
  ResetLabyrinthState();
  player.ChangeRoom(33, 450, 931);
}

function ProcessLabyrinthDoor(int doorPosition, int arrivalX)
{
  currentEdge = GetNextEdge(currentEdge, doorPosition);
  previousPosition = doorPosition;

  // Проверяем, не достигли ли мы финальной комнаты
  if (currentEdge.Substring(2, 1) == "b")
  {
    pass_through();
    return;
  }

  // Учитываем неудачный переход
  labyrinthStepCount++;

  aDoor_sound3.Play();
  player.ChangeRoom(32, arrivalX, 960);
}

function hDoor1_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (!player.HasInventory(iThreads))
  {
    TypeText("Четыре одинаковые двери. И ни малейшего представления о том, куда ведет каждая. Это похоже на лабиринт.");
    TypeText("Кажется, у меня нет выбора, но я не хочу пускаться туда, не имея возможности вернуться в исходную точку. Надо придумать какой-нибудь способ. Может, получится найти, чем отметить дорогу?");
    saw_labirint = true;
  }
  else
  {
    ProcessLabyrinthDoor(2, 610);
  }
}

