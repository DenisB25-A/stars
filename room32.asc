// room script file
bool maneken = false;
bool maneken_note = false;
bool maneken_cut = false;
bool arrowsExitUsed = false;
bool doors = false;
bool second_room = false;

String currentEdge;
int previousPosition;

function EnlargeHeroBriefly()
{
  // Запоминаем исходные настройки масштабирования
  bool wasManual = cEgo.ManualScaling;
  int originalScale = cEgo.Scaling;

  // Временно включаем ручное масштабирование
  cEgo.ManualScaling = true;

  // Увеличиваем героя на 15%
  cEgo.Scaling = originalScale + 15;

  // Ждём 2 секунды (при нашей скорости игры 40)
  Wait(80);

  // Возвращаем прежний размер и настройки
  cEgo.Scaling = originalScale;
  cEgo.ManualScaling = wasManual;
}

