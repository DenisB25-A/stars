function oManeken_UseInv(Object *theObject, CursorMode mode)
{
  if (player.ActiveInventory == iRastyKnife)
  {
    if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
      {
      // --- УСПЕШНОЕ ДЕЙСТВИЕ ---
    FadeOut(4); // Закрыл глаза (очень быстро)
    AudioChannel *channel1 = aRop_cut.Play();
    
    // Ждем, пока первый звук полностью проиграется
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); // Ставим игру на микро-паузу в 1 кадр, пока звук идет
    }
    // 2. Как только первый затих, запускаем второй звук
    AudioChannel *channel2 = aFall.Play();
    
    // Точно так же ждем окончания второго звука
    while (channel2 != null && channel2.IsPlaying) 
    {
      Wait(1);
    }
      oManeken.Visible = false;
      oManeken_sitting.Visible = true;
      FadeIn(4);  // Открыл глаза
      

      player.LoseInventory(iRastyKnife); 

      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto; // возвращаем обычный курсор
      }

  }
}

function oManeken_sitting_Interact(Object *theObject, CursorMode mode)
{
  // 1. Проверяем, стоит ли игрок в нужном месте
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
    // 2. Если стоит, проверяем, брал ли он записку
    if (maneken_note == false) 
    {
      TypeText("Лицо пустое, стерильное, лишенное человечности, и вы этому даже рады. Лишь челюсть отодвигается на шарнирах. За ней зияет темная глотка.");
      TypeText("Кажется, во рту у него что-то есть.");
      ReadAndAddNote(6);
      TypeText("Похоже на какой-то шифр.");
      maneken_note = true;
    }
    else 
    {
      // Этот текст сработает, если игрок на регионе, но записка УЖЕ взята
      TypeText("Деревянный манекен. В его присутствии мне как-то не по себе.");
    }
  }
}