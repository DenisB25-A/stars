// room script file
bool maneken = false;
bool maneken_note = false;
bool maneken_cut = false;
bool arrowsExitUsed = false;
bool doors = false;
bool second_room = false;

int arrowsSet = 0; // 0 = oArrows, 1..4 = oArrows1..oArrows4
int arrowHistory[32];
int arrowHistoryCount = 0;

String currentEdge;
int previousPosition;

