// room script file
bool papers = false;


function room_Load()
{
  if (IsNight == true) {
    SetBackgroundFrame(1); // Включает ночной фон (слот 1) и фиксирует его
  }
  else {
    SetBackgroundFrame(0); // Включает дневной фон (слот 0) и фиксирует его
  }
}


function hTrinkets_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Наша с мамой «не потеряй-чашка». В детстве я был растяпой, поэтому она научила меня класть все важные вещи сюда. Например, ключи от квартиры");
  TypeText("По иронии судьбы, с возрастом память стала подводить уже её, и она сама стала хранить в ней ключи.");
  TypeText("Сейчас здесь просто куча старых безделушек. Дубликат от входной двери у меня есть, а вот ключи от кладовки...");
}

function hMagazines_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стопка старых брошюр и журналов.");
}

function hDrawer_close_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aLocking_shelf.Play();
  TypeText("Ящик заперт...");

}


function hPapers_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (papers == false)
  {
  aPaper.Play();
    TypeText("В ящике под столом ворох каких-то бумаг.");
    TypeText("Квитанции, вырванные из тетрадей листы, записки-напоминалки. В основном старые, но одна выглядит сравнительно новой.");
    TypeText("Вы берете ее с робкой надеждой, однако там всего лишь перечень каких-то дел на давно минувший день. К листку прилип библиотечный формуляр.");
    TypeText("Агата Кристи - «Десять негритят». Похоже, мама недавно брала эту книгу в библиотеке, и она теперь где-то в квартире.");
    TypeText("Кто знает, что делать с этой информацией?");
    prompts = prompts + 2;
    papers = true;
  }
  else
  {
    TypeText("Вы наспех пролистываете бумаги снова, но чуда не происходит: ни выигрышного лотерейного билета, ни залежавшегося письма.");
  }
}

function hTable_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
  player.ChangeRoom(3, 566, 850);
  }
  else
  {
  player.ChangeRoom(25, 566, 850);
  }
}


function hDrawer_close_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iArmature)
  {
    TypeText("Может все же не столь радикально?");
    TypeText("...");
    TypeText("Да пошло оно все.");
    FadeOut(4); 
    AudioChannel *channel1 = aBreaking.Play();
    
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); 
    }
    oBroken_draw.Visible = true;
    oDoor_handle.Visible = true;
    FadeIn(4);
    
          
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; 
    }

  }


function oDoor_handle_Interact(Object *theObject, CursorMode mode)
{
  TypeText("Дверная ручка?");
  player.AddInventory(iDoor_handle);
  oDoor_handle.Visible = false;
}
