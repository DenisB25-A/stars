// room script file
bool foundvodka = false;

function hStoreroom_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    aDoor_sound2.Play();
    player.ChangeRoom(2, 970, 1042); 
  }
}


function oCoffee_AnyClick(Object *theObject, CursorMode mode)
{
  player.AddInventory(iCoffee);
}

function hBoxes_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (foundvodka == false)  
 {
    TypeText("Осматривая груду коробок, вы натыкаетесь на нечто, что в начале принимаете за растворитель. Дешевого вида бутылка и этикетка, название на которой не разобрать.");
    TypeText("Лишь открутив крышку, вы понимаете, что это водка. Правда такого качества, которую в приличных компаниях точно не пьют.");
    TypeText("Чтож, теперь у вас есть 'Подозрительного вида водка'");
    player.AddInventory(iVodka);
    foundvodka = true;
 }
  else
  {
    TypeText("Груда коробок, в которых нет ничего интересного.");
  }
 }


