// room script file
bool foundvodka = false;

function hStoreroom_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    aDoor_sound2.Play();
    player.ChangeRoom(2, 970, 1043); 
  }
}


function oCoffee_AnyClick(Object *theObject, CursorMode mode)
{
  TypeText("На верхней полке стоит баночка приличного на вид кофе. Мама не пила его, но держала на случай прихода гостей.");
  TypeText("Судя по слою пыли, гостей здесь не было уже очень давно.");
  oCoffee.Visible = false;
  player.AddInventory(iCoffee);
}

function hBoxes_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (foundvodka == false)  
 {
    TypeText("Осматривая груду коробок, вы натыкаетесь на нечто, что в начале принимаете за растворитель. Дешевого вида бутылка и этикетка, название на которой не разобрать.");
    TypeText("Лишь открутив крышку, вы понимаете, что это водка. Правда, такого качества, которую в приличных компаниях точно не пьют.");
    TypeText("Чтож, теперь у вас есть 'Подозрительного вида водка'");
    player.AddInventory(iVodka);
    foundvodka = true;
 }
  else
  {
    TypeText("Груда коробок, в которых нет ничего интересного.");
  }
 }


function hJars_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Банки с огурцами, соленья, консервированные помидоры, варенье, грибы. Чтож, по крайней мере, в ближайший месяц я не умру с голоду.");
}

function hBoxes2_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Коробки набиты старой макулатурой, которую никто не удосужился выбросить. По типу журналов из 90-х: 'Сделай сам' и 'Крестьянка'.");
}

function hJars2_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стеклотара для засолки. Мне она точно не пригодится.");
}

function hBoxes3_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Не сомневаюсь, что если хорошенько покопаться в этом барахле, то можно собрать и ядерный реактор. Однако у меня нет на это ни сил, ни желания.");
}
