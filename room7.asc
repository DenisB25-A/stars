// room script file
bool foundvodka = false;

function room_FirstLoad()
{
  player.FaceDirection(eDirectionRight, eBlock);
  start_diming();
  move_carret_back();
  show_accumulated_text_after("Так, спокойно. Это просто старый шкаф.", 220,  true);
  Wait(100);
  move_carret_back();
  start_lighter();
}

function hStoreroom_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    aDoor_sound2.Play();
    player.ChangeRoom(2, 970, 1043); 
  }
}


function oCoffee_Interact(Object *theObject, CursorMode mode)
{
  TypeText("На верхней полке стоит баночка приличного на вид кофе. Мама не пила его, но держала на случай прихода гостей.");
  TypeText("Судя по слою пыли, гостей здесь не было уже очень давно.");
  TypeText("Получен предмет: «Банка кофе».");
  oCoffeeTin.Visible = false;
  player.AddInventory(iCoffee);
}

function hBoxes_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (foundvodka == false)  
 {
    TypeText("Осматривая груду коробок, вы натыкаетесь на нечто, что сначала принимаете за растворитель. Дешевая на вид бутылка с этикеткой, название на которой не разобрать.");
    TypeText("Открутив крышку, вы понимаете, что это водка. Правда, такая, какую в приличной компании точно не пьют.");
    TypeText("Что ж, теперь у вас есть «Подозрительного вида водка»");
    player.AddInventory(iVodka);
    foundvodka = true;
 }
  else
  {
    TypeText("Груда коробок, в которых нет ничего интересного.");
  }
 }


function hJars_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Соленья. Банки с огурцами, консервированные помидоры, варенье, грибы. Чтож, по крайней мере, в ближайший месяц я не умру с голоду.");
}

function hBoxes2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Коробки набиты старой макулатурой, которую никто не удосужился выбросить. Вроде журналов из 90-х: «Сделай сам» и «Крестьянка».");
}

function hJars2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стеклотара для засолки. Мне она точно не пригодится.");
}

function hBoxes3_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Не сомневаюсь, что если хорошенько покопаться в этом барахле, можно собрать и ядерный реактор. Однако у меня нет на это ни сил, ни желания.");
}

function hBlack_shelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Я понимаю, это всего лишь шкаф, но... я не могу.");
}

function hDark_corner_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (foundplayer == false)
  {
    TypeText("Дальний угол на верхней полке темен и давным-давно зарос паутиной. До него едва можно дотянуться. Шариться там хлопотно, грязно и, честно сказать, вы сомневаетесь, что усилия будут вознаграждены.");
    dDark_corner.Start();    
  }
  else
  {
    TypeText("Грязный угол в старой кладовке. Пустой.");
  }
}
