function hLiving_room_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(3, 566, 850); 
    aDoor_sound.Play();
  }
}

function hBathroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(4, 665, 1058); 
  }
}

function hKitchen_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    aDoor_sound3.Play();
    player.ChangeRoom(5, 1652, 1010); 
  }
}

function hStoreroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    aDoor_sound2.Play();
    player.ChangeRoom(7, 570, 1030); 
  }
}

function hBedroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
      player.ChangeRoom(1, 1576, 997); 
  }
}
