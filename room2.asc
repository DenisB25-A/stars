function hLiving_room_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (was_balcony_thoughts == false)
  {
    TypeText("Я бы с удовольствием побродил по квартире, но сначала надо найти сигареты и покурить. Не думаю, что оставил их там.");
  }
  else
  {
    player.ChangeRoom(3, 566, 850); 
    aDoor_sound.Play();
  }
}

function hBathroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (was_balcony_thoughts == false)
  {
    TypeText("Я бы с удовольствием побродил по квартире, но сначала надо найти сигареты и покурить. Не думаю, что оставил их там.");
  }
  else
  {
    player.ChangeRoom(4, 665, 1077); 
  }
}

function hKitchen_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound3.Play();
  player.ChangeRoom(5, 1652, 1010); 
}

function hStoreroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (store_room_key == false)
  {
    aLocking_shelf.Play();
    TypeText("Закрыто. Обычно мама запирала кладовку на ключ. Я, правда, понятия не имею, где он.");
  }
  else
  {
    aDoor_sound2.Play();
    player.ChangeRoom(7, 570, 1030); 
  }

}

function hBedroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(1, 1576, 997); 
}

function hStoreroom_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iBarrete2)
  {
    TypeText("Я не домушник... Если кто-то думает, что я смогу вскрыть замок женской заколкой, то вынужден его разочаровать.");
  }
  else if (player.ActiveInventory == iKey_storeroom)
  {
    AudioChannel *channel1 = aKey.Play();
    
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); 
    }
    store_room_key = true;
    player.LoseInventory(iKey_storeroom);
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto; 
    TypeText("Получилось. Ключ подошел.");
    }
  else
  {
    TypeText("Ума не приложу, что с этим делать.");
  }

}
