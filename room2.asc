// room script file

function room_FirstLoad()
{
{
    TypeText("Это старый дом. Мне стоило бы привыкнуть.");
    TypeText("Но мне все равно здесь не нравится. Тревожно.");
}
}

function hLiving_room_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(3, 566, 850); 
    aDoor_sound.Play();
  }
}

function hBathroom_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(4, 665, 1058); 
  }
}

function hKitchen_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    aDoor_sound3.Play();
    player.ChangeRoom(5, 1652, 1010); 
    FadeOut(5);
  }
}

function hStoreroom_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    aDoor_sound2.Play();
    player.ChangeRoom(7, 570, 1030); 
  }
}

function hBedroom_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
      player.ChangeRoom(1, 1576, 997); 
  }
}
