// room script file
bool black_shelf = false;
bool shadows = false;

function room_AfterFadeIn()
{
  aBlack_hole.Play(eAudioPriorityNormal, eRepeat);
  oShadows.SetView(SHADOWS);
  // Добавляем eNoBlock, чтобы игра не ждала завершения анимации
  oShadows.Animate(0, 7, eRepeat, eNoBlock);
  

}
function oShadows_Interact(Object *theObject, CursorMode mode)
{
  if (shadows == false)
  {
    TypeText("В проломе стены клубятся густые черные тени и слышен вой ветра.");
    shadows = true;
    dShadows.Start();
  }
  else
  {
    dShadows.Start();
  }
}

function hPainting1_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Я не узнаю этой фотографии.");
}

function hPainting2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Пустая рамка. Такое ощущение, будто я знаю, что в ней должно быть, но не могу вспомнить.");
}

function hBed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Это... это моя квартира?");
  TypeText("Запах отвратительный. Тут все съедено плесенью. Это не может быть моим домом.");
  TypeText("Где я? Как я сюда попал?");
}

function hBlack_shelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (black_shelf == false)
  {
    TypeText("Этот шкаф... Он кажется мне знакомым, но я не могу вспомнить, где его видел. Мысли путаются.");
    TypeText("Отчего то у меня устойчивое ощущение, что я должен его открыть.");
    aLocking_shelf.Play();
    TypeText("Закрыто...");
    TypeText("Под золотистого цвета ручкой чернеет замочная скважина.");
    black_shelf = true;
  }
  else
  {
    aLocking_shelf.Play();
    TypeText("Изнутри еле слышно доносятся какие-то звуки. Но без ключа дверь не открыть.");
  }
}

function hUnder_bed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Preamble_under_bed == false)
  {
    TypeText("Из-под кровати несет гнилью и мокрым тряпьем. Темнота, хоть глаз выколи. Я правда уверен, что хочу это сделать?");
    dUnder_bedPreamble.Start();
  }
  else
  {
    TypeText("Только плесень и темнота.");
  }
}



function room_Unload()
{
  aBlack_hole.Stop();
}


