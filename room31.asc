// room script file
bool black_shelf = false;
bool key = false;
bool threads_found = false;
bool shadows = false;


function room_Load()
{
  SetBackgroundFrame(0);
}

function room_FirstLoad()
{
  TypeText("Что? Что, черт возьми... Где я?");
  TypeText("Как я сюда попал? Это ведь просто дурной сон, правда?");
}

function room_AfterFadeIn()
{
  aBlack_hole.Play(eAudioPriorityNormal, eRepeat);
  oShadows.SetView(SHADOWS);
  // Добавляем eNoBlock, чтобы игра не ждала завершения анимации
  oShadows.Animate(0, 7, eRepeat, eNoBlock);

}

function oShadows_Interact(Object *theObject, CursorMode mode)
{
  if (shadows == false)
  {
    TypeText("В проломе стены клубятся густые черные тени и слышен вой ветра.");
    shadows = true;
  }

  dShadows.Start();
}

function hPainting1_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Я не узнаю эту фотографию.");
}

function hPainting2_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Пустая рамка. Такое ощущение, будто я знаю, что в ней должно быть, но не могу вспомнить.");
}

function hAppartment_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Это... это моя квартира?");
  TypeText("Запах отвратительный. Тут все съедено плесенью. Это не может быть моим домом.");
}

function hUnder_bed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Preamble_under_bed == false)
  {
    TypeText("Из-под кровати несет гнилью и мокрым тряпьем. Темнота, хоть глаз выколи. Я правда уверен, что хочу это сделать?");
    dUnder_bedDream.Start();
  }
  else
  {
    dUnder_bedDream.Start();
  }
}

function hBlack_shelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (black_shelf == false)
  {
    TypeText("Этот шкаф. Он кажется мне знакомым, но я не помню, где его видел. Мысли путаются.");
    TypeText("Почему-то меня гложет необъяснимое чувство, что я должен его открыть.");
    aLocking_shelf.Play();
    TypeText("Закрыто...");
    TypeText("Под золотистого цвета ручкой чернеет замочная скважина.");
    black_shelf = true;
  }
  else if (key == true && black_shelf == true)
  {
    aBlack_hole.Stop();
  // --- КАДР 0 ---
    FadeOut(3);
    mouse.Visible = false;
    cEgo.Transparency = 100;
    aCreak.Play();
    Wait(80);
    
    SetBackgroundFrame(1);
    FadeIn(3);
    aTense_moment.Play();
    Wait(100); // Ждем 25 тиков
    
    // --- КАДР 1 ---
    SetBackgroundFrame(2);
    
    Wait(60); // Ждем 25 тиков
    
    // --- КАДР 2 (Тот самый, который зависает дольше) ---
    SetBackgroundFrame(3);
    
    Wait(60); // Ждем 60 тиков (дольше остальных)
    
    // --- КАДР 3 ---
    SetBackgroundFrame(4);
    Wait(20);
    FadeOut(64);
    Wait(120);
    mouse.Visible = true;
    player.ChangeRoom(13, 583, 996);
    cEgo.Transparency = 0;
    was_dream = true;
  }
    else if (key == false && black_shelf == true)
  {
    aLocking_shelf.Play();
    TypeText("Изнутри еле слышно доносятся какие-то звуки, но без ключа мне дверь не открыть.");
  }
}

function hBlack_shelf_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iGoldenKey)
  {
    // Сначала игрок должен обнаружить замочную скважину
    if (black_shelf == false)
    {
      TypeText("Сначала нужно осмотреть шкаф.");

      player.ActiveInventory = null;
      mouse.Mode = eModeWalkto;
      return;
    }

    aBlack_hole.Stop();
    AudioChannel *channel1 = aKey.Play();

    while (channel1 != null && channel1.IsPlaying)
    {
      Wait(1);
    }

    aBlack_hole.Play(eAudioPriorityNormal, eRepeat);

    key = true;
    player.LoseInventory(iGoldenKey);
    player.ActiveInventory = null;
    mouse.Mode = eModeWalkto;
  }
  else
  {
    TypeText("Не лучшая идея.");
  }
}

function hUnder_bed_UseInv(Hotspot *theHotspot, CursorMode mode)
{
    if (player.ActiveInventory == iRastyKnife && threads_found == false && saw_labirint == true)
  {
    TypeText("Вы аккуратно разрезаете ткань и вытягиваете длинную капроновую нить, наматывая ее на запястье. Не слишком надежный способ, но выбирать не приходится.");
    TypeText("Получен предмет: «Моток ниток»");
    player.AddInventory(iThreads);
    threads_found = true;
    dUnder_bedDream.SetOptionState(2, eOptionOffForever);
  }
  else if (player.ActiveInventory == iRastyKnife && threads_found == true)
  {
    TypeText("Вы брезгливо тыкаете ножом в то, что осталось от постельного белья, и качаете головой. Это груда старых тряпок, готовая рассыпаться от любого прикосновения. Ничего полезного вам больше тут не найти.");
  }
  else
  {
    TypeText("Ума не приложу, что с этим делать.");
  }

}

function room_Unload()
{
  aBlack_hole.Stop();
}

