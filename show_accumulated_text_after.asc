String last_text_state;


function init_narrative_overlay() {
  last_text_state = "";
  lblThougts.Visible = true;
  lblThougts.Text = last_text_state;
}

function game_start()
{
  init_narrative_overlay();
}


function show_accumulated_text_after(String text, int loops, bool hold)
{
  Wait(loops);
  //aComputer_keyboard.Play();
  String nextLine = "\n";
  
  if (hold == true) {
    lblThougts.Text = last_text_state.Append(text);
    last_text_state = lblThougts.Text.Append(nextLine);
  } else {
    lblThougts.Text = last_text_state.Append(text);
  }
}

function show_text_overlay_mode(String text)
{
  while (text.Length > 0) {
    int pos = text.IndexOf("\n");
    
    if (pos == -1) {
      pos = text.Length - 1;
    }
    
    String devider = "\n";
    String shownText = text.Substring(0,  pos);
    text = text.Substring(pos + 1, text.Length - (pos + 1));
      
    show_accumulated_text_after(devider.Append(shownText), 200,  true);
  }
}

function move_carret_back()
{
  lblThougts.Text = "";
  last_text_state = "";
}
