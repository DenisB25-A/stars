// room script file
bool under_bed2 = false;


function room_Load()
{
  SetBackgroundFrame(0);
  
  if (was_dream == true)
    // Антон уже в позе, когда мы входим в комнату
    {
    cEgo.SayAt(-10, -10, 10, " "); 
    cEgo.LockView(2); 
    cEgo.Animate(0, 30, eRepeat, eNoBlock); // 20 — отличная скорость для тяжелого дыхания
    }
}

// Катсцена ухода ко сну (первое появление в комнате)
