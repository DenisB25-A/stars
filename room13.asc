function room_AfterFadeIn()
{
  if (was_dream == true)
  {
    TypeText("Слава Богу, это всего лишь кошмар. Но такой реальный.");
    ChangeMood(-1);
    TypeText(" ");
    Wait(80);
    FadeOut(5);
    cEgo.UnlockView();
    cEgo.Loop = 2;
    cEgo.x = 583; 
    cEgo.y = 996; 
    FadeIn(5);
    Wait(80);
    gDarkOverlay.Visible = true;
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 10;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    gDarkOverlay.Visible = false;
    TypeText("Только этого не хватало. Кажется что-то со светом.");
    TypeText("Надо сходить посмотреть.");
    was_dream = false;
  }

}

function hD_bedroom_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3])
  {  
    player.ChangeRoom(14, 636, 1043);
  }
}

function hpicture_bears_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2])
  {
  TypeText("Не знаю почему, но ночью она выглядит немного зловеще.");
  }
}

function hShelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[3]) 
    {
      TypeText("Сейчас слишком темно, чтобы что-то там рассмотреть.");
    }
}

function hPainting_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
  TypeText("На фото искрящийся на солнце золотой пляж.");
  }
}

function hEmpty_painting_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
  TypeText("Рамка картины пуста.");
  }
}

function hUnder_bed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
    if (under_bed2 == false)
    {
      TypeText("Свитое тенями пространство щекочет ваши детские страхи. Но вы ведь уже взрослый, правда?");
      dUnder_bed2.Start();
      under_bed2 = true;
    }
    else
    {
      TypeText("Под кроватью никого нет. Пока что.");
    }
  }
}

