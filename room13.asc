function hEmpty_painting_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Пустая рамка. Во сне мне казалось, будто я почти вспомнил, что там должно быть.");
}

function hUnder_bed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  // Рисунок уже найден
  if (dUnder_bed2.GetOptionState(1) == eOptionOffForever)
  {
    TypeText("Под кроватью никого нет. Пока что.");
    return;
  }

  // Первое взаимодействие — вступительная реплика
  if (!dUnder_bed2.HasOptionBeenChosen(2))
  {
    TypeText("Свитое тенями пространство щекочет ваши детские страхи. Но вы ведь уже взрослый, правда?");
  }

  dUnder_bed2.Start();
}


function hLamp_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Лампочка мигает и едва светит. Что-то не так.");
}
