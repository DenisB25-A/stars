function room_AfterFadeIn()
{
  if (was_dream == true)
  {
    TypeText("Слава Богу, всего лишь кошмар. Но такой реальный.");
    TypeText("Пожалуй, если я не раскошелюсь на мозгоправа...");
    Mouse.Visible = false;
    Wait(40);
    gDarkOverlay.Visible = true;
    aElectric_lamp.Play();
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 10;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    gDarkOverlay.Visible = false;
    Wait(40);
    Mouse.Visible = true;
    TypeText("...Только этого не хватало. Кажется, что-то со светом.");
    TypeText("Ладно. Сегодня я уже все равно не усну. Придется посмотреть.");
    FadeOut(10);
    ChangeMood(-1);
    cEgo.UnlockView();
    cEgo.Loop = 2;
    cEgo.x = 583; 
    cEgo.y = 996; 
    FadeIn(10);
    was_dream = false;
  }

}

function hD_bedroom_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(14, 636, 1043);
}

