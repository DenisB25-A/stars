// room script file
int stars = 0;

function hExit_Nbalcony_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(27, 410, 1010); 
}

function room_FirstLoad()
{
  TypeText("Куда он исчез?");
  TypeText("Что это вообще было?");
}

function hNight_street_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Снаружи обычный, полный ночных огней город. А я будто бы заперт здесь.");
  TypeText("Может, если позвать на помощь, меня кто-то услышит?");
  TypeText("Сомневаюсь. Никто не услышит.");
}

function hNight_sky_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (stars == 0)
  {
    TypeText("Несмотря ни на что, небо сегодня очень красиво.");
    stars += 1;
  }
  else if (stars == 1)
  {
    TypeText("Вы смотрите вверх. Туда, где по небосклону будто бы рассыпали жемчуг.");
    TypeText("Говорят, атомы, из которых мы состоим, когда-то родились в недрах звезд. Мы — звездная пыль.");
    TypeText("Кажется, что в этих словах что-то есть. Какая-то... надежда? Ведь если звезды переродились в нас, то и мы никогда окончательно не исчезнем.");
    stars += 1;
  }
  else if (stars == 2)
  {
    TypeText("В полуночной глубине светят звезды. Несмотря ни на что, небо сегодня очень красиво.");
  }
  else
  {
    //TypeText("Вы вздрагиваете, когда небо рассекает яркая вспышка и тут же исчезает в ночи. Первый раз в жизни вы увидели падающую звезду. Можно загадать желание. Только чего мне пожелать?");
    //ChangeMood(3);
  }
}

function oPhoto_Interact(Object *theObject, CursorMode mode)
{
  oPhoto.Visible = false;
  ReadAndAddNote(10);
  TypeText("Какая-то очень старая фотография. Толком не могу разобрать, что на ней.");
}
