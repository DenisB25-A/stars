// room script file

DynamicSprite* wheelSprite;
int wheelBaseGraphic = 0;
int wheelAngle = 0;
int wheelPivotX;
int wheelPivotY;
bool wheelReady = false;
bool wheelSpinning = false;

function InitWheel()
{
  if (wheelReady) return;

  wheelBaseGraphic = oZodiakWheel.Graphic;
  wheelPivotX = oZodiakWheel.X + Game.SpriteWidth[wheelBaseGraphic] / 2;
  wheelPivotY = oZodiakWheel.Y - Game.SpriteHeight[wheelBaseGraphic] / 2;
  wheelReady = true;
}

function room_Load()
{
  InitWheel();
}

function SetWheelAngle(int angle)
{
  InitWheel();

  while (angle < 0) angle = angle + 360;
  while (angle >= 360) angle = angle - 360;
  wheelAngle = angle;

  DynamicSprite* newSprite = DynamicSprite.CreateFromExistingSprite(wheelBaseGraphic, true);
  if (wheelAngle > 0)
    newSprite.Rotate(wheelAngle);

  oZodiakWheel.Graphic = newSprite.Graphic;
  oZodiakWheel.X = wheelPivotX - newSprite.Width / 2;
  oZodiakWheel.Y = wheelPivotY + newSprite.Height / 2;

  if (wheelSprite != null)
    wheelSprite.Delete();
  wheelSprite = newSprite;
}

function AnimateWheelBy(int degrees)
{
  if (wheelSpinning) return;
  wheelSpinning = true;

  aMovingStone.Play();

  int remaining = degrees;
  while (remaining > 0)
  {
    int step = 2;
    if (remaining < step) step = remaining;
    SetWheelAngle(wheelAngle + step);
    remaining = remaining - step;
    Wait(1);
  }

  wheelSpinning = false;
}

function oZodiakWheel_Interact(Object *theObject, CursorMode mode)
{
  AnimateWheelBy(72);
}

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(30, 1249, 894); 
}
