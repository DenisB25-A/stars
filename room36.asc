// room script file

struct OrbitingObject
{
  Object* target;
  int startCenterX;
  int startCenterY;
};

OrbitingObject orbitingObjects[5];
int orbitCenterX;
int orbitCenterY;
int orbitAngle = 0;
bool orbitReady = false;
bool orbitSpinning = false;

function AddOrbitingObject(int index, Object* target)
{
  orbitingObjects[index].target = target;
  orbitingObjects[index].startCenterX = target.X + Game.SpriteWidth[target.Graphic] / 2;
  orbitingObjects[index].startCenterY = target.Y - Game.SpriteHeight[target.Graphic] / 2;
}

function InitOrbit()
{
  if (orbitReady) return;

  AddOrbitingObject(0, oPrincess);
  AddOrbitingObject(1, oSun);
  AddOrbitingObject(2, oMoon);
  AddOrbitingObject(3, oDemon);
  AddOrbitingObject(4, oKnight);

  int totalCenterX = 0;
  int totalCenterY = 0;
  int i = 0;
  while (i < 5)
  {
    totalCenterX = totalCenterX + orbitingObjects[i].startCenterX;
    totalCenterY = totalCenterY + orbitingObjects[i].startCenterY;
    i++;
  }
  orbitCenterX = totalCenterX / 5;
  orbitCenterY = totalCenterY / 5;

  orbitReady = true;
}

function SetOrbitAngle(int angle)
{
  InitOrbit();

  while (angle < 0) angle = angle + 360;
  while (angle >= 360) angle = angle - 360;
  orbitAngle = angle;

  float radians = Maths.DegreesToRadians(IntToFloat(orbitAngle));
  float cosine = Maths.Cos(radians);
  float sine = Maths.Sin(radians);

  int i = 0;
  while (i < 5)
  {
    Object* target = orbitingObjects[i].target;
    int offsetX = orbitingObjects[i].startCenterX - orbitCenterX;
    int offsetY = orbitingObjects[i].startCenterY - orbitCenterY;

    float centerX = IntToFloat(orbitCenterX) + IntToFloat(offsetX) * cosine - IntToFloat(offsetY) * sine;
    float centerY = IntToFloat(orbitCenterY) + IntToFloat(offsetX) * sine + IntToFloat(offsetY) * cosine;

    target.X = FloatToInt(centerX, eRoundNearest) - Game.SpriteWidth[target.Graphic] / 2;
    target.Y = FloatToInt(centerY, eRoundNearest) + Game.SpriteHeight[target.Graphic] / 2;
    i++;
  }
}

function AnimateOrbitBy(int degrees)
{
  if (orbitSpinning) return;
  orbitSpinning = true;

  aMovingStone.Play();

  int remaining = degrees;
  while (remaining > 0)
  {
    int step = 2;
    if (remaining < step) step = remaining;
    SetOrbitAngle(orbitAngle + step);
    remaining = remaining - step;
    Wait(1);
  }

  orbitSpinning = false;
}

function room_Load()
{
  InitOrbit();
}

function oZodiakWheel_Interact(Object *theObject, CursorMode mode)
{
  AnimateOrbitBy(30);
}

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(30, 1249, 894);
}
