// --- Глобальные массивы для 12 позиций ---
int zodiacX[12];
int zodiacY[12];

struct CoinData
{
  Object* obj;
  int currentPos; // Индекс текущей позиции (от 0 до 11)
};

CoinData coins[5];
bool isCoinMoving = false;

function InitZodiacPuzzle()
{
  // 1. ВПИШИ СЮДА РЕАЛЬНЫЕ КООРДИНАТЫ!
  // Расставь одну монету во все 12 позиций по очереди в редакторе комнат 
  // (по часовой стрелке) и перепиши её X и Y из панели Properties.
  
  // Позиция 0 (например, самый верхний знак)
  zodiacX[0] = 891; zodiacY[0] = 305; 
  // Позиция 1
  zodiacX[1] = 1079; zodiacY[1] = 377; 
  // Позиция 2
  zodiacX[2] = 1161; zodiacY[2] = 487; 
  
  // ... и так далее, заполни все 12 точек! (Ниже просто рыбы для примера)
  zodiacX[3] = 1182; zodiacY[3] = 630;
  zodiacX[4] = 1128; zodiacY[4] = 762;
  zodiacX[5] = 1015; zodiacY[5] = 860;
  zodiacX[6] = 847; zodiacY[6] = 882;
  zodiacX[7] = 716; zodiacY[7] = 822;
  zodiacX[8] = 634; zodiacY[8] = 720;
  zodiacX[9] = 592; zodiacY[9] = 598;
  zodiacX[10] = 616; zodiacY[10] = 486;
  zodiacX[11] = 691; zodiacY[11] = 379;

  // 2. Привязываем объекты к массиву монет
  coins[0].obj = oPrincess;
  coins[1].obj = oSun;
  coins[2].obj = oMoon;
  coins[3].obj = oDemon;
  coins[4].obj = oKnight;

  // 3. Задаем стартовые позиции для монет (индексы от 0 до 11)
  coins[0].currentPos = 0;  // Принцесса на 0-й позиции
  coins[1].currentPos = 2;  // Солнце на 2-й позиции
  coins[2].currentPos = 4;  // Луна на 4-й
  coins[3].currentPos = 8;  // Демон на 8-й
  coins[4].currentPos = 10; // Рыцарь на 10-й

  // 4. Физически ставим монеты на их места при загрузке комнаты
  int i = 0;
  while (i < 5)
  {
    int pos = coins[i].currentPos;
    coins[i].obj.X = zodiacX[pos];
    coins[i].obj.Y = zodiacY[pos];
    i++;
  }
}

function CheckPuzzleSolved()
{
  // Проверяем, стоят ли все монеты на своих победных позициях
  if (coins[0].currentPos == 5 && // Принцесса на Деве (5)
      coins[1].currentPos == 2 && // Солнце на Близнецах (2)
      coins[2].currentPos == 3 && // Луна на Раке (3)
      coins[3].currentPos == 9 && // Демон на Козероге (9)
      coins[4].currentPos == 8)   // Рыцарь на Стрельце (8)
  {
      // === ДЕЙСТВИЯ ПРИ ПОБЕДЕ ===

      // 1. Меняем глобальную переменную 
      // (замени 'puzzle_zodiac_solved' на имя своей переменной из Global Variables)
      actrological_mech = true; 

      // 2. Отключаем кликабельность монет, чтобы игрок случайно не сломал решение
      oPrincess.Clickable = false;
      oSun.Clickable = false;
      oMoon.Clickable = false;
      oDemon.Clickable = false;
      oKnight.Clickable = false;

      // 3. Звук механического щелчка / открытия тайника (если есть)
      // aHeavyDoorOpen.Play();

      // 4. Реакция персонажа
      TypeText("Раздался тяжелый щелчок. Кажется, механизм сработал.");
  }
}

function MoveCoinToNext(int coinIndex)
{
  if (isCoinMoving) return;
  isCoinMoving = true;

  aMovingStone.Play(); // Звук сдвига камня

  // 1. Берем следующую позицию по кругу
  int targetPos = coins[coinIndex].currentPos + 1;
  if (targetPos > 11) targetPos = 0;

  // 2. Ищем ближайшую СВОБОДНУЮ позицию
  bool positionOccupied = true;
  while (positionOccupied)
  {
    positionOccupied = false; // Изначально верим, что место свободно
    
    int i = 0;
    while (i < 5) // Перебираем все 5 монет
    {
      // Если это НЕ та монета, которую мы двигаем сейчас, И она стоит на нашей цели
      if (i != coinIndex && coins[i].currentPos == targetPos)
      {
        positionOccupied = true; // Ага, место занято!
        targetPos++;             // Шагаем еще на одну позицию вперед
        
        if (targetPos > 11) targetPos = 0; // Не забываем закольцевать круг
        
        break; // Прерываем цикл проверки и начинаем ее заново для новой точки
      }
      i++;
    }
  }

  // 3. Когда мы вышли из цикла выше, targetPos гарантированно указывает на пустую ячейку!
  // Запоминаем новую позицию для нашей монеты
  coins[coinIndex].currentPos = targetPos;

  // 4. Достаем физические координаты этой точки
  int targetX = zodiacX[targetPos];
  int targetY = zodiacY[targetPos];

  // 5. Двигаем объект (монета может визуально "проехать" сквозь другие монеты к своему месту)
  coins[coinIndex].obj.Move(targetX, targetY, 6, eBlock, eAnywhere);

  isCoinMoving = false;
  
  CheckPuzzleSolved();
}

function room_Load()
{
  InitZodiacPuzzle();
}

// === События клика на монеты ===
function oPrincess_Interact(Object *theObject, CursorMode mode)
{
  MoveCoinToNext(0); // 0 - это Принцесса
}

function oSun_Interact(Object *theObject, CursorMode mode)
{
  MoveCoinToNext(1); // 1 - это Солнце
}

function oMoon_Interact(Object *theObject, CursorMode mode)
{
  MoveCoinToNext(2); // 2 - это Луна
}

function oDemon_Interact(Object *theObject, CursorMode mode)
{
  MoveCoinToNext(3); // 3 - это Демон
}

function oKnight_Interact(Object *theObject, CursorMode mode)
{
  MoveCoinToNext(4); // 4 - это Рыцарь
}


function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(30, 1249, 894);
}
