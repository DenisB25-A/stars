// room script file

function room_AfterFadeIn()
{
  gDarkOverlay.Transparency = 0;
  gDarkOverlay.Visible = true;

  Wait(12);

  while (gDarkOverlay.Transparency < 100)
  {
    gDarkOverlay.Transparency += 2;
    Wait(1);
  }

  gDarkOverlay.Visible = false;

  if (Dino == 0)
  {
    Wait(40);
    TypeText("~Динозавр: Антон, подожди.");
    TypeText("~Динозавр: Подумай о том, что ты сейчас делаешь. Это нарисованная дверь. Ты правда собрался открыть ее?");
    dDino.Start();
  }
}