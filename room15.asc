// room script file

function hFifth_floor_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(16, 657, 1064); 
}

function hDown_from_main_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(17, 1036, 968);
}

function hapartment_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Electricity == false)
  {
    aDoor_sound3.Play();
    player.ChangeRoom(14, 988, 1043);
  }
  else
  {
    aDoor_sound3.Play();
    player.ChangeRoom(24, 988, 1042);
  }
}
