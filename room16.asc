// room script file

function hLast_floor_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(15, 1352, 968);
}

function hLoft_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Лестница на чердак. С люка свисает здоровенный амбарный замок.");
}

function hDoors_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Согласен, ситуация неприятная. Но не настолько, чтобы я начал ломиться к соседям посреди ночи. Думаю, надо разобраться как-нибудь самому.");
}

function hElectrical_panel_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  aElectropanel.Play();
  TypeText("Предохранители выбивает.");
  TypeText("Господи, это старая развалина доконает меня.");
  TypeText("Надо... надо что-то придумать.");
}

function oNote_stairs_AnyClick(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(5);
  oNote_stairs.Visible = false;  
}
