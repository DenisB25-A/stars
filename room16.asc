// room script file
bool electropanel = false;

function hLast_floor_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(15, 1036, 968);
}

function hLoft_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Лестница на чердак. С люка свисает здоровенный амбарный замок.");
}

function hDoors_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Согласен, ситуация неприятная. Но не настолько, чтобы я начал ломиться к соседям посреди ночи. Думаю, надо разобраться как-нибудь самому.");
}

function hElectrical_panel_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (electropanel == false)
  {
    aElectropanel.Play();
    TypeText("Предохранители выбивает.");
    TypeText("Господи, это старая развалюха меня доконает.");
    TypeText("Надо что-то придумать.");
  }
  else
  {
    TypeText("Антон: Хороший щиток.");
  }
}

function oNote_stairs_Interact(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(5);
  oNote_stairs.Visible = false;  
}

function hElectrical_panel_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (player.ActiveInventory == iBread)
  {
    TypeText("Дом «голодный» - что за чушь? Неужели я правда хочу это сделать?");
    Wait(40);
    FadeOut(4);
    aEating.Play();
    Wait(40);
    player.LoseInventory(iBread);
    FadeIn(4); 
    TypeText("За закрытыми дверцами слышится аппетитное похрустывание. Потом в щитке что-то щелкает, свет в подъезде мигает, но тотчас приходит в норму. Когда вы осторожно приоткрываете створку, изнутри сыпятся лишь хлебные крошки.");
    Electricity = true;
    electropanel = true;
  }
  if (player.ActiveInventory == iChocolate)
  {
    TypeText("Кажется, в объявлении просили не кормить «инженерку». Хорошо, что вы любитель нарушать всякого рода правила.");
    Wait(40);
    FadeOut(4);
    aEating.Play();
    Wait(40);
    player.LoseInventory(iChocolate);
    FadeIn(4); 
    TypeText("За закрытыми дверцами слышится аппетитное похрустывание. Потом в щитке что-то щелкает, свет в подъезде мигает, но тотчас приходит в норму. Когда вы осторожно приоткрываете створку, видны только ряды желтых предохранителей. Даже обертки не осталось.");
    Electricity = true;
    electropanel = true;
  }
}
