// room script file
bool electropanel = false;
bool loft = false;

function hLast_floor_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(15, 1036, 968);
}

function hLoft_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (loft == false)
  {
    TypeText("Лестница на чердак. С люка свисает здоровенный амбарный замок.");
  }
  else
  {
    player.ChangeRoom(50, 355, 942, eDirectionRight);
  }
}

function hDoors_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Ситуация, конечно, неприятная. Но не настолько, чтобы я начал ломиться к соседям посреди ночи. Думаю, надо разобраться как-нибудь самому.");
}

function hElectrical_panel_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (electropanel == false)
  {
    aElectropanel.Play();
    TypeText("Предохранители выбивает.");
    TypeText("Господи, это старая развалюха меня доконает.");
    TypeText("Надо что-то придумать.");
  }
  else
  {
    TypeText("Не знаю, как это работает, но главное, что работает. Свет есть.");
  }
}

function oNote_stairs_Interact(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(5);
  oNote_stairs.Visible = false;  
}

function hElectrical_panel_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if (Electricity == true)
  {
    TypeText("Пожалуй, на сегодня ему уже хватит.");
    return;
  }
  if (player.ActiveInventory == iBread)
  {
    TypeText("Дом «голодный» - что за чушь? Неужели я правда хочу это сделать?");
    Mouse.Visible = false;
    Wait(40);
    FadeOut(4);
    AudioChannel *channel1 = aElectropanel_Eating.Play();

    while (channel1 != null && channel1.IsPlaying)
    {
        Wait(1);
    }
    Wait(40);
    player.LoseInventory(iBread);
    mouse.Mode = eModeWalkto;
    FadeIn(4); 
    Mouse.Visible = true;
    TypeText("За закрытыми дверцами слышится аппетитное похрустывание. Затем в щитке что-то щелкает, свет в подъезде мигает, но тотчас приходит в норму. Когда вы осторожно приоткрываете створку, изнутри сыпятся лишь хлебные крошки.");
    aLight_on.Play();
    Electricity = true;
    electropanel = true;
  }
  if (player.ActiveInventory == iChocolate)
  {
    TypeText("Кажется, в объявлении сказано не кормить «инженерку». Хорошо, что вы любитель нарушать всякого рода правила.");
    Mouse.Visible = false;
    Wait(40);
    FadeOut(4);
    AudioChannel *channel1 = aElectropanel_Eating.Play();

    while (channel1 != null && channel1.IsPlaying)
    {
        Wait(1);
    }
    Wait(40);
    player.LoseInventory(iChocolate);
    mouse.Mode = eModeWalkto;
    FadeIn(4); 
    Mouse.Visible = true;
    TypeText("За закрытыми дверцами слышится аппетитное похрустывание. Затем в щитке что-то щелкает, свет в подъезде мигает, но тотчас приходит в норму. Когда вы осторожно приоткрываете створку, видны только ряды желтых предохранителей. Даже обертки не осталось.");
    aLight_on.Play();
    Electricity = true;
    electropanel = true;
  }
}

function hLoft_UseInv(Hotspot *theHotspot, CursorMode mode)
{
  if ((player.ActiveInventory == iArmature) && (!player.HasInventory(iChocolate)) && (!player.HasInventory(iBread)) && (BumMeeting == 2))
  {
    TypeText("Возможно, решение проблемы со светом где-то на чердаке, но вход преграждает здоровенный замок. Выглядит он внушительно. Если я каким-то чудом и смогу его оторвать, на это потребуется немало времени и усилий. Лучше поискать какой-нибудь альтернативный вариант.");
  }
  else if (player.ActiveInventory == iArmature) 
  {
    TypeText("Похоже другого варианта, кроме как лезть туда, нет.");
    Mouse.Visible = false;
    Wait(40);
    FadeOut(4);
    AudioChannel *channel1 = aLock_picking.Play();

    while (channel1 != null && channel1.IsPlaying)
    {
        Wait(1);
    }
    Wait(40);
    mouse.Mode = eModeWalkto;
    FadeIn(4); 
    Mouse.Visible = true;
    TypeText("Замок действительно крепкий. А вот петли, при ближайшем рассмотрении, выглядят старыми и давно изъедены ржавчиной. Не нужно быть Геркулесом, чтобы, немного повозившись с железкой, сорвать их с крышки чердачного люка. Что вы и делаете. Путь свободен.");
    loft = true;
  }
}
