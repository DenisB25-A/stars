// room script file

function hTable_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(41, 0, 0); 
  }
}

function hBird_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    TypeText("Антон: Ээээ, привет?");
  }
}
