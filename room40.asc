// room script file

function hTable_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    player.ChangeRoom(41, 0, 0); 
  }
}

function hBird_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Антон: Ээээ, привет?");
}

function oDark_lamp_Interact(Object *theObject, CursorMode mode)
{
  TypeText("На вид очень старая керосиновая лампа.");
  TypeText("Я думаю, она пригодилась бы мне, вот только керосина у меня нет.");

}

function hStrange_letters_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Стены тут тоже в странных надписях.");
}

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(39, 1356, 1030); 
}

function hWooden_door_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aOld_door.Play();
  player.ChangeRoom(43, 243, 1018);
}

function hHotspot6_Interact(Hotspot *theHotspot, CursorMode mode)
{
// 1. Включаем катсцену (игрок сможет пропустить её нажатием Esc)
  StartCutscene(eSkipESCOnly);

  // 2. Делаем героя полностью прозрачным (невидимым)
  cEgo.Transparency = 100; 

  // 3. Сообщаем движку, что началась первая фаза
  ManekenPhase = 1;

  // 4. Перекидываем невидимого героя в 44-ю комнату 
  // (Координаты любые, мы его всё равно не видим)
  cEgo.ChangeRoom(44, 0, 0);
}
