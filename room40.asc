// room script file
bool Strange_letters = false;

function room_FirstLoad()
{
  TypeText("Я прожил в квартире большую часть своей жизни и даже не догадывался о существовании этой комнаты за кладовкой.");
  TypeText("Что это за место? Интересно, а мама знала?");
}

function hTable_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(41, 0, 0); 
}

function hBird_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("На стене висит огромное чучело неизвестной вам птицы. Смотрится оно жутковато.");
  dBird.Start();
}

function oDark_lamp_Interact(Object *theObject, CursorMode mode)
{
  TypeText("На вид очень старая керосиновая лампа.");
  TypeText("Я думаю, она могла бы мне пригодиться, вот только подходящего топлива у меня нет.");
}

function hStrange_letters_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Strange_letters == false)
  {
    TypeText("Надписи на стенах похожи на те, что я видел в подъезде.");
    TypeText("Какие-то выглядят старыми, другие - будто бы сделаны только вчера.");
    Strange_letters = true;
  }
  else
  {
    TypeText("Смысл символов по-прежнему мне непонятен. Больше похоже на творение сумасшедшего.");
  }
}

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(39, 1356, 1030); 
}

function hWooden_door_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aLocking_shelf.Play();
  TypeText("Проход закрывает массивная дверь, обитая тяжелым металлом. Такая должна стоять в рыцарском замке или в каком-нибудь форте огров, но точно не в вашей квартире панельной застройки.");
  TypeText("В любом случае, о том, что за ней - остается только догадываться. Как бы вы ни старались - дверь не поддается.");
  //aOld_door.Play();
  //player.ChangeRoom(43, 243, 1018);
}

