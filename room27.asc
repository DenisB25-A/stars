// room script file

function hExit_kitchen_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    aDoor_sound3.Play();
    player.ChangeRoom(24, 970, 1042); 
  }
}

function hBalcony_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(28, 1444, 1050); 
  }
}

function hFridge_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  aDrawer_open.Play();
  player.ChangeRoom(35, 0, 0); 
}

function hStove_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Что-то изменилось. Печь тёплая... %@№#!");
}

function hTeapot_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Готов поклясться, что здесь был чайник");
}

function hWardrobe_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Дверцы больше не отрываются. Они приклеины или забиты.");
}

function hShelf_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
   TypeText("Крахмал... Зачем крахмал...");
}

function hLight_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  lblThougts.Text = "";
  
  
  gDarkOverlay.Visible = true;

  gDarkOverlay.Transparency = 35;
  Wait(2);
  gDarkOverlay.Transparency = 80;
  Wait(4);
  gDarkOverlay.Transparency = 20;
  Wait(1);
  gDarkOverlay.Transparency = 70;
  Wait(3);
  gDarkOverlay.Transparency = 35;
  Wait(2);
  gDarkOverlay.Transparency = 80;
  Wait(4);
  gDarkOverlay.Transparency = 20;
  Wait(1);
  gDarkOverlay.Transparency = 70;
  Wait(3);

  gDarkOverlay.Visible = false;
  TypeText("Что опять!?");
}
