// room script file
bool spices = false;
bool lamp = false;

function room_FirstLoad()
{
    cEgo.Loop = 1;
    TypeText("Твою мать...");
    Mouse.Visible = false;
    Wait(40);
    aElectric_lamp.Play();
    gDarkOverlay.Visible = true;

    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 10;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Transparency = 100;
    Wait(10);
    gDarkOverlay.Transparency = 0;
    Wait(10);
    gDarkOverlay.Visible = false;
    Wait(40);
  // Теперь всё с маленькой буквы: cSlender.x и cSlender.y
    cSlender.Walk(cSlender.x - 250, cSlender.y, eNoBlock, eAnywhere);
    Wait(140);
    gDarkOverlay.Visible = true;
    gDarkOverlay.Transparency = 35;
    Wait(2);
    gDarkOverlay.Transparency = 80;
    Wait(4);
    gDarkOverlay.Transparency = 20;
    Wait(1);
    gDarkOverlay.Transparency = 70;
    Wait(3);
    gDarkOverlay.Transparency = 35;
    Wait(2);
    gDarkOverlay.Transparency = 80;
    Wait(4);
    gDarkOverlay.Transparency = 20;
    Wait(1);
    gDarkOverlay.Transparency = 70;
    Wait(3);
    gDarkOverlay.Transparency = 0;
    Wait(80);
    gDarkOverlay.Visible = false;
    // Отправляем Слендера в комнату 0 после того, как он дошел
    cSlender.ChangeRoom(0);
    TypeText("Какого черта?");
    aHeartbeat.Play();
    Mouse.Visible = true;

}


function hExit_kitchen_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound3.Play();
  player.ChangeRoom(24, 970, 1042); 
}

function hBalcony_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(28, 1444, 1050); 
}

function hFridge_Interact(Hotspot *theHotspot, CursorMode mode)
{
  dFridge.Start();
}

function hStove_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Обычная старая печь. Она работает, вот только готовить мне особо и нечего.");
}

function hWardrobe_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Полки с банками и помойное ведро, от которого все так же воняет.");
  dKitchen_sink.Start();
}

function hShelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (spices == false)
  {
    TypeText("Банки со специями. Если на секунду остановиться, то чувствуешь, как от них пахнет тмином и какими-то травами. Как ни странно, это слегка успокаивает.");
    ChangeMood(1);
    spices = true;
  }
  else
  {
    TypeText("Банки со специями. Пахнет приятно, но мне они ни к чему.");    
  }
}
function hLight_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (lamp == false)
  {
    lblThougts.Text = "";
    
    
    gDarkOverlay.Visible = true;

    gDarkOverlay.Transparency = 35;
    Wait(2);
    gDarkOverlay.Transparency = 80;
    Wait(4);
    gDarkOverlay.Transparency = 20;
    Wait(1);
    gDarkOverlay.Transparency = 70;
    Wait(3);
    gDarkOverlay.Transparency = 35;
    Wait(2);
    gDarkOverlay.Transparency = 80;
    Wait(4);
    gDarkOverlay.Transparency = 20;
    Wait(1);
    gDarkOverlay.Transparency = 70;
    Wait(3);

    gDarkOverlay.Visible = false;
    TypeText("Ну нет... Только не снова.");
    lamp = true;
  }
  else
  {
    TypeText("Даже думать не хочу о том, что будет, если свет опять пропадет.");
  }
}

function hKitchen_utensils_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (knife == false)
    {
      TypeText("Над раковиной висят нехитрые кухонные принадлежности: полотенце, лопатка, толкушка для теста, длинный разделочный нож...");
      dKnife.Start();
    }
    else
    {
      TypeText("Больше ничего интересного.");
    }
}


function oTeapot_Interact(Object *theObject, CursorMode mode)
{
  TypeText("Пока по дому бродит какой-то двухметровый бугай, для кофе у меня как-то нет настроения. Пожалуй, как-нибудь обойдусь.");
}

