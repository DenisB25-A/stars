// room script file

function hExit_kitchen_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    aDoor_sound3.Play();
    player.ChangeRoom(24, 970, 1042); 
  }
}

function hBalcony_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(28, 1444, 1050); 
  }
}

function hFridge_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDrawer_open.Play();
  player.ChangeRoom(35, 0, 0); 
}

function hStove_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Что-то изменилось. Печь тёплая... %@№#!");
}

function hTeapot_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Готов поклясться, что здесь был чайник");
}

function hWardrobe_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Полки с банками и помойное ведро. Ничего не изменилось.");
  dKitchen_sink.Start();
}

function hShelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
   TypeText("Крахмал... Зачем крахмал...");
}

function hLight_Interact(Hotspot *theHotspot, CursorMode mode)
{
  lblThougts.Text = "";
  
  
  gDarkOverlay.Visible = true;

  gDarkOverlay.Transparency = 35;
  Wait(2);
  gDarkOverlay.Transparency = 80;
  Wait(4);
  gDarkOverlay.Transparency = 20;
  Wait(1);
  gDarkOverlay.Transparency = 70;
  Wait(3);
  gDarkOverlay.Transparency = 35;
  Wait(2);
  gDarkOverlay.Transparency = 80;
  Wait(4);
  gDarkOverlay.Transparency = 20;
  Wait(1);
  gDarkOverlay.Transparency = 70;
  Wait(3);

  gDarkOverlay.Visible = false;
  TypeText("Что опять!?");
}

function hKitchen_utensils_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
    if (knife == false)
    {
      TypeText("Над раковиной висят нехитрые кухонные принадлежности: полотенце, лопатка, толкушка для теста, длинный разделочный нож...");
      dKnife.Start();
    }
    else
    {
      TypeText("Разная кухонная утварь.");
    }
  }
}

function room_AfterFadeIn()
{
  cEgo.Loop = 1;
  Wait(40);
  aElectric_lamp.Play();
  gDarkOverlay.Visible = true;

  gDarkOverlay.Transparency = 0;
  Wait(10);
  gDarkOverlay.Transparency = 100;
  Wait(10);
  gDarkOverlay.Transparency = 10;
  Wait(10);
  gDarkOverlay.Transparency = 100;
  Wait(10);
  gDarkOverlay.Transparency = 0;
  Wait(10);
  gDarkOverlay.Transparency = 100;
  Wait(10);
  gDarkOverlay.Transparency = 0;
  Wait(10);
  gDarkOverlay.Transparency = 100;
  Wait(10);
  gDarkOverlay.Transparency = 0;
  Wait(10);
  gDarkOverlay.Visible = false;
  Wait(40);
// Теперь всё с маленькой буквы: cSlender.x и cSlender.y
  cSlender.Walk(cSlender.x - 250, cSlender.y, eNoBlock, eAnywhere);
  Wait(140);
  gDarkOverlay.Visible = true;
  gDarkOverlay.Transparency = 35;
  Wait(2);
  gDarkOverlay.Transparency = 80;
  Wait(4);
  gDarkOverlay.Transparency = 20;
  Wait(1);
  gDarkOverlay.Transparency = 70;
  Wait(3);
  gDarkOverlay.Transparency = 35;
  Wait(2);
  gDarkOverlay.Transparency = 80;
  Wait(4);
  gDarkOverlay.Transparency = 20;
  Wait(1);
  gDarkOverlay.Transparency = 70;
  Wait(3);
  gDarkOverlay.Transparency = 0;
  Wait(80);
  gDarkOverlay.Visible = false;
  // Отправляем Слендера в комнату 0 после того, как он дошел
  cSlender.ChangeRoom(0);
}

