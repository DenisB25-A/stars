// room script file
bool isManekenAggro = false;

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound3.Play();
  player.ChangeRoom(43, 1621, 1018); 
}

function hStairs_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(45, 828, 888); 
}

function room_Load()
{
  cEvil_Maneken.LockView(MANEKEN_CUT); // Или vManeken_cut (зависит от Script Name твоего View)
  cEvil_Maneken.Animate(0, 0, eRepeat, eNoBlock);
}

function region3_WalksOnto(Region *theRegion)
{
if (!isManekenAggro)
  {
    isManekenAggro = true;

    // МГНОВЕННО ОСТАНАВЛИВАЕМ ИГРОКА!
    cEgo.StopMoving();

    // 1. Жестко переключаем манекена на 1-й кадр (индекс 0) из Loop 1
    cEvil_Maneken.LockViewFrame(MANEKEN_CUT, 1, 0);

    // 2. Жуткая пауза в 2 секунды (герой в это время стоит замерший)
    Wait(80); 

    // 3. Освобождаем вид манекена
    cEvil_Maneken.UnlockView();

    // 4. Устанавливаем этот View как основной для ходьбы
    cEvil_Maneken.ChangeView(MANEKEN_CUT);

    // 5. Отправляем манекена к текущим координатам игрока
    cEvil_Maneken.Walk(cEgo.x + 350, cEgo.y, eNoBlock, eWalkableAreas);
  }
}

function room_AfterFadeIn()
{
// Проверяем, что герой зашел сюда именно ради катсцены
  if (ManekenPhase == 1) 
  {
    cEvil_Maneken.LockView(MANEKEN_CUT);
    cEvil_Maneken.Animate(0, 0, eOnce, eBlock);
    Wait(30); 
    // Манекен делает поворот с жуткой паузой
    cEvil_Maneken.LockViewFrame(MANEKEN_CUT, 1, 0);
    Wait(80); 
    cEvil_Maneken.UnlockView();
    cEvil_Maneken.ChangeView(MANEKEN_CUT);

    // Важно: используем eBlock! 
    // Скрипт будет ждать, пока манекен не дойдет до координат двери (например X=200, Y=150)
    cEvil_Maneken.Walk(470, 948, eBlock, eAnywhere);

    // Манекен дошел до двери. Переводим фазу на следующий этап.
    ManekenPhase = 2;

    // И перебрасываем нашу "камеру-игрока" в 43-ю комнату
    cEgo.ChangeRoom(43, 10, 10);
  }
}
