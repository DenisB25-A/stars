// room script file

function hPharynx_Interact(Hotspot *theHotspot, CursorMode mode)
{
// --- КАДР 0 ---
  SetBackgroundFrame(0);
  Wait(40); // Ждем 25 тиков
  
  // --- КАДР 1 ---
  SetBackgroundFrame(1);
  Wait(40); // Ждем 25 тиков
  
  // --- КАДР 2 (Тот самый, который зависает дольше) ---
  SetBackgroundFrame(2);
  Wait(140); // Ждем 60 тиков (дольше остальных)
  
  // --- КАДР 3 ---
  SetBackgroundFrame(3);
  Wait(80); // Ждем 25 тиков
  
  player.AddInventory(iGoldenKey);
  TypeText("Получен предмет: 'Позолоченный ключ'.");
  // И только теперь, когда все кадры по очереди показались, переносим игрока:
  player.ChangeRoom(33, 1052, 931);
}

function room_Load()
{
  SetBackgroundFrame(0);
}

function room_AfterFadeIn()
{
  TypeText("<????: Оно зудит у нас меж зубов.");
  TypeText("<????: Достань. Не бойся.");
  TypeText("<????: Ты ведь нам веришь?");
}
