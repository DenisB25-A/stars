function hFridge_Interact(Hotspot *theHotspot, CursorMode mode)
{
  dFridge.Start();
}

function oMilk_Interact(Object *theObject, CursorMode mode)
{
  dMilkCarton.Start();
}

function oTeapot_Interact(Object *theObject, CursorMode mode)
{
  if (was_brew_coffee == false)
  {
    dTeapot.Start();
  }
  else
  {
    TypeText("На сегодня хватит.");
  }
}

function hStove_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Чувствую себя настолько разбитым, что одна мысль о готовке заставляет меня немного паниковать. Как-нибудь обойдусь без нее.");
}

function hShelf_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Банки со специями. Мне они точно ни к чему.");
}

function hKitchen_sink_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("В шкафу под раковиной полки заставлены банками. С ними соседствует помойное ведро, от которого ощутимо пованивает.");
  dKitchen_sink.Start();
  TypeText("Кофе здесь нет. Вы вспоминаете, что мама никогда его не пила, однако она всегда держала баночку для гостей. Вот только где она может быть?");
}

function room_FirstLoad()
{
  cEgo.WalkStraight(1500, 1010);
  start_diming();
  move_carret_back();
  show_accumulated_text_after("Кажется, что здесь всё ещё стоит этот запах", 0,  true);
  show_accumulated_text_after("Жареного теста и ещё чего-то едкого", 100,  true);
  show_accumulated_text_after("И сигарет... сигарет, конечно...", 100,  true);
  Wait(100);
  start_lighter();
}


