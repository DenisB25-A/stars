// room script file

function hKitchen_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1]) 
  {
    aDoor_sound3.Play();
    player.ChangeRoom(2, 970, 1043); 
  }
}

function hKitchen_to_balcony_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[2]) 
  {
    player.ChangeRoom(6, 1444, 1050); 
  }
}

function hFridge_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  dFridge.Start();
}

function oMilk_AnyClick(Object *theObject, CursorMode mode)
{
  TypeText("Пакет молока, которое вы забыли положить в холодильник.");
  oMilk.Visible = false;
  player.AddInventory(iMilk);
}

function oTeapot_AnyClick(Object *theObject, CursorMode mode)
{
  dTeapot.Start();
}

function hStove_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Чувствую себя настолько разбитым, что одна мысль о готовке заставляет меня немного паниковать. Как-нибудь обойдусь без нее.");
}

function hShelf_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Банки со специями. Мне они точно ни к чему.");
}

function hKitchen_sink_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("В шкафу под раковиной полки заставлены банками. С ними соседствует помойное ведро, от которого ощутимо пованивает.");
  dKitchen_sink.Start();
}
