// room script file
bool first_enter = false;
bool room_watching = false;

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(32, 958, 960);
}

function room_AfterFadeIn()
{
  if (first_enter == false)
  {
    cEgo.Loop = 2;
    oBlacky.SetView(BLACKY);
    aHeartbeat.Play();
    Wait(80);
    TypeText("Антон: ...");
    TypeText("Антон: Что за...");
    TypeText("Антон: ...Что это?");
    mouse.Visible = false;
    Wait(80);
    mouse.Visible = true;
    TypeText("<????: Наконец-то ты здесь, Антон.");
    TypeText("<????: Подойди ближе. Не бойся.");
    dBlacky.Start();
    first_enter = true;
  }
  cEgo.Loop = 2;
  
  if (blacky == 2)
  {
    TypeText("<????: А теперь иди. Мы будем ждать, когда ты вернешься. Мы умеем ждать.");
  }
}

function room_RepExec()
{
  if (!oBlacky.Animating) 
  {
    // Запускаем её ОДИН ОДНОКРАТНЫЙ РАЗ (eOnce) на минимальной скорости (0)
    // Движок просто отыграет твои 5 и 35 кадров без ухода в цикл фриза
    oBlacky.Animate(0, 0, eOnce, eNoBlock);
  }
}

function hRoom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (room_watching == false)
  {
    TypeText("Если это место кто-то и строил, то какой-то сумасшедший художник: стены будто пытаются выйти из комнаты, а потолок - сложиться и улететь к небесам. Геометрия нарушена настолько, что кажется, будто вы стоите на потолке вниз головой. Вам быстро становится дурно.");
    room_watching = true;
  }
  else 
  {
    TypeText("Все это напоминает кошмар. Но я ведь проснусь, правда?");
  }
}

function oBlacky_Interact(Object *theObject, CursorMode mode)
{
  if (blacky == 0)
  {
    dBlacky.Start();
  }
  else if (blacky == 1)
  {
    player.ChangeRoom(37, 0, 0);
  }
  else if (blacky == 2)
  {
    TypeText("<????: А теперь иди. Мы подождем. Мы умеем ждать.");
  }
}

function hWindow_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("За мутным стеклом едва различимо движение, но сколько бы вы не пытались - ничего не получается рассмотреть. Впрочем, вы этому даже рады.");
}

function hBed_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Похоже на человеческий силуэт... Я точно не хочу проверять, что там.");
}

function oBlacky_UseInv(Object *theObject, CursorMode mode)
{
  if (player.ActiveInventory == iRastyKnife)
  {
    TypeText("Бросаться с ножом на эту громадину? Знаешь, я пока еще не рехнулся.");
  }
  else
  {
    TypeText("Не лучшая идея.");
  }
}
