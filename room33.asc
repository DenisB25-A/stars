// room script file
int furnishings = 0;
bool first_enter = false;

function hExit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(32, 958, 960);
}

function room_AfterFadeIn()
{
  if (first_enter == false)
  {
    cEgo.Loop = 2;
    oBlacky.SetView(BLACKY);
    AudioChannel *channel1 = aHeartbeat.Play();
    while (channel1 != null && channel1.IsPlaying) 
    {
      Wait(1); // Ставим игру на микро-паузу в 1 кадр, пока звук идет
    }
    TypeText("<????: Вот ты и здесь. Мы ждали тебя. Уже очень давно. И ты вернулся.");
    dBlacky.Start();
    first_enter = true;
  }
  cEgo.Loop = 2;
}

function room_RepExec()
{
  if (!oBlacky.Animating) 
  {
    // Запускаем её ОДИН ОДНОКРАТНЫЙ РАЗ (eOnce) на минимальной скорости (0)
    // Движок просто отыграет твои 5 и 35 кадров без ухода в цикл фриза
    oBlacky.Animate(0, 0, eOnce, eNoBlock);
  }
}

function hFurnishings_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (furnishings == 0)
  {
    TypeText("Я что, умер?");
    furnishings = furnishings + 1;
  }
  else if (furnishings == 1)
  {
    TypeText("Мне кажется, я умер и попал в бесконечный кошмар.");
    furnishings = furnishings + 1;
  }
  else if (furnishings == 2)
  {
    TypeText("Неужели я заслуживаю такого?");
  }
}

function oBlacky_Interact(Object *theObject, CursorMode mode)
{
  if (blacky == 0)
  {
    dBlacky.Start();
  }
  else if (blacky == 1)
  {
    player.ChangeRoom(37, 0, 0);
  }
  else if (blacky == 2)
  {
    TypeText("<????: Иди. Мы будем ждать.");
  }
}
