// room script file

function hExit_from_deep_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(17, 655, 968); 
}

function hGo_down_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(19, 655, 968); 
}


function room_AfterFadeIn()
{
  if (Go_to_dark == true)
  {
    cBum.LockView(cBum.SpeechView); // Включаем анимацию рта
    cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
    TypeText(">Бомж: Раз уж шатаешься, туда-сюда, парень, может и сигарета у тебя найдется?");
    cBum.UnlockView(); // Бомж замолчал, рот закрылся
    dBum.Start();
  }
  
}
