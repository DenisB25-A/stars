// room script file

bool Go_to_dark = true;

function room_AfterFadeIn()
{
  if (Go_to_dark == true)
  {
    cBum.LockView(cBum.SpeechView); // Включаем анимацию рта
    cBum.Animate(cBum.Loop, 15, eRepeat, eNoBlock);
    TypeText(">Бомж: Раз уж шатаешься туда-сюда, парень, может и сигарета у тебя найдется?");
    cBum.UnlockView(); // Бомж замолчал, рот закрылся
    Go_to_dark = false;
    dBum.Start();
  }
  
}

function hExit_from_deep_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(17, 340, 968); 
}

function hGo_down_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(19, 1036, 968);
}
