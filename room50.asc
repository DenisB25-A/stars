// room script file

function hLoft_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(16, 1207, 1064);
}

function hTrash_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Какие-то ведра, ящики и другой хлам, сваленный сюда Бог знает когда. Не думаю, что что-то из этого мне пригодится.");
}

function hWires_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Выглядит, как оживший кошмар пожарного инспектора. Множество древних на вид кабелей стелятся прямо по полу, вьются под потолком, сплетаются в хитрый клубок и разбегаются во все стороны. Все это напоминает спутанный моток паутины.");
  TypeText("Вряд ли вы теперь сможете спать спокойно, зная, что в вашем доме из себя представляет проводка.");
  TypeText("Вы ничего не понимаете в электрике. Думаете, это хорошая идея - их трогать?");
  dWires.Start();
}
