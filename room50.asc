// room script file
bool wires = false;
bool WoundMoodApplied = false;

function hLoft_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(16, 1207, 1064);
}

function hTrash_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Старый хлам, копившийся здесь годами. Не думаю, что что-то из этого мне пригодится.");
}

function hWires_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Wound == true)
  {
    TypeText("Слышится мерное гудение проводов. Но будто бы что-то переменилось. В любом случае, одного знакомства с ними вам точно достаточно.");
    return;
  }
  if (Electricity == true)
  {
    TypeText("Перед вами беспорядочная, старая, внушающая ужас проводка, которая будто опутала весь чердак. Провода переплетаются между собой и теряются в темноте.");
    TypeText("Вам точно не следует сюда лезть. К тому же, в этом нет нужды - все работает.");
    return;
  }
  if (wires == false)
  {
    TypeText("Перед вами беспорядочная, старая, внушающая ужас проводка, которая будто опутала весь чердак. Провода переплетаются между собой и теряются в темноте.");
    TypeText("Вы ничего не понимаете в электрике. Думаете, это хорошая идея - их трогать?");
    wires = true;
    dWires.Start();
  }
  else if (wires == true)
  {
    TypeText("Вы ничего не понимаете в электрике. Думаете, это хорошая идея - их трогать?");
    dWires.Start();
  }
}

function room_AfterFadeIn()
{
  if (Wound == true && WoundMoodApplied == false)
  {
    ChangeMood(-3);
    WoundMoodApplied = true;
  }
}
