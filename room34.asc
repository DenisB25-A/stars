// room script file
int headphonesBaseX;
int headphonesBaseY;
bool headphonesBasePositionInitialized = false;
int headphonesLastFrame = -1;


function room_Load()
{
  reset_evening_balcony_animation();
  SetBackgroundFrame(0);

  if (!headphonesBasePositionInitialized)
    {
        headphonesBaseX = oHeadphones.X;
        headphonesBaseY = oHeadphones.Y;
        headphonesBasePositionInitialized = true;
    }

  oHeadphones.SetPosition(headphonesBaseX, headphonesBaseY);
  headphonesLastFrame = -1;
  
  
  if (player.HasInventory(iBook))
  {
    oBook.Visible = true;
  }
  else
  {
    oBook.Visible = false;
  }
  
  if (player.HasInventory(iMusic_player))
  {
    oHeadphones.Visible = true;
  }
  else
  {
    oHeadphones.Visible = false;
  }
  
  if (player.HasInventory(iDino))
  {
    oDino.Visible = true;
  }
  else
  {
    oDino.Visible = false;
  }
}


function room_AfterFadeIn()
{
  FadeIn(1);
  
      // Затемняем вечерний балкон
    start_diming();
    gMoodPanel.Visible = true;
    gMoodPanel.Transparency = 0;
    moodPanelForced = true;
    move_carret_back();

    // Заголовок и результаты

    show_accumulated_text_after("Устроил себе небольшой отдых   +1", 125, true);

    if (player.HasInventory(iBook))
    {
        show_accumulated_text_after("Нашел почитать книгу на вечер   +1", 125, true);
    }

    if (player.HasInventory(iDino))
    {
        show_accumulated_text_after("Отыскал игрушку из детства   +1", 125, true);
    }

    if (player.HasInventory(iMusic_player))
    {
        show_accumulated_text_after("Нашел старый плеер   +1", 125, true);
    }


    // Оставляем результаты на экране
    Wait(320);

    // Убираем текст
    move_carret_back();

    // Постепенно возвращаем изображение
    start_lighter();
    moodPanelForced = false;
    gMoodPanel.Visible = false;
    Wait(250);
    
    TypeText("Иногда кажется, что жизнь проносится мимо, как черно-белый фильм, на который ты попал по ошибке.");
    TypeText("Ты не знаешь, зачем ты здесь, чувствуешь себя лишним. Просто хочешь уйти.");
    TypeText("Тебя манят открытые окна и мосты, и приходится постараться, чтобы не поддаться их зову.");
    TypeText("Но знаешь, что я скажу?");
    TypeText("«Пожалуй, не сегодня».");
    TypeText("Сегодня я хотел бы остаться.");
    Wait(80);
    FadeOut(1);
    
    player.ChangeRoom(13, 1497, 996, eDirectionLeft);

}


function late_repeatedly_execute_always()
{
    if (!oHeadphones.Visible)
        return;

    int frame = GetBackgroundFrame();

    // Если кадр не изменился, ничего не делаем
    if (frame == headphonesLastFrame)
        return;

    headphonesLastFrame = frame;

    // Смещение наушников в зависимости от положения головы
    switch (frame)
    {
        case 0:
            oHeadphones.SetPosition(
                headphonesBaseX,
                headphonesBaseY
            );
            break;

        case 1:
            oHeadphones.SetPosition(
                headphonesBaseX + 1,
                headphonesBaseY + 1
            );
            break;

        case 2:
            oHeadphones.SetPosition(
                headphonesBaseX + 2,
                headphonesBaseY + 2
            );
            break;

        case 3:
            oHeadphones.SetPosition(
                headphonesBaseX + 1,
                headphonesBaseY + 1
            );
            break;

        case 4:
            oHeadphones.SetPosition(
                headphonesBaseX,
                headphonesBaseY
            );
            break;
    }
}


