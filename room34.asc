// room script file
int bgTimer = 0;
int bgFrame = 0;
int bgDelay = 25; // СКОРОСТЬ: каждые 20 тиков (0.5 секунды) кадр будет меняться
int maxFrames = 5; // Общее количество кадров бэкграунда (например, от 0 до 3)

function room_Load()
{
  SetBackgroundFrame(0); // Блокируем авто-смену
}

function room_RepExec()
{
bgTimer++; // Таймер тикает каждый кадр игры
  
  // Создаем локальную переменную для задержки ИМЕННО ЭТОГО кадра
  int currentDelay = 25; // Стандартная скорость (0.5 сек)
  
  // Проверяем, какой кадр сейчас включен. 
  // Допустим, мы хотим, чтобы 2-й кадр (индекс 1) висел на экране дольше.
  if (bgFrame == 2) 
  {
    currentDelay = 60; // Для этого кадра задержка будет 2 секунды
  }
  
  // Можно добавить еще условия, если нужно
  // else if (bgFrame == 3) { currentDelay = 10; } // А последний кадр промелькнет очень быстро
  
  // Проверяем таймер против нашей динамической задержки
  if (bgTimer >= currentDelay) 
  {
    bgTimer = 0; // Сбрасываем таймер
    bgFrame++;   // Переходим к следующему кадру
    
    if (bgFrame >= maxFrames) 
    {
      bgFrame = 0; // Зацикливаем
    }
    
    SetBackgroundFrame(bgFrame); // Включаем новый кадр
  }
}
