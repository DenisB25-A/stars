// room script file
bool mother_photo_firstime = true;
int album_firstime = 1;

function oDrawer_close_Interact(Object *theObject, CursorMode mode)
{
  if (mother_photo_firstime == true)
  {
    aDrawer_open.Play();
    oDrawer_open.Visible = true;
    oDrawer_close.Visible = false;
    oPhoto_mother.Visible = true;
  }
  else
  {
    aDrawer_open.Play();
    oDrawer_open.Visible = true;
    oDrawer_close.Visible = false;
    oPhoto_mother.Visible = false;
  }
}

function oDrawer_open_Interact(Object *theObject, CursorMode mode)
{
  aDrawer_close.Play();
  oDrawer_open.Visible = false;
  oDrawer_close.Visible = true;
  oPhoto_mother.Visible = false;
}

function hShelf_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
    player.ChangeRoom(1, 1309, 997); 
  }
  else
  {
    player.ChangeRoom(23, 1309, 996); 
  }
}


function oPhoto_mother_Interact(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(0);
  oPhoto_mother.Visible = false;
  mother_photo_firstime = false;
  TypeText("Мамина фотография. В молодости она была красавицей. Ума не приложу, что такого она нашла в моем непутевом отце?");
}

function hBooks_Interact(Hotspot *theHotspot, CursorMode mode)
{
  // =================================
  // НОЧНАЯ ВЕРСИЯ
  // =================================

  if (IsNight == true)
  {
    if (album_firstime == 0)
    {
      TypeText("На полке - старые книги в запыленных переплетах. Толстые тома, какие-то справочники, даже корешки ваших школьных учебников мелькают то тут, то там.");
      TypeText("Однако от тусклого света лампы начинают слезиться глаза. Пожалуй, копаться тут стоило днем. Читать в полутьме у вас нет никакого желания.");
    }
    else if (album_firstime == 1)
    {
      TypeText("Ваш детский фотоальбом стоит на запыленной полке, среди учебников, справочников и старых энциклопедий. При взгляде на него на душе по-прежнему скребут кошки.");
      TypeText("Вот только вчерашняя апатия спала, и сегодня вы не собираетесь отступать. От прошлого нельзя убегать бесконечно. Вы достаете и аккуратно пролистываете альбом.");
      TypeText("Снимков немного. В основном, общие фотографии класса за разные годы, снимки каких-то праздников и застолий. Неожиданно взгляд цепляется за фотокарточку, которая кажется вам незнакомой.");

      ReadAndAddNote(9);

      TypeText("Слева - это наверняка я. А вот девочку я не помню.");

      album_firstime = 2;
    }
    else if (album_firstime == 2)
    {
      TypeText("Вы снова достаете и пролистываете фотоальбом. Долго всматриваетесь в чужие улыбки, в цветные и черно-белые лица. Странно. Они больше не вызывает никаких чувств.");
    }
  }

  // =================================
  // ДНЕВНАЯ ВЕРСИЯ
  // =================================

  else
  {
    if (album_firstime == 0)
    {
      TypeText("Среди старых книг, занимающих полку, мелькают потертые корешки школьных учебников.");
      TypeText("Взгляд останавливается на небольшом кожаном переплете: альбоме с детскими фотокарточками. В затертой маленькой книжке - окно в прошлое, кусочек светлых, когда-то радостных дней.");
      TypeText("В них - вы моложе, родители - живы, а дни - удивительно долгие и почему-то всегда ярко-солнечные, отчего при одном воспоминании хочется прищурить глаза.");
      TypeText("Вы почти инстинктивно протягиваете руку... но тут же отдергиваете себя. Вспыхнувший было огонек гаснет. Кому какое дело, кем мы были десять лет назад?");

      album_firstime = 1;
    }
    else
    {
      TypeText("Фотоальбом и стопка старых, запыленных книг. У меня нет желания к ним прикасаться.");
    }
  }
}

function hNewspaper_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
    TypeText("Местная газета. На всю первую полосу - фотография пропавшего человека.");
    TypeText("Это ваш сосед с нижнего этажа, исчезнувший месяц назад. Какой ужас. Вы не были знакомы, лишь иногда здоровались на площадке.");
    TypeText("На обратной стороне астрологический прогноз. Сатурн в Овне. Пишут, что это дурной знак.");
  }
  else
  {
    TypeText("...ремонтные работы на Вокзальном проезде ...местная ярмарка ...порывы трубы ...анонсы каких-то скучных мероприятий... ");
    TypeText("Вы пробегаете глазами страницу, раскрытую наугад. Заурядные новости маленького городка, вроде вашего. Честно признаться, ничего интересного.");
  }
}



function room_Unload()
{
  if ((IsNight == false) && (unknown_sound == 0))
  {
    aCup_drop.Play();
    aUnknown_run.Play();
    Wait(80);
    unknown_sound = unknown_sound + 1;
  }
  
}


