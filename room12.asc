// room script file
bool mother_photo_firstime = true;
bool album_firstime = true;

function oDrawer_close_AnyClick(Object *theObject, CursorMode mode)
{
  if (mother_photo_firstime == true)
  {
    aDrawer_open.Play();
    oDrawer_open.Visible = true;
    oDrawer_close.Visible = false;
    oPhoto_mother.Visible = true;
  }
  else
  {
    aDrawer_open.Play();
    oDrawer_open.Visible = true;
    oDrawer_close.Visible = false;
    oPhoto_mother.Visible = false;
  }
}

function oDrawer_open_AnyClick(Object *theObject, CursorMode mode)
{
  aDrawer_close.Play();
  oDrawer_open.Visible = false;
  oDrawer_close.Visible = true;
  oPhoto_mother.Visible = false;
}

function hShelf_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
    player.ChangeRoom(1, 1309, 997); 
  }
  else
  {
    player.ChangeRoom(23, 1309, 996); 
  }
}


function oPhoto_mother_AnyClick(Object *theObject, CursorMode mode)
{
  ReadAndAddNote(0);
  oPhoto_mother.Visible = false;
  mother_photo_firstime = false;
  TypeText("Мамина фотография. В молодости она была красавицей. Ума не приложу, что такого она нашла в моем непутевом отце?");
}

function hBooks_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  if (album_firstime == true)
  {
    TypeText("Среди старых книг, занимающих полку, мелькают потертые корешки школьных учебников.");
    TypeText("Взгляд останавливается на небольшом кожаном переплете: альбоме с детскими фотокарточками. В затертой маленькой книжке - окно в прошлое, кусочек светлых, когда-то радостных дней.");
    TypeText("В них - вы моложе, родители - живы, а дни - удивительно долгие и почему-то всегда солнечно-яркие, отчего даже от взгляда на фотографию хочется прищурить глаза.");
    TypeText("Вы почти инстинктивно протягиваете руку... но тут же отдергиваете себя. Вспыхнувший было огонек гаснет. Кому какое дело, кем мы были десять лет назад?");
    album_firstime = false;
  }
  else
  {
    TypeText("Стопка старых, запыленных книг.");
  }
}

function hNewspaper_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Местная газета. На первой полосе новостные сводки о массовых сокращениях.");
  TypeText("На обратной стороне набросан астрологический прогноз. Сатурн в Овне. Пишут, что это дурной знак.");
}



function room_Unload()
{
  if (unknown_sound == 0)
  {
    aCup_drop.Play();
    aUnknown_run.Play();
    Wait(80);
  }
  
  unknown_sound = unknown_sound + 1;
}
