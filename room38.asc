// room script file


function room_Load()
{
  SetBackgroundFrame(0);
}

function hHair_Interact(Hotspot *theHotspot, CursorMode mode)
{
// --- КАДР 0 ---
  SetBackgroundFrame(0);
  Wait(30); // Ждем 25 тиков
  
  // --- КАДР 1 ---
  SetBackgroundFrame(1);
  Wait(30); // Ждем 25 тиков
  
  // --- КАДР 2 (Тот самый, который зависает дольше) ---
  SetBackgroundFrame(2);
  Wait(30); // Ждем 60 тиков (дольше остальных)
  
  // --- КАДР 3 ---
  SetBackgroundFrame(3);

  
  player.AddInventory(iHair);
  TypeText("Это... это что, волосы?");
  TypeText("Получен предмет: 'Черные волосы'.");
  // И только теперь, когда все кадры по очереди показались, переносим игрока:
  player.ChangeRoom(26, 1117, 1077);
}
