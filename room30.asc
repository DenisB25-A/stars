// room script file
bool mechanism = false;

function hExit_strangeroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound.Play();
  player.ChangeRoom(25, 1580, 850);
}

function hMechanism_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (mechanism == false)
  {
    TypeText("Похоже на какой-то механизм.");
    mechanism = true;
    player.ChangeRoom(36, 0, 0);
  }
  else
  {
    player.ChangeRoom(36, 0, 0);
  }
}

function room_FirstLoad()
{
  TypeText("Ебическая сила... У меня в гостинной собственная Нарния.");
}

function hOld_table_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
    TypeText("На столе кипа бумаг, отсыревших и почерневших от времени. Разобрать что-либо невозможно. Интересно, конечно, чем это было.");
  }
}

function hManeken_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (Region.GetAtRoomXY(cEgo.x, cEgo.y) == region[1])
  {
    TypeText("Это штука меня пугает. Я даже приближаться к ней не хочу.");
  }
}

function hRoots_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Из стены растут отростки, похожие на древесные корни.");
}
