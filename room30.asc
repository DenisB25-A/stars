// room script file
bool mechanism = false;

function hExit_strangeroom_Interact(Hotspot *theHotspot, CursorMode mode)
{
  aDoor_sound.Play();
  player.ChangeRoom(25, 1580, 850);
}

function hMechanism_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (mechanism == false)
  {
    TypeText("Похоже на какой-то механизм.");
    mechanism = true;
    player.ChangeRoom(36, 0, 0);
  }
  else
  {
    player.ChangeRoom(36, 0, 0);
  }
}

function room_FirstLoad()
{
  TypeText("Ебическая сила...");
  aHeartbeat.Play();
}

function hOld_table_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("На столе лежит кипа бумаг, настолько высохших и почерневших от времени, что от одного вашего прикосновения они готовы рассыпаться в пыль.");
  TypeText("Вы не представляете, сколько этому лет, однако по коже начинают бегать мурашки.");
}

function hManeken_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Это похоже на куклу или... какой-то манекен, замотанный в тряпье. Если честно, мне не хочется подходить к нему ближе.");
}

function hRoots_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("Из стены вылезают отростки, напоминающие древесные корни. Они обрамляют какой-то непонятный механизм.");
}

function hAstro_simbols_Interact(Hotspot *theHotspot, CursorMode mode)
{
  TypeText("На стене какие-то расчеты или астрономические карты. Не знаю. Если кто-то и может понять смысл этого, то точно не я.");
}
