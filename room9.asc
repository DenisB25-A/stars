// Создаем массив для текстов писем
String emailTexts[5]; 

function room_Load() {
  emailTexts[0] = "от кого: Ксения Р.[[тема: По поводу увольнения...[[Илья привет! Я правда пыталась поговорить с Дмитрием Васильевичем, чтобы тебя перевели куда-нибудь, хотя бы к нам в отдел. Но он ни в какую :( Сам понимаешь, сейчас урезают расходы, в соседнем городе закрывают целый филиал. Поэтому ничего не поделаешь... И еще, Дмитрий Васильевич сказал, что сокращения не будет, и тебе придется написать заявление 'по собственному'... Приказ уже подписали. Мне очень жаль.";
  emailTexts[1] = "от кого: Неизвестно [[тема: ТОЛЬКО СЕГОДНЯ!!! УНИКАЛЬНОЕ ПРЕДЛОЖЕНИЕ!!! [[Здравствуйте! Вы были случайным образом выбраны для получения нашей супер-скидки в размере 70%!!! Не упустите свой шанс!!! Переходите по ссылке и заказывайте прямо сейчас: уникальная переноска для хлеба, держатель для зубных щеток и наш легендарный подстаканник в форме сома! [[ПОЛУЧИТЬ СКИДКУ ПРЯМО СЕЙЧАС!!! [[Количество товаров ограничено.";
  emailTexts[2] = "от кого: Неизвестно [[тема: Без темы [[К ы Та   Ы н н о к ?";
// и так далее
}

function oKsenia1_AnyClick(Object *theObject, CursorMode mode)
{
  // ПРОВЕРКА: Если на письмо уже ответили, кнопку НЕ показываем
  if (ksenia_answer == true) 
  {
    Button3.Visible = false; 
  }
  else 
  {
    Button3.Visible = true; 
  }
  lblEmailBody.Text = emailTexts[0]; // Подставляем нужный текст в наш Label
  gEmailReader.Visible = true;       // Показываем окно чтения
  CurrentEmail = 0;                  // ЗАПОМИНАЕМ: Открыто письмо 0 (Ксения)
}

function oSpam_AnyClick(Object *theObject, CursorMode mode)
{
  lblEmailBody.Text = emailTexts[1]; 
  gEmailReader.Visible = true;  
  Button3.Visible = false;
  CurrentEmail = 1;
}

function oUnknown1_AnyClick(Object *theObject, CursorMode mode)
{
  if (unknown_answer == true) 
  {
    Button3.Visible = false; 
  }
  else 
  {
    Button3.Visible = true; 
  }
  lblEmailBody.Text = emailTexts[2]; 
  gEmailReader.Visible = true;  
  CurrentEmail = 2;                  // ЗАПОМИНАЕМ: Открыто письмо 2 (Странное)
}

function hLaptop_exit_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(3, 1125, 850);
}
