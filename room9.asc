// Создаем массив для текстов писем

function hLaptop_exit_Interact(Hotspot *theHotspot, CursorMode mode)
{
  if (IsNight == false)
  {
  player.ChangeRoom(3, 1125, 850);
  }
  else
  {
  player.ChangeRoom(25, 1125, 850);
  }
  
}

function room_Unload()
{
  gLaptop.Visible = false;
}

function room_Load()
{
  if (IsNight == true) {
    SetBackgroundFrame(1); // Включает ночной фон (слот 1) и фиксирует его
  }
  else {
    SetBackgroundFrame(0); // Включает дневной фон (слот 0) и фиксирует его
  }
  
  if (IsNight == false) 
  {
    // Ночь пришла — переписываем названия кнопок на ноутбуке
    Laptop_Button1.Text = "от Ксения Р.:                     RE: По поводу увольнения..."; 
    // Button4.Text = "от кого: [ДАННЫЕ УДАЛЕНЫ]"; // если у тебя есть другие кнопки
    Laptop_Button2.Text = "от НЕИЗВЕСТНО :            ТОЛЬКО СЕГОДНЯ!!! УНИКАЛЬНАЯ РАСПРО...";
    Laptop_Button3.Text = "от НЕИЗВЕСТНО:              Без темы";
    Laptop_Button4.Text = "от Ксения Р.:                     RE: По поводу увольнения..."; 
  }
  else 
  {
    // Если еще день — возвращаем стандартные названия
    Laptop_Button1.Text = "от Мартынов Д.:                RE: По поводу увольнения.";
    Laptop_Button2.Text = "от НЕИЗВЕСТНО :            ТОЛЬКО СЕГОДНЯ!!! УНИКАЛЬНАЯ РАСПРО...";
    Laptop_Button3.Text = "от НЕИЗВЕСТНО:              Без темы";
    Laptop_Button4.Text = "от Ксения Р.:                     RE: По поводу увольнения..."; 
  }
  
  gLaptop.Visible = true;
}
